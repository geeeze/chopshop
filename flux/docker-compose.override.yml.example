# chopshop-flux — host-fact override TEMPLATE.
#
# Copy to docker-compose.override.yml (gitignored) and fill in. Nothing here is a
# fact about any particular machine until you make it one.
#
# This file does NOT describe GPU pass-through. That is a tracked choice between
# two overlays, because it is a property of the vendor rather than of one box:
#
#   docker compose -f docker-compose.yml -f docker-compose.nvidia.yml up -d flux
#   docker compose -f docker-compose.yml -f docker-compose.rocm.yml   up -d flux
#
# See docs/gpu-runtime.md. What is left here is what genuinely differs per
# machine: paths, secrets, exposure, and the SELinux label decision.

services:
  flux:
    # The GPU runtime (torch + diffusers + accelerate) as a bind-mounted venv,
    # plus the interpreter to run the service under. This is the ONE mount that
    # has to be here: the venv belongs to the machine with the card.
    # volumes:
    #   - /path/to/gpu-venv:/gpu-venv:ro
    # environment:
    #   CHOPSHOP_FLUX_PYTHON: /gpu-venv/bin/python
    #
    # If that venv's bin/python is a SYMLINK into a separate interpreter install
    # (uv, pyenv, asdf), mount that install too AT ITS OWN PATH, or the symlink
    # resolves to nothing inside the container:
    #
    #   <venv>/bin/python -c 'import sys; print(sys.base_prefix)'   # what to mount
    # volumes:
    #   - <that path>:<that path>:ro

    # Weights and output, when they live outside this checkout.
    # volumes:
    #   - /path/to/models/hf:/models:ro
    #   - /path/to/out:/app/out
    # environment:
    #   HF_HOME: /models

    # SELinux (Fedora, RHEL, and any host in Enforcing mode) denies a container
    # read access to a bind-mounted host path by default. Two ways out: relabel
    # the source tree (`:z` on the mount, which changes the host's labels), or
    # turn label separation off for this one container. The second is what this
    # service's deployments use, because the venv is shared with other tools.
    # security_opt:
    #   - label=disable

    # SPLIT install: publish on the private/tailnet address instead of loopback,
    # so the studio on the other box can reach the service.
    # ports:
    #   - "${TAILNET_IP}:8795:8795"

    # Hardening for a split install: once the bind leaves loopback, set a bearer
    # too (an unauthenticated generation endpoint on a shared network is
    # somebody else's free GPU).
    # environment:
    #   CHOPSHOP_FLUX_TOKEN: "change-me"

    # dtype is per-CARD, not per-vendor: a card without native bf16 (NVIDIA
    # Turing sm_75 and older, older AMD GCDs) wants float16.
    # See docs/gpu-runtime.md.
    # environment:
    #   CHOPSHOP_FLUX_DTYPE: float16
