# Template for .env — copy to .env on a new host and fill in the addresses.
#
# .env is GITIGNORED and holds the only place an IP may appear. compose loads it
# for ${VAR} interpolation, and docker-compose.override.yml refers to these by
# name, so no tracked file carries an address.
#
# Empty is a valid state: the stack boots, and the two services below simply
# read as unreachable (the studio's nav shows them down, which is honest).

# Generation service (flux) — needs a GPU, usually not the same box.
CHOPSHOP_RUNNER_FLUX_URL=

# Decision backend (laya / systemone). Unset = the jev add-on answers 503 with
# its reason rather than pretending the route does not exist.
JEV_ENDPOINT=

# The captioner's key. REQUIRED whenever the caption profile is used: the
# service binds 0.0.0.0 inside its container (a 127.0.0.1 listener resets a
# forwarded connection) and refuses any bind off loopback without a token, so an
# empty value here is a container that exits naming this variable.
CAPTION_API_KEY=

# Where the captioner's weights are. Read-only: nothing should write into a
# model store it does not own.
CAPTION_CACHE_DIR=
