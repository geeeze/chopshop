# Local render/verify image for chopshop-studio.
#
# NOT a deploy image. The deploy path is kamal/thruster (Gemfile) against
# nginx-chopshop.conf on the host. This exists so a verification container
# starts in seconds instead of paying a cold `bundle install` every time --
# the bundle is baked in, and the repo is bind-mounted over /app at run time so
# the served HTML can never drift from the working tree.
FROM ruby:3.3-slim

RUN apt-get update -qq && apt-get install -y -qq \
      build-essential libssl-dev libyaml-dev curl libvips42 python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bundle first, on its own layer: app edits must not invalidate the gem cache.
COPY Gemfile Gemfile.lock ./
RUN gem install bundler --no-document
# NO BUNDLE_WITHOUT. It used to be `test`, and the consequence was silent: the
# image's bundle fell out of step with the Gemfile.lock it was built from, so a
# plain `podman rm` + run could not start the app at all -- it only worked while
# someone's earlier hand-run install still sat in the stopped container's
# writable layer (bcrypt-3.1.22 and chunky_png-1.4.0 were missing, and nothing
# in the build said so). A gem the lockfile and the group both carry is not
# optional here: the dev image is the box's test rig, so it needs the test group.
RUN bundle install

COPY . .

EXPOSE 3001
CMD ["bin/rails", "s", "-b", "0.0.0.0", "-p", "3001"]
