<%%#
  THE COLOUR MAP — the one picker in the app, rendered on every page that
  chooses a colour: the job spec builder (pages/schema) and the composite
  builder (composites/show). It is a <template> handed to CsModal, so the map
  markup cannot drift between the two pages; each page's own script decides
  what a picked colour DOES.

  A spectrum rather than a full SV picker on purpose: this is a screen printing
  tool working in FLAT SPOT COLOURS, and the useful question is "which flat
  colour", not "where on a continuous surface". Hue x lightness at full
  saturation, plus a neutrals ramp (greys are a first-class ink here), plus the
  shop's proven palette library underneath. Every cell carries its hex in
  data-hex and its own accessible name, so the map is usable by keyboard and
  announced properly. Requires @palette_library (PaletteLibrary.load).
%%>
<template id="colourMapTemplate">
  <%# THE COLOUR MAP. Two swatches on this page (print background, and the
      colour about to be added to the spec palette) open this instead of doing
      nothing, which is what they used to do.

      A spectrum rather than a full SV picker on purpose: this is a screen
      printing tool working in FLAT SPOT COLOURS, and the useful question is
      "which flat colour", not "where on a continuous surface". So it is hue x
      lightness at full saturation -- every flat hue and its tints/shades in one
      click, with no second control to hold in mind. Neutrals get their own
      ramp because greys are a first-class ink here and never appear as "low
      saturation" of a hue. The shop's own library sits underneath, since those
      are the colours already proven against this pipeline.

      24 hues x 8 lightnesses = 192 cells, plus 11 neutrals and the library.
      Every cell carries its hex in data-hex and its own accessible name, so
      the map is usable by keyboard and announced properly. %>
  <div class="cmap">
    <div class="cmap-current">
      <span class="cmap-current-label">now</span>
      <span class="cmap-current-chip" id="cmapNowChip"></span>
      <span class="mono cmap-current-hex" id="cmapNowHex">#ffffff</span>
    </div>

    <h4 class="cmap-h">Spectrum <span class="cmap-h-note">hue &times; lightness, full saturation</span></h4>
    <div class="cmap-grid cmap-spectrum" role="group" aria-label="Colour spectrum">
      <%# lightness descends, so the row order on screen is dark at the bottom
          like every other lightness ramp people already know. %>
      <% 8.downto(1) do |l| %>
        <%# Lightness runs 10%..66%, NOT 0..100. At L=100% every full-saturation
            hue is white, so the lightest row was 24 identical #ffffff cells. %>
        <% val = 10 + (l - 1) * 8 %>
        <div class="cmap-row">
          <% 24.times do |i| %>
            <% hue = i * 15 %>
            <% hex = hsl_hex(hue, 100, val) %>
            <button type="button" class="cmap-cell" data-hex="<%= hex %>"
                    style="background:<%= hex %>"
                    title="<%= hex %> — hue <%= hue %>°, <%= val %>% lightness"
                    aria-label="Use <%= hex %>: hue <%= hue %> degrees at <%= val %>% lightness"></button>
          <% end %>
        </div>
      <% end %>
    </div>

    <h4 class="cmap-h">Neutrals <span class="cmap-h-note">greys, ground and substrate</span></h4>
    <div class="cmap-grid cmap-grey" role="group" aria-label="Neutral greys">
      <% (0..100).step(10) do |l| %>
        <% hex = hsl_hex(0, 0, l) %>
        <button type="button" class="cmap-cell" data-hex="<%= hex %>"
                style="background:<%= hex %>"
                title="<%= hex %> — <%= l %>% grey"
                aria-label="Use <%= hex %>: <%= l %>% grey"></button>
      <% end %>
    </div>

    <% if @palette_library.any? %>
      <h4 class="cmap-h" id="cmapLibraryHead">The shop's library <span class="cmap-h-note"><%= @palette_library.palettes.size %> palettes, <%= @palette_library.palettes.sum { |q| q.colours.size } %> colours already proven against this pipeline</span></h4>
      <div class="pal-src-line mono">chopshop-svg · scripts/palettes.json<% if @palette_library.version.present? %> v<%= @palette_library.version %><% end %></div>
      <p class="hint">The shop's palette library — geometry is untouched by a palette, only the colour vectors change. Click a palette's frame to copy it in whole, or take colours from it one at a time with ＋; the spec's own palette stays editable in the colour spec block.</p>
      <div class="pal-presets">
      <% @palette_library.palettes.each do |pal| %>
        <div class="pal-preset" data-palette-id="<%= pal.id %>"
             data-colours="<%= pal.colours.map(&:hex).join(",") %>">
          <%# The whole frame is the control. The hit area is a real <button>
              laid UNDER the card's content (see .pal-preset-hit): tabbable and
              announced by a screen reader, while the content sits above it so
              the ＋ / → bg buttons keep their own clicks. There is deliberately
              no separate "Use this palette" button. %>
          <button type="button" class="pal-preset-hit"
                  aria-label="Use this palette: <%= pal.name %>, <%= pal.colours.size %> colours"
                  title="Replace the spec palette with this palette's <%= pal.colours.size %> colours"></button>
          <div class="pal-preset-head">
            <strong><%= pal.name %></strong>
            <span class="mono pal-preset-id"><%= pal.id %></span>
          </div>
          <% if pal.note.present? %><p class="hint"><%= pal.note %></p><% end %>
          <div class="pal-strip pal-strip-sm">
            <% pal.colours.each do |colour| %>
              <span class="pal-chip<%= " is-bg" if pal.background == colour.hex %>">
                <span class="pal-swatch" style="background:<%= colour.hex %>"></span>
                <span class="mono pal-hex"><%= colour.hex %></span>
                <span class="pal-role"><%= colour.role %><%= " · ground" if pal.background == colour.hex %></span>
                <button type="button" class="pal-add-one" data-hex="<%= colour.hex %>"
                        title="Add <%= colour.hex %> to the spec palette">＋</button>
                <% if pal.background == colour.hex %>
                  <button type="button" class="pal-set-bg" data-hex="<%= colour.hex %>"
                          title="Use <%= colour.hex %> as print.background_hex">→ bg</button>
                <% end %>
              </span>
            <% end %>
          </div>
          <% if pal.map.any? %>
            <div class="pal-map mono">
              pinned: <% pal.map.each do |from, to| %><%= from %> → <%= to %>&nbsp;<% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      </div>
    <% end %>
  </div>
</template>
