<%#
  The stepped PROCESS and its end RESULTS, for a job whose request is a step
  LIST (spec["steps"]).

  A chain is not one artefact: it is N steps in order, each with its own runner
  job, its own produced file and its own state — and until this existed the page
  showed none of it, so a 40-step conference read exactly like a single-action
  run and the operator had to open the JSON to find out what had happened.

  Two readings of the same ledger, because they answer different questions:

    * the TABLE is the process — what ran, in what order, on which runner, under
      which operation, how long it took, and what it left behind;
    * the GRID is the end results — one tile per produced file, in step order,
      which is how a job that generated a field of rasters and composed sheets
      out of them is read at a glance.

  Both are driven by `steps` (the DECLARED steps) joined to `steps_recorded`
  (what the worker has written so far): a queued chain shows every step as
  pending rather than an empty page, and a finished one shows all of them.

  WHERE THIS JOB IS (#46) leads, for EVERY job and not only a chain: the
  pipeline the About page tells as prose — prep → sweep → compare → you pick →
  validate — with this job's own position in it, and its steps in place of those
  five when the job is a chain. `job_stepper_stages` (ApplicationHelper) derives
  the states from what the job already records and documents the one limit: the
  runner reports a single running state, so prep/sweep/compare share theirs.
%>
<%
  declared = @job.steps
  recorded = @job.steps_recorded.each_with_object({}) do |entry, acc|
    acc[entry["index"].to_i] = entry if entry.is_a?(Hash)
  end
  current = @job.current_step_index
  produced = declared.each_with_index.filter_map do |step, i|
    entry = recorded[i + 1]
    file = entry && entry["file"].to_s.presence
    next unless file

    { number: i + 1, step: step, entry: entry, file: file }
  end
  done_count = declared.each_index.count { |i| recorded[i + 1].is_a?(Hash) && recorded[i + 1].any? }
  stages = job_stepper_stages(@job)
  here = job_stepper_current(stages)
%>

<div class="card job-stepper" data-stepper="<%= @job.sequenced? ? "chain" : (stages.size > 1 ? "pipeline" : "single") %>">
  <div class="process-head">
    <%= record_section("Where this job is") %>
    <span class="stepper-head-right">
      <span class="process-count mono"><%= job_stepper_caption(stages, here) %></span>
      <%# One `?` per STRIP for a chain or a single action: a per-step tip would
          need one registry key per operation, and two steps of the same kind
          would then render the same popup id twice on one page — invalid HTML,
          and the handler opens the first. The pipeline's five stages are
          distinct, so each of them carries its own (#46). %>
      <% if @job.sequenced? %><%= help_tip("jobstep.chain") %>
      <% elsif stages.size == 1 %><%= help_tip("jobstep.single") %><% end %>
    </span>
  </div>

  <%# A row, not an <ol>: the connectors between the steps are children of the
      same strip, and a list item that is not a step would be a lie to a screen
      reader. The order is carried by the DOM and by the `→` between each pair. %>
  <div class="stepper" data-stages="<%= stages.size %>" aria-label="Where this job is">
    <% stages.each_with_index do |stage, i| %>
      <% if i.positive? %>
        <span class="step-link<%= " step-link-handoff" if stage[:handoff] %>"<% if stage[:handoff] %>
              data-handoff="<%= stage[:handoff] %>"
              title="this step is handed the file the step before produced"<% end %>>→</span>
      <% end %>
      <div class="step step-<%= stage[:state] %><%= " step-current" if i == here %>"
           data-stage="<%= stage[:name] %>" data-state="<%= stage[:state] %>">
        <span class="step-dot" aria-hidden="true"></span>
        <span class="step-label"><%= stage[:label] %></span>
        <span class="step-state mono"><%= stage[:state] %></span>
        <% if i == here %><span class="step-here">you are here</span><% end %>
        <% unless @job.sequenced? || stages.size == 1 %>
          <%# The five stages' own tips, written as literals so the registry's
              integrity test (test/lib/help_tips_test.rb) sees each key. %>
          <%= case stage[:name]
              when "prep" then help_tip("jobstep.prep")
              when "sweep" then help_tip("jobstep.sweep")
              when "compare" then help_tip("jobstep.compare")
              when "pick" then help_tip("jobstep.pick")
              when "validate" then help_tip("jobstep.validate")
              end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @job.sequenced? %>
<div class="card process-card">
  <div class="process-head">
    <%= record_section("Process") %>
    <span class="process-count mono">
      step <%= current.presence || done_count %> of <%= declared.size %>
      · <%= done_count %> done
      <% if produced.any? %>· <%= produced.size %> produced<% end %>
    </span>
  </div>

  <table class="candidates process-tbl">
    <thead>
      <tr>
        <th class="col-narrow">#</th>
        <th>Runner</th>
        <th>Operation</th>
        <th>State</th>
        <th>Produced</th>
        <th>Runner job</th>
        <th class="col-narrow">Took</th>
      </tr>
    </thead>
    <tbody>
      <% declared.each_with_index do |step, i| %>
        <% number = i + 1
           entry = recorded[number] || {}
           state = step_state(entry, number, current)
           file = entry["file"].to_s.presence
           seconds = step_seconds(entry) %>
        <tr data-step="<%= number %>" data-state="<%= state %>">
          <td class="col-narrow mono"><%= number %></td>
          <td class="mono"><%= step["runner"] %></td>
          <td class="mono"><%= Job.step_operation(step) %></td>
          <td><span class="process-state process-state-<%= state %>"><%= state %></span></td>
          <td class="mono">
            <% if file %>
              <%# The viewer's `svg` kind is the SITE's "open it in the popup"
                  marker, not a claim that the file is a vector: aether.js builds
                  an `<img>` for anything that is not a grouped playlist, which
                  is exactly how every other image tile on this page is marked
                  (a generated raster variation, a plot PNG, a composite frame).
                  `image` was emitted here instead, and the viewer has no
                  `image` branch -- anything that is not `svg` falls into the
                  JSON branch and reports "Could not load." (#16). %>
              <a href="<%= upload_preview_jobs_path(name: file) %>"
                 data-cs-view="svg"
                 data-cs-url="<%= upload_preview_jobs_path(name: file) %>"><%= file %></a>
            <% else %>
              <span class="dim">—</span>
            <% end %>
          </td>
          <td class="mono"><%= entry["runner_job_id"].to_s.presence || "—" %></td>
          <td class="col-narrow mono"><%= seconds ? "#{seconds}s" : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if produced.any? %>
  <div class="card process-results">
    <div class="process-head">
      <%= record_section("End results") %>
      <span class="process-count mono"><%= produced.size %> files, in step order</span>
    </div>
    <%# The variations grid and tile, not a second grid invented here: a step's
        output is a picture beside its label, which is exactly what that pair
        already is. %>
    <div class="variations-grid">
      <% produced.each do |row| %>
        <div class="variation-tile" data-step="<%= row[:number] %>">
          <%# `svg` for a raster step output too, and deliberately so: the
              viewer's `svg` kind is the site's "open it in the popup" marker --
              aether.js builds an `<img>` for anything that is not a grouped
              playlist, which is how every other image tile on this page is
              marked. An `image` kind has no branch and fell through to the JSON
              branch, reporting "Could not load." (#16). %>
          <a href="<%= upload_preview_jobs_path(name: row[:file]) %>"
             data-cs-view="svg"
             data-cs-url="<%= upload_preview_jobs_path(name: row[:file]) %>">
            <img src="<%= upload_preview_jobs_path(name: row[:file]) %>"
                 alt="step <%= row[:number] %>: <%= Job.step_operation(row[:step]) %>"
                 loading="lazy">
          </a>
          <span class="variation-label">step <%= row[:number] %></span>
          <div class="variation-save">
            <span class="mono"><%= Job.step_operation(row[:step]) %></span>
            <span class="dim"> · <%= row[:step]["runner"] %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<% end %>
