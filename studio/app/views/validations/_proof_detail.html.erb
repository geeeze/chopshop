<%#
  The proof-detail popup. Shared by the job RESULTS page and the Jobs LIST, so
  the two cannot drift.

  Locals: d (a Hash from `proof_detail(v)`), job (the Job the proof belongs to)
%>
<div class="popup" id="proof-detail-<%= d[:validation].id %>" role="dialog" aria-modal="true"
     aria-labelledby="proof-detail-<%= d[:validation].id %>-title" hidden>
  <div class="popup-panel">
    <header class="popup-head">
      <h2 id="proof-detail-<%= d[:validation].id %>-title">Proof <span class="mono"><%= proof_label(d[:validation].file) %></span></h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <div class="cs-metrics" style="margin-bottom:1rem;">
        <% { "state" => d[:validation].state, "hard" => d[:summary]["hard"],
             "advisory" => d[:summary]["advisory"],
             "inks" => d[:stats]["rendered_ink_colors"],
             "nodes" => d[:statics]["path_nodes_total"],
             "dpi" => d[:stats]["dpi"] }.each do |label, value| %>
          <div class="cs-metric"><span><%= label %></span><b class="mono"><%= value || "–" %></b></div>
        <% end %>
      </div>

      <% if d[:findings].any? %>
        <h4 class="cs-detail-h">Findings</h4>
        <div class="cs-findings">
          <% d[:findings].each do |f| %>
            <% hard_f = f["severity"] == "hard" %>
            <div class="cs-finding">
              <span class="cs-finding-rule mono"><%= f["rule"] %></span>
              <span class="cs-finding-sev <%= hard_f ? "hard" : "adv" %>"><%= f["severity"] %></span>
              <span class="cs-finding-layer mono"><%= f["layer"] ? "L#{f['layer']}" : "" %></span>
              <div class="cs-finding-detail"><%= f["detail"] %></div>
            </div>
          <% end %>
        </div>
      <% elsif d[:validation].state == "done" %>
        <p style="color:var(--success);margin:0;">No findings — clean pass through both layers.</p>
      <% else %>
        <p class="popup-empty">This proof has not finished yet.</p>
      <% end %>

      <% if d[:cleared][:cleared].any? %>
        <h4 class="cs-detail-h">No hard findings — this proof clears</h4>
        <ul class="cleared-list">
          <% d[:cleared][:cleared].each do |c| %>
            <li>
              <span class="cleared-label"><%= c[:label] %></span>
              <span class="cleared-area mono"><%= c[:area] %></span>
              <span class="cleared-detail"><%= c[:detail] %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if d[:cleared][:skipped].any? %>
        <p class="cleared-skipped">Not run (not cleared): <%= d[:cleared][:skipped].to_sentence %>.</p>
      <% end %>

      <div class="cs-viewer-bar">
        <% if d[:png] %>
          <%= link_to "⬇ Proof PNG", file_job_path(job, name: d[:png]), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <% if d[:pdf] %>
          <%= link_to "⬇ Print PDF", file_job_path(job, name: d[:pdf]), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <%= link_to "Open proof →", validation_path(d[:validation]), class: "btn btn-secondary btn-sm", style: "margin-left:auto;" %>
      </div>

      <details class="cs-detail-raw"><summary class="mono">Raw manifest</summary>
        <div class="log-console" style="margin:0.6rem 0 0;"><pre><%= d[:manifest].present? ? JSON.pretty_generate(d[:manifest]) : "{}" %></pre></div>
      </details>
    </div>
  </div>
</div>
