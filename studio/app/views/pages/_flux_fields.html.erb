<%# The editable fields for ONE card, rendered as the page's own .print-grid.
    Shared by the four setting cards and by the GPU card, so a field's markup (and
    therefore its type, its min/step and its hint) cannot differ between the two.

    Locals: fields (Array of Hashes from FluxConf -- label, type, default, hint,
    and the optional env/min/max/step/options).

    #42 -- the scope of EACH field. A card is not one scope: on FLUX the Service
    card's fields are all service env, but Model carries env vars AND request
    parameters and Resolution is all per-job. So the chip is per FIELD, not per
    card, and it is derived from the field's own `env` key rather than typed into
    the partial -- a field with no `env` rides with the request (per job), and one
    with one is a service variable that needs a restart. That is the same test the
    page's help-block rule already uses, so the chip cannot disagree with the
    help about which fields are environment.
%>
<div class="print-grid">
  <% fields.each do |f| %>
    <% id = "f_flux_#{f[:label]}" %>
    <div class="field">
      <label for="<%= id %>"><%= f[:label] %></label>
      <%# The scope chip: the word is the field's own kind, read from `env`, and
          it sits as its own line between the label and the control so it reads
          as what the field IS rather than as a second control. A bare sibling
          rather than a wrapper div: the chip is a <span> and .field carries no
          display rule, so it takes its own line with no new CSS. %>
      <%= render partial: "shared/scope_chip",
                 locals: { scope: f[:env] ? "service · restart" : "per job",
                           label: "flux #{f[:label]}" } %>
      <% case f[:type] %>
      <% when :select %>
        <select id="<%= id %>" data-flux-field="<%= f[:label] %>">
          <% Array(f[:options]).each do |opt| %>
            <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
          <% end %>
        </select>
      <% when :number %>
        <input type="number" id="<%= id %>" data-flux-field="<%= f[:label] %>"
               value="<%= f[:default] %>"
               <%= "min=\"#{f[:min]}\"".html_safe if f[:min] %>
               <%= "max=\"#{f[:max]}\"".html_safe if f[:max] %>
               <%= "step=\"#{f[:step]}\"".html_safe if f[:step] %>>
      <% when :static %>
        <%# A contract fact, not a setting: shown as a value rather than offered
            as an input that would do nothing. #16 -- the composer reads named
            fields only, so a field nothing reads is a lie as an input; it is
            the same shape the BP cards' reference facts use. The data-flux-field
            hook is kept so the field is still findable by name, but it carries
            no `.value`, and build() never asks it for one. %>
        <div class="mono" id="<%= id %>" data-flux-field="<%= f[:label] %>"><%= f[:default] %></div>
      <% else %>
        <input type="text" id="<%= id %>" data-flux-field="<%= f[:label] %>"
               class="mono" value="<%= f[:default] %>">
      <% end %>
      <%# A field whose hint is registered (HelpTips) renders the registry's own
          one-line `line` plus the `?` that opens its detail, so the long
          account lives in ONE place rather than in this partial and the
          registry. A field with no help_key keeps its own short hint. %>
      <div class="hint"><%= f[:help_key] ? help_tip(f[:help_key]) : f[:hint] %></div>
    </div>
  <% end %>
</div>
