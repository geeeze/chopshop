# Chopshop Studio — operator configuration.
#
# Copy to .env (gitignored) and edit. Nothing here names a host, a network or a
# machine: a runner is whatever URL you point at, so ONE file describes a
# single-box install and a split install equally well. That is deliberate — the
# repo must not learn anyone's topology.
#
#   podman run -d --name chopshop-app -p 127.0.0.1:3001:3001 \
#     -v "$PWD":/app:rw --env-file .env chopshop-app

# --- the app --------------------------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=change-me

# Login is per-user, not a shared password: a bcrypt `users` table where the
# password IS the identity (no username, no directory). Nothing goes here — seed
# each account from the app directory instead:
#
#   bin/rails 'users:add[handle,password]'   # create one user
#   bin/rails users:list                     # list handles (never digests)
#
# CHOPSHOP_PASSWORD is no longer read by the app: the operator's original
# password was migrated unchanged into that table, so their usual login works.

# --- runners --------------------------------------------------------------
# One variable per runner, keyed by the label you want to see in the GUI. The
# label is the variable name with CHOPSHOP_RUNNER_ and _URL stripped and
# lower-cased, so underscores stay underscores:
#
#   CHOPSHOP_RUNNER_STUDIO_A_URL   ->  "studio_a"
#
# A runner's KIND defaults to "svg": the pipeline contract (docs/runner-contract.md)
# — prep, trace, gate. Set _KIND=flux for a chopshop-flux service, which generates
# a raster from a prompt and speaks its own standard API instead. The svg default
# is why renaming a runner needs no code change anywhere.

# Shape 1 — LOCAL MONOLITH. Everything on one box.
# The SVG runner's port is the service's own RUNNER_PORT (8787, chopshop-svg's
# runner.py). 8791 named nothing and was the origin of a studio that reported a
# healthy runner as DOWN.
# CHOPSHOP_RUNNER_SVG_URL=http://127.0.0.1:8787
# CHOPSHOP_RUNNER_FLUX_URL=http://127.0.0.1:8795
# CHOPSHOP_RUNNER_FLUX_KIND=flux

# ...unless the studio is itself in a container on that same box, which is the
# dev rig here. A container cannot reach a service bound to the HOST's loopback:
# measured, with the service on 127.0.0.1 the container gets ECONNREFUSED, and on
# 0.0.0.0 it gets 200. So for that shape, bind the service to 0.0.0.0 (or the
# bridge address) and point the studio at the address that service is PUBLISHED
# on — the tailnet/LAN address, or the bridge gateway.
#
# Do NOT reach for host.containers.internal: it resolves (169.254.1.2) and
# answers for a service bound to 0.0.0.0, but it does NOT reach a container
# port published with -p 127.0.0.1:<port> or -p <ip>:<port>. Measured against a
# running flux: 169.254.1.2:8795 -> refused while 100.125.38.46:8795 -> 200. A
# studio pointed at the alias therefore reports a healthy runner as DOWN.
# CHOPSHOP_RUNNER_FLUX_URL=http://host.containers.internal:8795
# CHOPSHOP_RUNNER_FLUX_KIND=flux

# Shape 2 — SPLIT. The studio here, the compute elsewhere. Any address that
# reaches it: a tailnet name, a LAN address, a tunnel. Both ends need nothing
# from each other beyond the URL and the tokens below.
# CHOPSHOP_RUNNER_SVG_URL=http://pipeline-host:8787
# CHOPSHOP_RUNNER_FLUX_URL=http://compute-host:8795
# CHOPSHOP_RUNNER_FLUX_KIND=flux

# Where a flux job hands its raster once it has been generated. Defaults to the
# first non-mock pipeline runner above, so it usually needs no setting.
# CHOPSHOP_FLUX_HANDOFF_RUNNER=svg

# Accounts `bin/rails users:reset` must NEVER touch: this operator's own handles,
# comma-separated. The task FAILS CLOSED -- with this unset it refuses every
# handle rather than guessing which one is disposable -- so set it on any host
# where the task is used. It is configuration rather than a literal in the task
# because that file ships with the app (issue #16).
# CHOPSHOP_PROTECTED_HANDLES=<operator-handle>

# --- tokens ---------------------------------------------------------------
# Bearer token between the studio and a pipeline runner, if that runner sets one.
# RUNNER_TOKEN=change-me

# The chopshop-flux service's OWN token. Separate from RUNNER_TOKEN on purpose:
# that service keeps a clean standard API which other applications also call, so
# it does not share the pipeline's credential.
# CHOPSHOP_FLUX_TOKEN=change-me

# --- chopshop-plot (and its blender operation) -----------------------------
# One service draws SVG charts/diagrams (plot) AND renders 3D geometry via
# headless Blender (the "blender" operation) — it is one server, one token.
# Runner kinds: _KIND=plot files a runner under the PLOT surface; _KIND=blender
# files one under the blender operation. Both POST to that same service.
# CHOPSHOP_RUNNER_PLOT_URL=http://127.0.0.1:8796
# CHOPSHOP_RUNNER_PLOT_KIND=plot
# CHOPSHOP_RUNNER_BLENDER_URL=http://127.0.0.1:8796
# CHOPSHOP_RUNNER_BLENDER_KIND=blender
#
# The shared bearer token the studio sends to that service (and the variable
# the service reads on its own host to enforce it — one name, both sides).
# CHOPSHOP_BP_TOKEN=change-me

# --- reporting a problem ---------------------------------------------------
# The footer's maintenance button opens a popup where any signed-in operator
# describes what happened, what they expected, or a suggestion, and it is filed
# as a GitHub issue labelled `needs-triage` plus a kind label (`bug`,
# `expectation`, `suggestion`). The studio adds the page, the account handle,
# the version and the browser to the issue, so a reporter is never chased for
# facts only the server can see.
#
# A fine-grained PAT with `issues: write` on the repository below. Nothing else
# is needed, and nothing else is asked for.
# CHOPSHOP_GITHUB_TOKEN=github_pat_...
#
# WHERE A DEPLOYMENT PUTS IT: this is the value the app reads, and it is NOT
# the same file an agent keeps its own token in. On the live box the systemd
# unit's EnvironmentFile is the source of truth —
#
#     ~/.chopshop-studio.env                  <- the app reads THIS
#     the agent's Hermes env file             <- the agent keeps its copy HERE
#
# so edit the studio env file (or edit the Hermes one and copy the value
# across), then `systemctl --user restart chopshop-rails`.
#
# LEAVING IT UNSET IS SAFE AND VISIBLE: the popup still opens, says filing is
# not configured, and keeps the typed report on screen instead of pretending to
# send it. It never fails silently.
# CHOPSHOP_GITHUB_REPO=geeeze/chopshop-studio
