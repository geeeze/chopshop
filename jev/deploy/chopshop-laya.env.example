# chopshop-laya: the local decision service's environment. Copy to
# ~/.config/chopshop-laya.env and edit. This file is the ONLY place a host, a
# path or a token is named -- the unit itself is generic, and so is the code.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no shell expansion.
# Quotes are literal, so do not wrap values in quotes.

# --- the service ----------------------------------------------------------
# The virtualenv's laya-serve entry point. The commented install block in
# ../docs/local-decision-service.md creates exactly this path.
CHOPSHOP_LAYA_SERVE=/path/to/laya/.venv/bin/laya-serve

# Where the weights live. Without this the service downloads ~1.7 GB into the
# default huggingface cache on first request -- and again after any wipe.
HF_HOME=/path/to/models/hf

# --- where it listens -----------------------------------------------------
# Loopback is the default and the right answer for a single-box install: the
# annotator and the service on one machine, nothing exposed.
LAYA_HOST=127.0.0.1

# A SPLIT install -- the pipeline on one machine, the decision service on
# another -- is an explicit act, and it takes BOTH of these:
#
#   LAYA_HOST=<the private address this box is reachable on>
#   LAYA_API_KEY=<a shared secret>
#
# The bind is whatever address the caller can reach: a tailnet address, a LAN
# address, a tunnel. Setting the token is not optional once the bind leaves
# loopback -- an unauthenticated decision endpoint on a shared network is
# somebody else's model, and every command's projected state goes to it.
#
# 8790 mock runner, 8787 svg runner, 8795 flux, 8796 plot, 8797 this service.
LAYA_PORT=8797

# --- how it answers -------------------------------------------------------
# `cuda` on a ROCm/CUDA box, `cpu` elsewhere. The model is 421M parameters, so
# CPU is a legitimate deployment for four questions per proof.
LAYA_DEVICE=cpu

# Preload the checkpoint the annotator will name. `typed-decisions` is the one
# fine-tuned for this exact workflow (choice / score / noul over a document),
# and it is measurably the better fit: on a real preflight manifest whose only
# finding is a palette mismatch, `english` answered `render_or_tool_failure`
# (there is no render failure in it) where `typed-decisions` answered
# `palette_mismatch`. The ANNOTATOR still has to name it -- English text routes
# to `english` on its own -- so set JEV_MODEL=typed-decisions on the caller too.
LAYA_MODELS=typed-decisions
LAYA_PRELOAD=1

# Both named checkpoints stay resident (LAYA_MAX_LOADED, default 2), so naming
# `english` from a caller still works without a reload. Raise it only if you
# serve more than two at once: each resident checkpoint is ~1.7 GB of RAM.
# LAYA_MAX_LOADED=2

# Four questions arrive in one request and the studio serialises its queue, so
# a small cap is honest: excess requests get a 503 rather than queueing behind
# a forward pass.
LAYA_MAX_CONCURRENT=4

# Cap on per-request max_len, if a checkpoint's default is larger than this box
# should hold. 8192 is the upstream default.
# LAYA_MAX_TOKEN_BUDGET=8192

LAYA_LOG_LEVEL=info

# Required once LAYA_HOST leaves loopback -- and this is the SAME value the
# caller passes as JEV_API_KEY, because the annotator sends it as a bearer
# token exactly as it does for the hosted service.
# LAYA_API_KEY=

# --- advanced tuning (defaults are fine; uncomment to change) ---------------
# LAYA_THREADS=            # torch CPU threads (default: torch's own choice)
# LAYA_REVISION=           # pin a checkpoint revision
# LAYA_CPU_AMP=            # CPU autocast policy
# LAYA_CUDA_AMP=           # GPU autocast policy
# LAYA_MPS_AMP_MIN_ROWS=   # MPS autocast threshold
# LAYA_AUTO_TASK=0         # auto-route a task when the request doesn't name one
# HF_TOKEN=                # huggingface auth for gated checkpoints
# LAYA_SHA256_DIGESTS=1    # require sha256 pinning when a revision is fetched
