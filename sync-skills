#!/usr/bin/env python3
"""sync-skills — refresh the in-repo `skills/` copy of the chopshop-studio
skill from the on-disk Hermes working skill, TAGGING host-specific content.

This repo (chopshop-studio) is PRIVATE, so host-specific knowledge may live
here — but it must be TAGGED so a reader (or a future agent on another host)
can tell deployment facts apart from host-agnostic knowledge, and knows what
to remove or generalize later.

The tag is the token `HOST-SPECIFIC`, used two ways:

  * a banner line `> HOST-SPECIFIC — …` under a fully-host section heading,
    and at the top of any reference file that names this box's paths/ports;
  * the convention itself is explained at the top of the generated SKILL.md.

Direction is ONE-WAY: never import a repo copy back over the working skill.
The on-disk skill is the source of truth; this script only ever publishes a
tagged copy out of it.

USAGE
    ./sync-skills            refresh the tagged copy
    ./sync-skills --check    report drift only (change nothing)
    ./sync-skills --diff     show what would change
"""
from __future__ import annotations

import argparse
import difflib
import os
import shutil
import sys

REPO = os.path.dirname(os.path.abspath(__file__))
SKILLS_DIR = os.path.join(REPO, "skills")
HERMES_SKILLS = os.path.expanduser("~/.hermes/skills")

# Skills whose content is GENERATED (disk -> repo, host-tagged) from the
# matching on-disk Hermes skill. A listed skill with no on-disk source is a
# HARD ERROR, not a skip — the silent skip is what once let copies rot.
GENERATED = (
    "chopshop-studio",
)

