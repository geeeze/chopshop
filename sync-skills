# matching on-disk Hermes skill. A listed skill with no on-disk source is a
# HARD ERROR, not a skip — the silent skip is what once let copies rot.
#
# Empty since 2026-09-28: the `chopshop-studio` disk skill was retired and the
# in-repo copy became the source of truth (see the module docstring). A listed
# skill whose source is missing would still be a hard error here, so this list
# can be re-populated if a new disk->repo skill is ever added.
GENERATED = ()

