# chopshop-flux: the service's environment. Copy to ~/.config/chopshop-flux.env
# and edit. This file is the ONLY place a host, a path or a token is named --
# the unit itself is generic, and so is the code.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no shell expansion.
# Quotes are literal, so do not wrap values in them.

# --- the interpreter ------------------------------------------------------
# The environment that already has torch + diffusers. Not pinned by this repo:
# a working GPU stack is a multi-GB, platform-specific install.
CHOPSHOP_FLUX_PYTHON=/path/to/gpu-venv/bin/python

# If the GPU environment is not yours to modify, `accelerate` was installed
# beside this checkout with --target instead. Uncomment to pick it up. Leave
# commented when accelerate is already in the interpreter above.
# PYTHONPATH=/path/to/chopshop-flux/.vendor

# Where the weights live. Without this the service looks in the default
# huggingface cache and re-downloads 15 GB.
HF_HOME=/path/to/models/hf
# HF_TOKEN=                # gated-checkpoint auth (downloads are free; the
#                          # account has NO billing -- HF inference endpoints
#                          # return 402 and must never be used)

# --- where it listens -----------------------------------------------------
# Loopback is the default and the right answer for a single-box install: the
# studio and the service on one machine, nothing exposed.
CHOPSHOP_FLUX_BIND=127.0.0.1

# A SPLIT install -- the studio on one machine, the GPU on another -- is an
# explicit act, and it takes BOTH of these:
#
#   CHOPSHOP_FLUX_BIND=<the private address this box is reachable on>
#   CHOPSHOP_FLUX_TOKEN=<a shared secret>
#
# The bind is whatever address the studio can reach: a tailnet address, a LAN
# address, a tunnel. Setting the token is not optional once the bind leaves
# loopback -- an unauthenticated generation endpoint on a shared network is
# somebody else's free GPU.

CHOPSHOP_FLUX_PORT=8795

# --- generation defaults --------------------------------------------------
# 8787 is chopshop-svg's runner, 8790 the studio's mock. 8795 is this one.
CHOPSHOP_FLUX_OUT=/path/to/chopshop-flux/out
# CHOPSHOP_FLUX_MODEL=klein-4b   # NOT READ by the service (measured: zero code
#                                # references) -- the model is chosen per request.
#                                # Kept only so a reader who meets it elsewhere
#                                # learns that here it does nothing.
# CHOPSHOP_FLUX_OFFLOAD=cpu        # `none` does not fit on a 16 GB card here
# CHOPSHOP_FLUX_MAX_PIXELS=2097152 # optional global ceiling: lowers every model's cap
# CHOPSHOP_FLUX_TOKEN=
# CHOPSHOP_FLUX_ACK_NONCOMMERCIAL=1   # only for a non-commercial model

# --- keeping the weights from being a leak --------------------------------
# Seconds of no generation after which the loaded model is unloaded. 0 (default)
# never unloads on idle, so the ~16 GB of weights stay in host RAM and the next
# generation skips the load. Set it positive on a box that shares its RAM — but
# MEASURED, the unload does NOT hand the memory back: after a successful unload
# the process still held 16.2 GB of ANONYMOUS memory (RssAnon), so the box stayed
# short by the weights' worth of RAM while the next request paid one load.
# 900 (15 min) is the value used on the GPU box.
# CHOPSHOP_FLUX_IDLE_UNLOAD=900
#
# The half that actually returns the RAM: after unloading, MEASURE RssAnon and,
# if the memory is still held, drain for CHOPSHOP_FLUX_DRAIN_SECONDS (every
# request gets 503 kind:"restarting" with retry_after) and exit non-zero so the
# unit's ordinary Restart=on-failure brings the service back. Verified end to
# end on the box: 16.22 GB held -> 0.01 GB after the restart.
# CHOPSHOP_FLUX_IDLE_EXIT=1
# CHOPSHOP_FLUX_DRAIN_SECONDS=5
#
# The client's half of the same window (read where the request is made, not by
# the service): a REFUSED connect is retried rather than reported as a failure.
# CHOPSHOP_FLUX_RECONNECT_ATTEMPTS=4   # tries incl. the first (1 = no retry)
# CHOPSHOP_FLUX_RECONNECT_BACKOFF=2    # seconds before the Nth retry, times N
#
# --- GPU contention guard (#flux-gpu-guard) --------------------------------
# This card may be shared (e.g. with a local model server). The guard is FREE
# VRAM: before a load it measures what is on the card and acts per the mode.
# `warn` (the default — config.py falls back to it) proceeds with a warning;
# `wait` blocks until enough VRAM frees (up to GUARD_WAIT seconds); `off`
# disables the guard entirely.
# CHOPSHOP_FLUX_GUARD=warn
# CHOPSHOP_FLUX_GUARD_VRAM_GB=5.0    # VRAM a load wants to find free
# CHOPSHOP_FLUX_GUARD_WAIT=120       # seconds `wait` mode blocks before failing
# CHOPSHOP_FLUX_GUARD_POLL=5.0       # seconds between free-VRAM polls in `wait`
# CHOPSHOP_FLUX_LMSTUDIO_URL=http://127.0.0.1:1234   # naming a holder only; state is read from free VRAM

# --- remote backend (novita) ----------------------------------------------
# ming-image models run over the novita HTTP API instead of local weights. The
# key is read at CALL time (never at import); the service refuses a remote model
# before the first request if it is unset.
# CHOPSHOP_FLUX_NOVITA_API_KEY=
# CHOPSHOP_FLUX_NOVITA_BASE_URL=    # override the API endpoint (tests/proxies)
# CHOPSHOP_FLUX_NOVITA_USER_AGENT=  # override the request UA
# CHOPSHOP_FLUX_NOVITA_TIMEOUT=120  # seconds before a remote call gives up

# --- engine knob (SERVER-side) --------------------------------------------
# CHOPSHOP_FLUX_VAE_TILING=1        # lower peak VRAM, slower decode

# --- client-side (chopshop-flux CLIENTS, e.g. the studio) ------------------
# Read by client.py, NOT by this service: setting them here does nothing.
# CHOPSHOP_FLUX_PIPELINE=           # force a specific pipeline class
# CHOPSHOP_FLUX_URL=                # external base URL clients should use

# The two glibc knobs that make the release actually return pages
# (MALLOC_MMAP_THRESHOLD_=131072, MALLOC_ARENA_MAX=2) and the MemoryMax tripwire
# are set in the UNIT, not here: glibc reads them at process start, they are not
# per-install tunables, and losing them restores the OOM. See
# deploy/chopshop-flux.service.
