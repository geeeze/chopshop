# chopshop-caption: the captioner's environment. Copy to
# ~/.config/chopshop-caption.env and edit. This file is the ONLY place a host, a
# path, a port or a token is named — the unit itself is generic, and so is the
# code (see ../scripts/caption_serve.py: every setting is read from here).
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no shell expansion.
# Quotes are literal, so do not wrap values in quotes.
#
# WHY THIS EXISTS (chopshop-jev#2): the `generation-slop` vocabulary's
# `prompt_adherence` question needs a PICTURE, and the decision service is a
# text model. This endpoint supplies the text form of the picture; the harness
# carries it back inside the artifact and the projector turns it into
# `image_visible` evidence. Without this service the question stays
# `unevidenced`, which is the honest state it was in before.

# --- how to start it -------------------------------------------------------
# The interpreter that has transformers (>= 5.1) and Pillow — on this box that
# is the ComfyUI venv, which already has torch; do NOT pip-install into somebody
# else's environment, point at your own.
#   CHOPSHOP_CAPTION_SERVE=<python> <repo>/scripts/caption_serve.py
CHOPSHOP_CAPTION_SERVE=/path/to/python /path/to/chopshop-jev/scripts/caption_serve.py

# Where the weights live. Without this the first request downloads ~1 GB into
# the default huggingface cache — and again after any wipe.
HF_HOME=/path/to/models/hf

# --- what it answers with --------------------------------------------------
# Liquid AI's 450M vision-language model: captioning is an explicitly supported
# task, and it processes 512x512 natively — the frame size slop_cannon
# generates at — so nothing is upscaled to be read.
CAPTION_MODEL=LiquidAI/LFM2.5-VL-450M

# cpu is the honest default: 450M parameters is a few seconds per caption on a
# shared box, and the GPU belongs to the generator while a bracket is running.
# cuda if you would rather pay VRAM than wall clock.
CAPTION_DEVICE=cpu

# --- where it listens ------------------------------------------------------
# Loopback is the right answer for a single-box install: the harness and the
# service on one machine, nothing exposed, so no token is needed.
CAPTION_HOST=127.0.0.1
CAPTION_PORT=8798

# A SPLIT install — pipeline on one box, captioner on another — is an explicit
# act and it takes BOTH of these:
#   CAPTION_HOST=<the private address this box is reachable on>
#   CAPTION_API_KEY=<a shared secret>
# The service REFUSES to bind off loopback without the token: every raster the
# pipeline drew would otherwise be POSTable to it by anyone who can reach it.
# CAPTION_API_KEY=

# --- behaviour -------------------------------------------------------------
# Load the weights at start rather than on the first request: the harness's
# first caption then costs seconds instead of a minute. Off saves the RAM when
# the service is installed but rarely used.
CAPTION_PRELOAD=1

# Tokens generated per caption. One or two sentences is ~40-60; the default
# leaves room for the "anything visibly wrong with it" clause the prompt asks
# for, without letting a caption become an essay.
CAPTION_MAX_NEW_TOKENS=96

# The question the captioner is asked. Change this and you change what the
# evidence for prompt_adherence IS, so record the change with the run that used
# it — a caption written for a different question is a different measurement.
# CAPTION_PROMPT=Describe this image in one or two sentences: what is depicted, what style it is rendered in, and anything visibly wrong with it.

# info to log each request (default: quiet).
# CAPTION_LOG_LEVEL=info
