# secrets — never commit
.env*
!.env.example

# Rails credentials. The ENCRYPTED file may be committed; the KEY that
# decrypts it may not. config/master.key was tracked from the first commit
# and decrypts config/credentials.yml.enc -- treat any key ever pushed as
# compromised and rotate it, since removing it now does not unpublish it.
config/master.key

# rails runtime
/log/*
/tmp/*
/storage/
coverage/

# uploaded rasters (user data, not code)
/public/uploads/

# precompiled assets (built per-deploy)
/public/assets/

# sqlite dbs
*.sqlite3
*.sqlite3-*

# Bundler install path. BUNDLE_PATH lives in .bundle/config and the gems land in
# vendor/bundle -- 171MB of them on this box. Neither was ignored, so a stray
# `git add -A` committed the entire bundle. Ignore the config AND the tree, and
# keep them adjacent so the next person adding one adds the other.
/.bundle/
/vendor/bundle/

# os junk
.DS_Store

# python bytecode (mock-runner)
__pycache__/
*.pyc

# Captured review log — host paths + shell transcript, never publish
REVIEW.log
