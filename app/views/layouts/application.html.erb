<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "Chopshop Studio" %> · Chopshop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "palette-tool", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_user %>
      <nav class="topbar">
        <div class="container nav-content">
          <a href="<%= root_path %>" class="logo">
            <div class="logo-icon">✂</div>
            <div class="logo-text">Chopshop<span>Studio</span></div>
          </a>
          <ul class="nav-links">
            <li><a href="<%= root_path %>">Jobs</a></li>
            <li><a href="<%= new_job_path %>">Run Job</a></li>
            <li><a href="<%= json_path %>">JSON</a></li>
            <li><a href="<%= about_path %>">???</a></li>
            <li><a href="<%= flux_path %>">FLUX</a></li>
            <li><a href="<%= jev_path %>">JEV</a></li>
          </ul>
          <div class="nav-side">
            <% health = Job.runners.keys.map { |r| [r, RunnerClient.health(Job.runners[r])] } %>
            <details class="runner-menu">
              <summary class="runner-pill"><span class="dot"></span>runners ▾</summary>
              <div class="runner-dropdown">
                <% health.each do |name, h| %>
                  <div class="runner-row">
                    <span class="dot <%= h && h[:ok] ? 'dot-ok' : 'dot-down' %>"></span>
                    <span class="mono"><%= name %></span>
                    <span class="runner-status"><%= h && h[:ok] ? "up" : "down" %></span>
                  </div>
                <% end %>
              </div>
            </details>
            <%= button_to "Log out", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="container">
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>

    <footer class="footer-note">
      <div class="container footer-inner">
        <span>chopshop-svg · trace → you pick → proof · the pipeline never picks a winner</span>
        <span class="mono">private demo</span>
      </div>
    </footer>

    <% if flash[:welcome] %>
      <div class="welcome-overlay" id="welcomeOverlay" role="dialog" aria-label="Welcome">
        <div class="welcome-type" id="welcomeType" aria-live="polite"></div>
      </div>
    <% end %>
  </body>
</html>
