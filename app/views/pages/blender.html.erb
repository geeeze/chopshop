<div class="page-head">
  <%# The PLOT page's head arrangement, exactly: Run Job in grid row 1, the popup
      pair in row 2 col 2, blurb in row 2 col 1 -- and the blurb LAST in the row,
      which is what the phone media query places by grid-row. %>
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">BLENDER</span> — geometry renderer</h1>
    <%= link_to "Run Job", new_job_path, class: "btn btn-primary head-action head-action--top" %>
    <%# A PAIR, like PLOT's: FIELDS first because the document's vocabulary --
        the element types, the blocks beside them and the two response shapes --
        is what decides everything on this page, so it is what you reach for when
        a render is refused. JSON second, the generated conf. %>
    <div class="head-action-pair head-action--below">
      <button type="button" class="btn btn-secondary head-action" data-popup="blender-fields-popup"
              title="The element types, the document's blocks and the two response shapes"
              aria-label="The element types, the document's blocks and the two response shapes">FIELDS</button>
      <button type="button" class="btn btn-secondary head-action" data-popup="blender-conf-popup"
              title="View the generated service configuration as JSON"
              aria-label="View the generated service configuration as JSON">JSON</button>
    </div>
    <p class="page-head-blurb">This page configures the <span class="mono">blender</span> operation of <span class="mono">chopshop-plot</span> and renders nothing itself — the geometry document, its views and its export are requests to that service.</p>
  </div>
</div>

<%# The four cards render from BlenderConf::CARDS, and the help blocks below
    render from the same fields -- so a card's "?" documents that card's fields
    and nothing else by construction, which is the rule the JSON page has to
    enforce with a test because its cards are hand-written. %>
<div class="grid-2" style="align-items:stretch;">
  <% BlenderConf::CARDS.each do |card| %>
    <div class="card" data-blender-card="<%= card[:title] %>">
      <div class="card-head">
        <h3><%= card[:title] %></h3>
        <button type="button" class="help-btn" data-help-title="<%= card[:title] %>"
                data-help-target="<%= card[:help] %>"
                aria-label="Explain <%= card[:title] %>" title="Explain <%= card[:title] %>">?</button>
      </div>
      <p class="jev-question"><%= card[:blurb] %></p>

      <% if card[:title] == "Service" %>
        <%# The runners this deployment actually files as blender runners. The map
            is env-driven, so the page reports the live one rather than the default
            it documents -- and "none configured" is a real answer, not an error:
            the settings below stand on their own. The nav's runner pill is the
            live check; this page never calls the service. %>
        <div class="actions-row" id="blenderRunnerRow">
          <span class="status-pill <%= @blender_runners.any? ? "status-pass" : "status-pending" %>"
                id="blenderRunnerPill"><%= @blender_runners.any? ? "#{@blender_runners.size} configured" : "none configured" %></span>
          <span class="tech-tag" id="blenderRunnerNote">
            <% if @blender_runners.any? %>
              <%= @blender_runners.map { |label, url| "#{label} → #{url}" }.join(" · ") %>
            <% else %>
              set CHOPSHOP_RUNNER_BLENDER_URL, and CHOPSHOP_RUNNER_BLENDER_KIND=blender
            <% end %>
          </span>
        </div>
      <% end %>

      <div class="print-grid">
        <% card[:fields].each do |f| %>
          <% id = "f_blender_#{card[:title].downcase}_#{f[:label].to_s.tr(' ', '_')}" %>
          <div class="field">
            <label for="<%= id %>"><%= f[:label] %></label>
            <% case f[:type] %>
            <% when :select %>
              <select id="<%= id %>" data-blender-field="<%= f[:label] %>">
                <% Array(f[:options]).each do |opt| %>
                  <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
                <% end %>
              </select>
            <% when :number %>
              <input type="number" id="<%= id %>" data-blender-field="<%= f[:label] %>"
                     value="<%= f[:default] %>"
                     <%= "min=\"#{f[:min]}\"".html_safe if f[:min] %>
                     <%= "max=\"#{f[:max]}\"".html_safe if f[:max] %>>
            <% when :static %>
              <%# A contract fact, not a setting: shown as a value rather than
                  offered as an input that would do nothing. %>
              <div class="mono" id="<%= id %>" data-blender-field="<%= f[:label] %>"><%= f[:default] %></div>
            <% else %>
              <input type="text" id="<%= id %>" data-blender-field="<%= f[:label] %>"
                     class="mono" value="<%= f[:default] %>">
            <% end %>
            <div class="hint"><%= f[:hint] %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# ============ Checks: the live contract check, full width ============
    Its own card rather than a panel inside Scene or Render: it answers rather
    than configures. The document is pasted here and checked against the
    contract's own rules, and the answer is rendered server-side first so the
    card is correct with JavaScript off. %>
<% check_fields = BlenderConf::CHECKS[:fields].index_by { |f| f[:label] } %>
<% initial_check = BlenderConf.validate(
     elements: check_fields["document"][:default]["elements"],
     views: check_fields["views"][:default],
     engine: check_fields["engine"][:default]) %>
<div class="card" data-blender-checks="<%= BlenderConf::CHECKS[:title] %>">
  <div class="card-head">
    <h3><%= BlenderConf::CHECKS[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= BlenderConf::CHECKS[:title] %>"
            data-help-target="<%= BlenderConf::CHECKS[:help] %>"
            aria-label="Explain <%= BlenderConf::CHECKS[:title] %>"
            title="Explain <%= BlenderConf::CHECKS[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= BlenderConf::CHECKS[:blurb] %></p>

  <div class="field">
    <label for="f_blender_check_document">document <span class="mono">(JSON)</span></label>
    <textarea id="f_blender_check_document" class="mono blender-doc" rows="12"
              spellcheck="false" autocomplete="off"
              data-blender-check="document"><%= JSON.pretty_generate(check_fields["document"][:default]) %></textarea>
    <div class="hint"><%= check_fields["document"][:hint] %></div>
  </div>

  <div class="print-grid">
    <% ["views", "engine"].each do |label| %>
      <% f = check_fields[label] %>
      <div class="field">
        <label for="f_blender_check_<%= label %>"><%= label %></label>
        <select id="f_blender_check_<%= label %>" data-blender-check="<%= label %>">
          <% Array(f[:options]).each do |opt| %>
            <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
          <% end %>
        </select>
        <div class="hint"><%= f[:hint] %></div>
      </div>
    <% end %>
  </div>

  <div class="jev-derived" id="blenderCheckDerived">
    <p class="jev-derived-label">Derived, as the contract would see it</p>
    <div class="jev-card">
      <div class="a <%= initial_check[:problems].any? ? "is-bad" : "is-ok" %>" id="blenderCheckVerdict"><%= initial_check[:problems].any? ? "rejected" : "accepted" %></div>
      <div class="note"><%= initial_check[:problems].any? ? "the service would refuse this as a caller error" : "the service would render it" %></div>
    </div>
    <%# The service's own sentences, and nothing else: an empty problem list is
        the whole answer when the document is accepted. JS refills this element;
        the server-rendered content is the example document above. %>
    <div id="blenderCheckProblems">
      <% if initial_check[:problems].any? %>
        <% initial_check[:problems].each do |problem| %>
          <p class="jev-note is-bad"><%= problem %></p>
        <% end %>
      <% else %>
        <% initial_check[:notes].each do |note| %>
          <p class="jev-note"><%= note %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%# ============ Responses: the two success shapes and the one state ============
    What every caller branches on, so it is a card of its own rather than a
    sentence inside another one. %>
<div class="card" data-blender-shapes="<%= BlenderConf::SHAPES[:title] %>">
  <div class="card-head">
    <h3><%= BlenderConf::SHAPES[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= BlenderConf::SHAPES[:title] %>"
            data-help-target="<%= BlenderConf::SHAPES[:help] %>"
            aria-label="Explain <%= BlenderConf::SHAPES[:title] %>"
            title="Explain <%= BlenderConf::SHAPES[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= BlenderConf::SHAPES[:blurb] %></p>

  <div class="print-grid">
    <% BlenderConf::RESPONSES.each do |name, why| %>
      <div class="jev-derived">
        <p class="jev-derived-label mono"><%= name %></p>
        <p class="jev-note"><%= why %></p>
      </div>
    <% end %>
  </div>
</div>

<%# The two deployments, and what has to be true of a host for each. Full width
    for the same reason the cards above are: two columns of shapes and their
    variables need the room, and half a page would make them a footnote. %>
<div class="card" data-blender-placement="<%= BlenderConf::PLACEMENT[:title] %>">
  <div class="card-head">
    <h3><%= BlenderConf::PLACEMENT[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= BlenderConf::PLACEMENT[:title] %>"
            data-help-target="<%= BlenderConf::PLACEMENT[:help] %>"
            aria-label="Explain <%= BlenderConf::PLACEMENT[:title] %>"
            title="Explain <%= BlenderConf::PLACEMENT[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= BlenderConf::PLACEMENT[:blurb] %></p>

  <div class="print-grid">
    <% BlenderConf::PLACEMENT[:shapes].each do |name, why, vars| %>
      <div class="jev-derived">
        <p class="jev-derived-label"><%= name %></p>
        <p class="jev-note"><%= why %></p>
        <%# The variables ARE the difference between the two shapes, so they sit
            on the card rather than only behind the help: the variable, then what
            it does. %>
        <dl class="help-notes">
          <% vars.each do |var, gloss| %>
            <dt class="mono"><%= var %></dt>
            <dd><%= gloss %></dd>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>
</div>

<%# ============ the help each "?" reveals ============
    One block per card, built from that card's own fields: the <dt> is the
    field's label and the <dd> its help, so the help cannot document a field the
    card does not have, nor miss one it does. %>
<% BlenderConf::CARDS.each do |card| %>
  <div id="<%= card[:help] %>" hidden>
    <dl class="help-notes">
      <% card[:fields].each do |f| %>
        <dt><%= f[:label] %><% if f[:env] %> <span class="mono">· <%= f[:env] %></span><% end %></dt>
        <dd><%= f[:help] %></dd>
      <% end %>
    </dl>
  </div>
<% end %>

<%# The Checks, responses and placement cards answer rather than configure, so
    their help documents what the card shows rather than a field list. Same dl
    vocabulary, so they read like the four above. %>
<div id="<%= BlenderConf::CHECKS[:help] %>" hidden>
  <dl class="help-notes">
    <% BlenderConf::CHECKS[:fields].each do |f| %>
      <dt><%= f[:label] %></dt>
      <dd><%= f[:help] %></dd>
    <% end %>
  </dl>
</div>

<div id="<%= BlenderConf::SHAPES[:help] %>" hidden>
  <dl class="help-notes">
    <% BlenderConf::RESPONSES.each do |name, why| %>
      <dt><%= name %></dt>
      <dd><%= why %></dd>
    <% end %>
  </dl>
</div>

<div id="<%= BlenderConf::PLACEMENT[:help] %>" hidden>
  <dl class="help-notes">
    <% BlenderConf::PLACEMENT[:entries].each do |label, help| %>
      <dt><%= label %></dt>
      <dd><%= help %></dd>
    <% end %>
  </dl>
</div>

<%# ============ FIELDS: the document's vocabulary and the shapes ============ %>
<div class="popup" id="blender-fields-popup" role="dialog" aria-modal="true"
     aria-labelledby="blender-fields-popup-title" hidden>
  <div class="popup-panel">
    <header class="popup-head">
      <h2 id="blender-fields-popup-title">Fields</h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <p class="jev-question">Transcribed from the serve surface's <span class="mono">spec.py</span> for the <span class="mono"><%= BlenderConf::OP %></span> operation. A document is an element list plus the optional blocks below — the service builds what it is told and never substitutes a default for a missing field.</p>

      <h3 class="jev-help-h">What each element must carry</h3>
      <p class="jev-note">Seven types — <span class="mono"><%= BlenderConf::ELEMENTS.keys.join(", ") %></span> — and every positional field in the table is required.</p>
      <div class="jev-help">
        <% BlenderConf::ELEMENTS.each do |type, required| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= type %></div>
            <div class="jev-help-v"><span class="mono"><%= required.join(", ") %></span> required</div>
          </div>
        <% end %>
      </div>

      <h3 class="jev-help-h">The blocks beside it</h3>
      <div class="jev-help">
        <div class="jev-help-row">
          <div class="jev-help-k mono"><%= BlenderConf::DOC_KEYS.join(" / ") %></div>
          <div class="jev-help-v">the document itself: an <span class="mono">elements</span> list.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">tiling</div>
          <div class="jev-help-v"><span class="mono"><%= BlenderConf::TILING_FIELDS.join(", ") %></span> — optional; repeats one element across a grid of cells.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">extrude</div>
          <div class="jev-help-v"><span class="mono"><%= BlenderConf::EXTRUDE_FIELDS.join(", ") %></span> — optional; gives the flat geometry depth. Defaults: <%= BlenderConf::EXTRUDE_FIELDS.map { |k| "#{k}=#{BlenderConf::EXTRUDE_DEFAULTS[k]}" }.join(", ") %>.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">render</div>
          <div class="jev-help-v"><span class="mono"><%= BlenderConf::RENDER_FIELDS.join(", ") %></span> — <span class="mono">size</span> is <%= BlenderConf::SIZE_FIELDS.join(" × ") %> (<%= BlenderConf::DEFAULT_SIZE["width"] %> × <%= BlenderConf::DEFAULT_SIZE["height"] %> by default), <span class="mono">views</span> is <%= BlenderConf::DEFAULT_VIEWS %> by default, <span class="mono">background</span> defaults to <span class="mono"><%= BlenderConf::DEFAULT_BACKGROUND %></span> and <span class="mono">engine</span> to <span class="mono"><%= BlenderConf::DEFAULT_ENGINE %></span> (<%= BlenderConf::ENGINES.join(", ") %>).</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">export</div>
          <div class="jev-help-v"><span class="mono"><%= BlenderConf::EXPORT_FIELDS.join(", ") %></span> — optional; writes the mesh beside the frames and names it in the manifest's <span class="mono">glb</span>. Off by default.</div>
        </div>
      </div>

      <h3 class="jev-help-h">What comes back</h3>
      <div class="jev-help">
        <% BlenderConf::RESPONSES.each do |name, why| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= name %></div>
            <div class="jev-help-v"><%= why %></div>
          </div>
        <% end %>
        <div class="jev-help-row">
          <div class="jev-help-k mono"><%= BlenderConf::API[:routes] %></div>
          <div class="jev-help-v">the whole surface this operation is reached by: <%= BlenderConf::ROUTE %> to render, <span class="mono">/files/&lt;name&gt;</span> for the files a manifest names, <span class="mono">/health</span> for whether the service is up at all.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ============ JSON: the generated conf, terminal-ish, like PLOT's ============ %>
<div class="popup" id="blender-conf-popup" role="dialog" aria-modal="true"
     aria-labelledby="blender-conf-popup-title" hidden>
  <div class="popup-panel popup-terminal">
    <header class="popup-head">
      <h2 id="blender-conf-popup-title">blender.conf.json</h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <div class="spec-frame">
        <textarea id="blenderConfOutput" rows="22" class="mono spec-terminal" spellcheck="false"></textarea>
        <button type="button" class="copy-ghost" id="copyBlenderConfBtn"
                title="Copy JSON" aria-label="Copy the blender configuration to the clipboard">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <rect x="8.5" y="8.5" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M6 15.5H5.5A1.5 1.5 0 0 1 4 14V5.5A1.5 1.5 0 0 1 5.5 4H14a1.5 1.5 0 0 1 1.5 1.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/>
          </svg>
        </button>
      </div>
      <p class="blender-conf-status mono" id="blenderConfStatus" role="status"></p>
      <p class="jev-question">A working copy. This page does not run the service and cannot set
        its environment — start it on a host that has Blender, or paste the <span class="mono">env</span>
        block into whatever supervises it.</p>
    </div>
  </div>
</div>

<%# The rules, straight from the model, so the browser does not restate them. %>
<script type="application/json" id="blenderFacts"><%= raw(BlenderConf.facts.to_json) %></script>

<script>
(function () {
  // The form fields are the source of truth and the JSON is a view of them --
  // the same arrangement the JSON, Jev, FLUX and PLOT pages use, for the same
  // reason: the terminal view is what you copy, but the fields are what you edit.
  var FACTS = JSON.parse(document.getElementById('blenderFacts').textContent);
  var out = document.getElementById('blenderConfOutput');
  var status = document.getElementById('blenderConfStatus');

  // A card field, by the data attribute the cards render with.
  function val(name) {
    var el = document.querySelector('[data-blender-field="' + name + '"]');
    return el ? el.value : '';
  }

  // A check field, BY ID: the Checks card deliberately repeats two of the
  // render block's names (views, engine) as controls of its own, so it is read
  // by id rather than by field name -- and only one of them is what the
  // document is checked against.
  function checkVal(name) {
    var el = document.getElementById('f_blender_check_' + name);
    return el ? el.value : '';
  }

  function checkDoc() {
    var raw = checkVal('document');
    if (!raw) return { ok: false, empty: true, error: 'nothing to parse' };
    try {
      return { ok: true, value: JSON.parse(raw) };
    } catch (e) {
      return { ok: false, error: e.message };
    }
  }

  // The contract's rules, in the browser. Their tested twin is
  // BlenderConf.validate in Ruby; this is the same three branches -- a document
  // needs an elements list, views must be a positive whole number, and an
  // engine must be one the spec knows -- read from FACTS rather than restated
  // with an options list in JS.
  function check() {
    var problems = [];
    var notes = [];
    var doc = checkDoc();

    if (!doc.ok) {
      problems.push(doc.empty
        ? "a document is required: an 'elements' list"
        : 'that document is not valid JSON: ' + doc.error);
      return { problems: problems, notes: notes };
    }
    if (!doc.value || typeof doc.value !== 'object' || Array.isArray(doc.value)) {
      problems.push('the document must be a JSON object, got ' + (Array.isArray(doc.value) ? 'an array' : typeof doc.value));
      return { problems: problems, notes: notes };
    }

    var d = doc.value;
    var hasElements = Array.isArray(d.elements);

    if (d.elements !== undefined && !hasElements) {
      problems.push("'elements' must be an array of element objects, got " + typeof d.elements);
    }
    if (!hasElements) {
      problems.push("a document needs an 'elements' list: there is nothing to render");
    }

    var views = checkVal('views');
    if (views !== '' && !/^\d+$/.test(views)) {
      problems.push("'views' must be a whole number, got " + views);
    } else if (/^\d+$/.test(views) && Number(views) < 1) {
      problems.push("'views' must be at least 1, got " + views);
    }

    var engine = checkVal('engine');
    if (engine && FACTS.engines.indexOf(engine) === -1) {
      problems.push("'engine' must be one of " + FACTS.engines.join(', ') + ", got " + engine);
    }

    if (/^\d+$/.test(views) && Number(views) > 1) {
      notes.push('views > 1 answers with a frames manifest (' + FACTS.successManifest + ') rather than one ' +
                 FACTS.successFrame + ' frame — the studio fetches each frame from /files/<name>.');
    }
    if (hasElements && d.elements.length === 0) {
      notes.push("an empty 'elements' list renders an empty scene: legal, and almost never what was meant.");
    }
    if (!problems.length) {
      notes.push("the engine and the size are the document's to set — nothing here ranks the options or recommends one");
    }
    return { problems: problems, notes: notes };
  }

  function build() {
    var env = {};
    ['bind', 'port', 'token', 'runner url', 'runner kind'].forEach(function (k) {
      env[k] = val(k);
    });

    var result = check();
    var doc = checkDoc();

    return {
      service: FACTS.service,
      op: FACTS.op,
      route: FACTS.route,
      env: {
        CHOPSHOP_PLOT_BIND: env['bind'],
        CHOPSHOP_PLOT_PORT: Number(env['port']),
        CHOPSHOP_BLENDER_TOKEN: env['token'] === '' ? null : env['token']
      },
      runner: {
        label: env['runner kind'],
        kind: env['runner kind'],
        url: env['runner url']
      },
      document: doc.ok ? doc.value : null,
      render_defaults: FACTS.defaults,
      responses: {
        frame: FACTS.successFrame,
        manifest: FACTS.successManifest,
        unavailable: FACTS.unavailable
      },
      check: {
        views: checkVal('views'),
        engine: checkVal('engine'),
        problems: result.problems,
        notes: result.notes
      }
    };
  }

  function renderCheck(conf) {
    var verdict = document.getElementById('blenderCheckVerdict');
    var list = document.getElementById('blenderCheckProblems');
    if (!verdict || !list) return;
    var rejected = conf.problems.length > 0;
    verdict.className = 'a ' + (rejected ? 'is-bad' : 'is-ok');
    verdict.textContent = rejected ? 'rejected' : 'accepted';
    verdict.nextElementSibling.textContent = rejected
      ? 'the service would refuse this as a caller error'
      : 'the service would render it';
    list.textContent = '';
    (rejected ? conf.problems : conf.notes).forEach(function (line) {
      var p = document.createElement('p');
      p.className = 'jev-note' + (rejected ? ' is-bad' : '');
      p.textContent = line;
      list.appendChild(p);
    });
  }

  function write() {
    var conf = build();
    if (out) out.value = JSON.stringify(conf, null, 2);
    if (status) {
      var bits = [];
      if (conf.check.problems.length) bits.push(conf.check.problems.length + ' problem(s)');
      if (conf.check.notes.length) bits.push(conf.check.notes.length + ' note(s)');
      status.className = 'blender-conf-status mono ' + (conf.check.problems.length ? 'is-bad' : 'is-ok');
      status.textContent = bits.length
        ? bits.join(', ') + ' — see ' + (conf.check.problems.length ? 'problems' : 'notes') + ' in the JSON'
        : 'valid — ' + out.value.length + ' bytes';
    }
    renderCheck(conf.check);
  }

  document.addEventListener('input', function (e) {
    if (e.target.id === 'blenderConfOutput') { if (status) status.textContent = ''; return; }
    if (e.target.closest('.card[data-blender-card], .card[data-blender-checks]')) write();
  });
  document.addEventListener('change', function (e) {
    if (!e.target.closest('.card[data-blender-card], .card[data-blender-checks]')) return;
    write();
  });

  // JSON opens with the current conf already in the terminal.
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-popup="blender-conf-popup"]')) return;
    write();
  });

  var copyBtn = document.getElementById('copyBlenderConfBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (navigator.clipboard) navigator.clipboard.writeText(out.value);
      copyBtn.classList.add('is-copied');
      setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1200);
    });
  }

  write();
})();
</script>
