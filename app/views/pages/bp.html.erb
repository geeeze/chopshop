<%# ============================================================================
    BP — Blend-Plot: ONE page for ONE service, because the two halves ARE one
    service. The repo behind them was renamed chopshop-plot -> chopshop-bp
    precisely because it hosts both: `plot` draws DOCUMENTS (the geometry spec,
    the metrics digest, the cross-run query engine) and `blend` renders GEOMETRY
    IN 3D. This page is where the old PLOT and BLENDER pages went, so every card,
    every field, every id and every "?" help block from both is here, unchanged,
    in a Plot section and then a Blender section.

    The page head is the house shape, with ONE deliberate difference: the
    FIELDS/JSON reference pair is per HALF and sits in that half's own label row
    (see .bp-half-head), because each half has its own field registry and its own
    generated conf -- a single head pair would have to point at one half's
    popups and leave the other's unreachable. Run Job in row 1 and the blurb
    LAST in the row are exactly as every other page has them.
   ============================================================================ %>
<div class="page-head">
  <%# The JSON page's head arrangement, exactly: Run Job in grid row 1, the blurb
      in row 2 col 1 -- and the blurb LAST in the row, which is what the phone
      media query places by grid-row. %>
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">BP</span> — Blend-Plot</h1>
    <%= link_to "Run Job", new_job_path, class: "btn btn-primary head-action head-action--top" %>
    <p class="page-head-blurb">One service with two halves: the <strong>Plot</strong> half draws documents — the geometry spec, the metric charts and the run records — and the <strong>Blender</strong> half renders geometry in 3D. This page configures both and does neither itself: every request is a request to <span class="mono">chopshop-bp</span>.</p>
  </div>
</div>

<%# ============================================================================
    PLOT — the document half. Its cards render from PlotConf::CARDS and its help
    blocks render from the same fields, so a card's "?" documents that card's
    fields and nothing else by construction.
   ============================================================================ %>
<section class="bp-half bp-half--plot" data-bp-half="plot" aria-labelledby="bpPlotTitle">
  <div class="bp-half-head">
    <h2 class="bp-half-title" id="bpPlotTitle">Plot</h2>
    <span class="tech-tag">draws documents</span>
    <%# A PAIR, like the old page's: FIELDS first because the metric field
        registry is what decides every axis on this page, so it is what you reach
        for when a chart will not draw. JSON second, the generated conf. %>
    <div class="head-action-pair bp-half-actions">
      <button type="button" class="btn btn-secondary head-action" data-popup="plot-fields-popup"
              title="The metric field registry, the element types and the chart shapes"
              aria-label="The metric field registry, the element types and the chart shapes">FIELDS</button>
      <%# TOURNAMENT sits in the PLOT half because a bracket is a DRAWN DOCUMENT —
          the same kind of thing this half produces — and it moved off the nav
          (a reference surface, so the header row does not grow for it). Its body
          is FETCHED on open: the same partial /tournament renders, so the popup
          cannot drift from the page. See loadPopupBody in aether.js. %>
      <button type="button" class="btn btn-secondary head-action"
              data-popup="tournament-popup" data-popup-url="<%= surface_tournament_path %>"
              title="A simulated single-elimination bracket over a candidate set"
              aria-label="A simulated single-elimination bracket over a candidate set">TOURNAMENT</button>
      <button type="button" class="btn btn-secondary head-action" data-popup="plot-conf-popup"
              title="View the generated Plot conf as JSON"
              aria-label="View the generated Plot conf as JSON">JSON</button>
    </div>
  </div>

  <div class="grid-2" style="align-items:stretch;">
    <% PlotConf::CARDS.each do |card| %>
      <div class="card" data-plot-card="<%= card[:title] %>">
        <div class="card-head">
          <h3><%= card[:title] %></h3>
          <button type="button" class="help-btn" data-help-title="<%= card[:title] %>"
                  data-help-target="<%= card[:help] %>"
                  aria-label="Explain <%= card[:title] %>" title="Explain <%= card[:title] %>">?</button>
        </div>
        <p class="jev-question"><%= card[:blurb] %></p>

        <% if card[:title] == "Service" %>
          <%# The runners this deployment actually files as plot runners. The map is
              env-driven, so the page reports the live one rather than the default
              it documents -- and "none configured" is a real answer, not an error:
              the settings below stand on their own. The nav's runner pill is the
              live check; this page never calls the service. %>
          <div class="actions-row" id="plotRunnerRow">
            <span class="status-pill <%= @plot_runners.any? ? "status-pass" : "status-pending" %>"
                  id="plotRunnerPill"><%= @plot_runners.any? ? "#{@plot_runners.size} configured" : "none configured" %></span>
            <span class="tech-tag" id="plotRunnerNote">
              <% if @plot_runners.any? %>
                <%= @plot_runners.map { |label, url| "#{label} → #{url}" }.join(" · ") %>
              <% else %>
                set CHOPSHOP_RUNNER_PLOT_URL, and CHOPSHOP_RUNNER_PLOT_KIND=plot
              <% end %>
            </span>
          </div>
        <% end %>

        <div class="print-grid">
          <% card[:fields].each do |f| %>
            <% id = "f_plot_#{card[:title].downcase}_#{f[:label].to_s.tr(' ', '_')}" %>
            <div class="field">
              <label for="<%= id %>"><%= f[:label] %></label>
              <% case f[:type] %>
              <% when :select %>
                <select id="<%= id %>" data-plot-field="<%= f[:label] %>">
                  <% Array(f[:options]).each do |opt| %>
                    <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
                  <% end %>
                </select>
              <% when :number %>
                <input type="number" id="<%= id %>" data-plot-field="<%= f[:label] %>"
                       value="<%= f[:default] %>"
                       <%= "min=\"#{f[:min]}\"".html_safe if f[:min] %>
                       <%= "max=\"#{f[:max]}\"".html_safe if f[:max] %>>
              <% when :static %>
                <%# A contract fact, not a setting: shown as a value rather than
                    offered as an input that would do nothing. %>
                <div class="mono" id="<%= id %>" data-plot-field="<%= f[:label] %>"><%= f[:default] %></div>
              <% else %>
                <input type="text" id="<%= id %>" data-plot-field="<%= f[:label] %>"
                       class="mono" value="<%= f[:default] %>">
              <% end %>
              <div class="hint"><%= f[:hint] %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ============ Checks: the live contract check, full width ============
      Its own card rather than a panel inside Charts: it answers rather than
      configures, and the answer has a legend of its own. Rendered server-side for
      the default combination first, so the card is correct with JavaScript off and
      only upgrades to live. %>
  <% check_fields = PlotConf::CHECKS[:fields].index_by { |f| f[:label] } %>
  <% initial_check = PlotConf.validate(
       op: check_fields["op"][:default], chart: check_fields["chart"][:default],
       x: check_fields["x"][:default], y: check_fields["y"][:default],
       color: check_fields["color"][:default]) %>
  <div class="card" data-plot-checks="<%= PlotConf::CHECKS[:title] %>">
    <div class="card-head">
      <h3><%= PlotConf::CHECKS[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= PlotConf::CHECKS[:title] %>"
              data-help-target="<%= PlotConf::CHECKS[:help] %>"
              aria-label="Explain <%= PlotConf::CHECKS[:title] %>"
              title="Explain <%= PlotConf::CHECKS[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= PlotConf::CHECKS[:blurb] %></p>

    <div class="print-grid">
      <% PlotConf::CHECKS[:fields].each do |f| %>
        <div class="field">
          <label for="f_plot_check_<%= f[:label] %>"><%= f[:label] %></label>
          <select id="f_plot_check_<%= f[:label] %>" data-plot-field="<%= f[:label] %>">
            <% Array(f[:options]).each do |opt| %>
              <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt.to_s.empty? ? "(none)" : opt %></option>
            <% end %>
          </select>
          <div class="hint"><%= f[:hint] %></div>
        </div>
      <% end %>
    </div>

    <div class="jev-derived" id="plotCheckDerived">
      <p class="jev-derived-label">Derived, as the contract would see it</p>
      <div class="jev-card">
        <div class="a <%= initial_check[:problems].any? ? "is-bad" : "is-ok" %>" id="plotCheckVerdict"><%= initial_check[:problems].any? ? "rejected" : "accepted" %></div>
        <div class="note"><%= initial_check[:problems].any? ? "the service would refuse this as a caller error" : "the service would draw it" %></div>
      </div>
      <%# The service's own sentences, and nothing else: an empty list is the whole
          answer when the combination is accepted. JS refills this element; the
          server-rendered content is the default combination. %>
      <div id="plotCheckProblems">
        <% if initial_check[:problems].any? %>
          <% initial_check[:problems].each do |problem| %>
            <p class="jev-note is-bad"><%= problem %></p>
          <% end %>
        <% else %>
          <% initial_check[:notes].each do |note| %>
            <p class="jev-note"><%= note %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ============ Metrics schema: the foundation, full width ============
      Whatever a chart is drawn from, it is drawn from these fields -- and the rule
      that makes them safe to read is that missing is a state, not a zero. %>
  <div class="card" data-plot-schema="<%= PlotConf::SCHEMA[:title] %>">
    <div class="card-head">
      <h3><%= PlotConf::SCHEMA[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= PlotConf::SCHEMA[:title] %>"
              data-help-target="<%= PlotConf::SCHEMA[:help] %>"
              aria-label="Explain <%= PlotConf::SCHEMA[:title] %>"
              title="Explain <%= PlotConf::SCHEMA[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= PlotConf::SCHEMA[:blurb] %></p>

    <%# The version is one line, so it sits above the grid rather than in a cell of
        it: a one-line block beside a 21-field column leaves that column's whole
        height empty and reads as a broken column. %>
    <dl class="help-notes">
      <dt class="mono">metrics_version</dt>
      <dd><%= PlotConf::METRICS_VERSION %> — a reader refuses a version it does not know.</dd>
    </dl>

    <div class="print-grid">
      <div class="jev-derived">
        <p class="jev-derived-label">Numeric — the selectable axes</p>
        <dl class="help-notes">
          <% PlotConf::NUMERIC_FIELDS.each do |field, gloss| %>
            <dt class="mono"><%= field %></dt>
            <dd><%= gloss %></dd>
          <% end %>
        </dl>
      </div>
      <div class="jev-derived">
        <p class="jev-derived-label">Categorical — colour, filter, group</p>
        <dl class="help-notes">
          <% PlotConf::CATEGORICAL_FIELDS.each do |field, gloss| %>
            <dt class="mono"><%= field %></dt>
            <dd><%= gloss %></dd>
          <% end %>
        </dl>
        <p class="jev-derived-label">Identity — what makes two runs comparable</p>
        <dl class="help-notes">
          <% PlotConf::IDENTITY_FIELDS.each do |field| %>
            <dt class="mono"><%= field %></dt>
            <dd><%= PlotConf::IDENTITY_GLOSS[field] %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>

  <%# The two deployments, and what has to be true of a host for each. Full width
      for the same reason the two cards above are: two columns of shapes and their
      variables need the room, and half a page would make them a footnote. %>
  <div class="card" data-plot-placement="<%= PlotConf::PLACEMENT[:title] %>">
    <div class="card-head">
      <h3><%= PlotConf::PLACEMENT[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= PlotConf::PLACEMENT[:title] %>"
              data-help-target="<%= PlotConf::PLACEMENT[:help] %>"
              aria-label="Explain <%= PlotConf::PLACEMENT[:title] %>"
              title="Explain <%= PlotConf::PLACEMENT[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= PlotConf::PLACEMENT[:blurb] %></p>

    <div class="print-grid">
      <% PlotConf::PLACEMENT[:shapes].each do |name, why, vars| %>
        <div class="jev-derived">
          <p class="jev-derived-label"><%= name %></p>
          <p class="jev-note"><%= why %></p>
          <%# The variables ARE the difference between the two shapes, so they sit
              on the card rather than only behind the help: the variable, then what
              it does. %>
          <dl class="help-notes">
            <% vars.each do |var, gloss| %>
              <dt class="mono"><%= var %></dt>
              <dd><%= gloss %></dd>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  </div>

  <%# ============ the help each "?" reveals ============
      One block per card, built from that card's own fields: the <dt> is the
      field's label and the <dd> its help, so the help cannot document a field the
      card does not have, nor miss one it does. %>
  <% PlotConf::CARDS.each do |card| %>
    <div id="<%= card[:help] %>" hidden>
      <dl class="help-notes">
        <% card[:fields].each do |f| %>
          <dt><%= f[:label] %><% if f[:env] %> <span class="mono">· <%= f[:env] %></span><% end %></dt>
          <dd><%= f[:help] %></dd>
        <% end %>
      </dl>
      <% if card[:title] == "Service" %>
        <%# The combination, said once, on the one card that names the service --
            and said HERE rather than in PlotConf, because the conf's constants are
            the transcription of the service's own config and stay verbatim. The
            ownership clause is one sentence: the operator asked for which repo
            does which job to be legible, not for an essay in a tooltip. %>
        <p class="jev-note">This is the Plot half of <span class="mono">chopshop-bp</span> — one service, two halves: the Blender half below renders 3D on the same port and the same token. bp applies no scoring and keeps no telemetry: the pipeline (<span class="mono">chopshop-svg</span>) computes the ML, and this studio owns the metrics engine and presents the statistics.</p>
      <% end %>
    </div>
  <% end %>

  <%# The Checks, schema and placement cards answer rather than configure, so their
      help documents what the card shows rather than a field list. Same dl
      vocabulary, so they read like the four above. %>
  <div id="<%= PlotConf::CHECKS[:help] %>" hidden>
    <dl class="help-notes">
      <% PlotConf::CHECKS[:fields].each do |f| %>
        <dt><%= f[:label] %></dt>
        <dd><%= f[:help] %></dd>
      <% end %>
    </dl>
  </div>

  <div id="<%= PlotConf::SCHEMA[:help] %>" hidden>
    <dl class="help-notes">
      <% PlotConf::SCHEMA[:entries].each do |label, help| %>
        <dt><%= label %></dt>
        <dd><%= help %></dd>
      <% end %>
    </dl>
    <%# One clause, on the card that shows the schema, because this is the framing
        the repo itself is correcting: metrics_version is the SHAPE of the run
        records the chart operations read, not a scoring engine. %>
    <p class="jev-note"><span class="mono">metrics_version: 1</span> is a shared flat <em>data contract</em> — the shape of the run records the chart operations read — not a scoring engine. bp ranks and scores nothing.</p>
  </div>

  <div id="<%= PlotConf::PLACEMENT[:help] %>" hidden>
    <dl class="help-notes">
      <% PlotConf::PLACEMENT[:entries].each do |label, help| %>
        <dt><%= label %></dt>
        <dd><%= help %></dd>
      <% end %>
    </dl>
  </div>
</section>

<%# ============================================================================
    BLENDER — the 3D half, on the same serve surface the Plot half configures.
    Its cards render from BlenderConf::CARDS with the same help-block pairing.
   ============================================================================ %>
<section class="bp-half bp-half--blender" data-bp-half="blender" aria-labelledby="bpBlenderTitle">
  <div class="bp-half-head">
    <h2 class="bp-half-title" id="bpBlenderTitle">Blender</h2>
    <span class="tech-tag">renders 3D</span>
    <%# A PAIR, like the Plot half's: FIELDS first because the document's vocabulary
        -- the element types, the blocks beside them and the two response shapes --
        is what decides everything on this half, so it is what you reach for when a
        render is refused. JSON second, the generated conf. %>
    <div class="head-action-pair bp-half-actions">
      <button type="button" class="btn btn-secondary head-action" data-popup="blender-fields-popup"
              title="The element types, the document's blocks and the two response shapes"
              aria-label="The element types, the document's blocks and the two response shapes">FIELDS</button>
      <button type="button" class="btn btn-secondary head-action" data-popup="blender-conf-popup"
              title="View the generated Blender conf as JSON"
              aria-label="View the generated Blender conf as JSON">JSON</button>
    </div>
  </div>

  <div class="grid-2" style="align-items:stretch;">
    <% BlenderConf::CARDS.each do |card| %>
      <div class="card" data-blender-card="<%= card[:title] %>">
        <div class="card-head">
          <h3><%= card[:title] %></h3>
          <button type="button" class="help-btn" data-help-title="<%= card[:title] %>"
                  data-help-target="<%= card[:help] %>"
                  aria-label="Explain <%= card[:title] %>" title="Explain <%= card[:title] %>">?</button>
        </div>
        <p class="jev-question"><%= card[:blurb] %></p>

        <% if card[:title] == "Service" %>
          <%# The runners this deployment actually files as blender runners. The map
              is env-driven, so the page reports the live one rather than the default
              it documents -- and "none configured" is a real answer, not an error:
              the settings below stand on their own. The nav's runner pill is the
              live check; this page never calls the service. %>
          <div class="actions-row" id="blenderRunnerRow">
            <span class="status-pill <%= @blender_runners.any? ? "status-pass" : "status-pending" %>"
                  id="blenderRunnerPill"><%= @blender_runners.any? ? "#{@blender_runners.size} configured" : "none configured" %></span>
            <span class="tech-tag" id="blenderRunnerNote">
              <% if @blender_runners.any? %>
                <%= @blender_runners.map { |label, url| "#{label} → #{url}" }.join(" · ") %>
              <% else %>
                set CHOPSHOP_RUNNER_BLENDER_URL, and CHOPSHOP_RUNNER_BLENDER_KIND=blender
              <% end %>
            </span>
          </div>
        <% end %>

        <div class="print-grid">
          <% card[:fields].each do |f| %>
            <% id = "f_blender_#{card[:title].downcase}_#{f[:label].to_s.tr(' ', '_')}" %>
            <div class="field">
              <label for="<%= id %>"><%= f[:label] %></label>
              <% case f[:type] %>
              <% when :select %>
                <select id="<%= id %>" data-blender-field="<%= f[:label] %>">
                  <% Array(f[:options]).each do |opt| %>
                    <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
                  <% end %>
                </select>
              <% when :number %>
                <input type="number" id="<%= id %>" data-blender-field="<%= f[:label] %>"
                       value="<%= f[:default] %>"
                       <%= "min=\"#{f[:min]}\"".html_safe if f[:min] %>
                       <%= "max=\"#{f[:max]}\"".html_safe if f[:max] %>>
              <% when :static %>
                <%# A contract fact, not a setting: shown as a value rather than
                    offered as an input that would do nothing. %>
                <div class="mono" id="<%= id %>" data-blender-field="<%= f[:label] %>"><%= f[:default] %></div>
              <% else %>
                <input type="text" id="<%= id %>" data-blender-field="<%= f[:label] %>"
                       class="mono" value="<%= f[:default] %>">
              <% end %>
              <div class="hint"><%= f[:hint] %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ============ Checks: the live contract check, full width ============
      Its own card rather than a panel inside Scene or Render: it answers rather
      than configures. The document is pasted here and checked against the
      contract's own rules, and the answer is rendered server-side first so the
      card is correct with JavaScript off. %>
  <% check_fields = BlenderConf::CHECKS[:fields].index_by { |f| f[:label] } %>
  <%# The whole document is handed to the validator, not just its `elements`:
      an empty list is legal only when the document carries a `tiling` block,
      and the validator cannot know that from the list alone. %>
  <% initial_check = BlenderConf.validate(
       document: check_fields["document"][:default],
       elements: check_fields["document"][:default]["elements"],
       views: check_fields["views"][:default],
       engine: check_fields["engine"][:default]) %>
  <div class="card" data-blender-checks="<%= BlenderConf::CHECKS[:title] %>">
    <div class="card-head">
      <h3><%= BlenderConf::CHECKS[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= BlenderConf::CHECKS[:title] %>"
              data-help-target="<%= BlenderConf::CHECKS[:help] %>"
              aria-label="Explain <%= BlenderConf::CHECKS[:title] %>"
              title="Explain <%= BlenderConf::CHECKS[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= BlenderConf::CHECKS[:blurb] %></p>

    <div class="field">
      <label for="f_blender_check_document">document <span class="mono">(JSON)</span></label>
      <textarea id="f_blender_check_document" class="mono blender-doc" rows="12"
                spellcheck="false" autocomplete="off"
                data-blender-check="document"><%= JSON.pretty_generate(check_fields["document"][:default]) %></textarea>
      <div class="hint"><%= check_fields["document"][:hint] %></div>
    </div>

    <div class="print-grid">
      <% ["views", "engine"].each do |label| %>
        <% f = check_fields[label] %>
        <div class="field">
          <label for="f_blender_check_<%= label %>"><%= label %></label>
          <select id="f_blender_check_<%= label %>" data-blender-check="<%= label %>">
            <% Array(f[:options]).each do |opt| %>
              <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
            <% end %>
          </select>
          <div class="hint"><%= f[:hint] %></div>
        </div>
      <% end %>
    </div>

    <div class="jev-derived" id="blenderCheckDerived">
      <p class="jev-derived-label">Derived, as the contract would see it</p>
      <div class="jev-card">
        <div class="a <%= initial_check[:problems].any? ? "is-bad" : "is-ok" %>" id="blenderCheckVerdict"><%= initial_check[:problems].any? ? "rejected" : "accepted" %></div>
        <div class="note"><%= initial_check[:problems].any? ? "the service would refuse this as a caller error" : "the service would render it" %></div>
      </div>
      <%# The service's own sentences, and nothing else: an empty problem list is
          the whole answer when the document is accepted. JS refills this element;
          the server-rendered content is the example document above. %>
      <div id="blenderCheckProblems">
        <% if initial_check[:problems].any? %>
          <% initial_check[:problems].each do |problem| %>
            <p class="jev-note is-bad"><%= problem %></p>
          <% end %>
        <% else %>
          <% initial_check[:notes].each do |note| %>
            <p class="jev-note"><%= note %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# ============ Responses: the two success shapes and the one state ============
      What every caller branches on, so it is a card of its own rather than a
      sentence inside another one. %>
  <div class="card" data-blender-shapes="<%= BlenderConf::SHAPES[:title] %>">
    <div class="card-head">
      <h3><%= BlenderConf::SHAPES[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= BlenderConf::SHAPES[:title] %>"
              data-help-target="<%= BlenderConf::SHAPES[:help] %>"
              aria-label="Explain <%= BlenderConf::SHAPES[:title] %>"
              title="Explain <%= BlenderConf::SHAPES[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= BlenderConf::SHAPES[:blurb] %></p>

    <div class="print-grid">
      <% BlenderConf::RESPONSES.each do |name, why| %>
        <div class="jev-derived">
          <p class="jev-derived-label mono"><%= name %></p>
          <p class="jev-note"><%= why %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# The two deployments, and what has to be true of a host for each. Full width
      for the same reason the cards above are: two columns of shapes and their
      variables need the room, and half a page would make them a footnote. %>
  <div class="card" data-blender-placement="<%= BlenderConf::PLACEMENT[:title] %>">
    <div class="card-head">
      <h3><%= BlenderConf::PLACEMENT[:title] %></h3>
      <button type="button" class="help-btn" data-help-title="<%= BlenderConf::PLACEMENT[:title] %>"
              data-help-target="<%= BlenderConf::PLACEMENT[:help] %>"
              aria-label="Explain <%= BlenderConf::PLACEMENT[:title] %>"
              title="Explain <%= BlenderConf::PLACEMENT[:title] %>">?</button>
    </div>
    <p class="jev-question"><%= BlenderConf::PLACEMENT[:blurb] %></p>

    <div class="print-grid">
      <% BlenderConf::PLACEMENT[:shapes].each do |name, why, vars| %>
        <div class="jev-derived">
          <p class="jev-derived-label"><%= name %></p>
          <p class="jev-note"><%= why %></p>
          <%# The variables ARE the difference between the two shapes, so they sit
              on the card rather than only behind the help: the variable, then what
              it does. %>
          <dl class="help-notes">
            <% vars.each do |var, gloss| %>
              <dt class="mono"><%= var %></dt>
              <dd><%= gloss %></dd>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  </div>

  <%# ============ the help each "?" reveals ============
      One block per card, built from that card's own fields: the <dt> is the
      field's label and the <dd> its help, so the help cannot document a field the
      card does not have, nor miss one it does. %>
  <% BlenderConf::CARDS.each do |card| %>
    <div id="<%= card[:help] %>" hidden>
      <dl class="help-notes">
        <% card[:fields].each do |f| %>
          <dt><%= f[:label] %><% if f[:env] %> <span class="mono">· <%= f[:env] %></span><% end %></dt>
          <dd><%= f[:help] %></dd>
        <% end %>
      </dl>
      <% if card[:title] == "Service" %>
        <%# The combination, said once, on the one card that names the service --
            and said HERE rather than in BlenderConf, because the conf's constants
            are the transcription of the service's own spec and stay verbatim. The
            ownership clause is one sentence, matching the Plot half's. %>
        <p class="jev-note">This is the Blender half of <span class="mono">chopshop-bp</span> — one service, two halves: the Plot half above draws documents on the same port and the same token. bp applies no scoring and keeps no telemetry: the pipeline (<span class="mono">chopshop-svg</span>) computes the ML, and this studio owns the metrics engine and presents the statistics.</p>
      <% end %>
    </div>
  <% end %>

  <%# The Checks, responses and placement cards answer rather than configure, so
      their help documents what the card shows rather than a field list. Same dl
      vocabulary, so they read like the four above. %>
  <div id="<%= BlenderConf::CHECKS[:help] %>" hidden>
    <dl class="help-notes">
      <% BlenderConf::CHECKS[:fields].each do |f| %>
        <dt><%= f[:label] %></dt>
        <dd><%= f[:help] %></dd>
      <% end %>
    </dl>
  </div>

  <div id="<%= BlenderConf::SHAPES[:help] %>" hidden>
    <dl class="help-notes">
      <% BlenderConf::RESPONSES.each do |name, why| %>
        <dt><%= name %></dt>
        <dd><%= why %></dd>
      <% end %>
    </dl>
  </div>

  <div id="<%= BlenderConf::PLACEMENT[:help] %>" hidden>
    <dl class="help-notes">
      <% BlenderConf::PLACEMENT[:entries].each do |label, help| %>
        <dt><%= label %></dt>
        <dd><%= help %></dd>
      <% end %>
    </dl>
  </div>
</section>

<%# ============================================================================
    JOB SPEC EXAMPLES -- one per operation, in the shape the STUDIO posts.

    This section exists because the rest of the page documents the SERVICE and
    the thing an operator actually submits was missing from all of it. The two
    JSON popups below emit a *conf* (env, runners, operations), which is not a
    job spec: pasted into Run Job it is refused by
    `Job#bp_job_needs_an_op_and_a_document`. Before this, /bp carried a document
    example for exactly one operation.

    Every spec here is `spec.bp` verbatim -- the whole value you paste into
    job[spec] -- and every `doc` is copied from chopshop-bp's own
    `examples/*.json`, which its validators accept. The provenance line names
    the file, so a reader can go and re-verify when the service changes. That
    matters: hand-written plausible-looking specs are what an earlier smoke test
    tried, and the service refused them in three separate ways.
    ============================================================================ %>
<section class="bp-examples" aria-labelledby="bpExamplesTitle">
  <h2 id="bpExamplesTitle">Job specs, one per operation</h2>
  <p class="bp-examples-blurb">
    Each block below is the complete <code>job[spec]</code> value for a BP run on
    the <code>bp</code> runner: paste it as-is. They come from the service's own
    example files rather than from taste, and the studio files every one of them
    unchanged. The plain pipeline trace is at the end, for contrast — an svg
    job's spec <em>is</em> the top level, with no wrapper block.
  </p>

  <% BpExamples::ALL.each do |entry| %>
    <% half_label = entry[:half] == "blender" ? "Blender half" : "Plot half" %>
    <div class="card bp-example" data-bp-example-op="<%= entry[:op] %>"
         data-bp-example-half="<%= entry[:half] %>">
      <div class="card-head">
        <h3><%= entry[:title] %> <span class="mono bp-example-op">op: <%= entry[:op] %></span></h3>
        <span class="tech-tag"><%= half_label %></span>
      </div>
      <p class="bp-example-what"><%= entry[:what] %></p>
      <div class="actions-row">
        <button type="button" class="btn btn-secondary bp-example-copy"
                data-bp-example-copy="<%= entry[:op] %>"
                title="Copy this spec to the clipboard"
                aria-label="Copy the <%= entry[:op] %> job spec">Copy spec</button>
        <span class="tech-tag bp-example-source">from <%= entry[:source] %></span>
      </div>
      <% if entry[:runs_note] %>
        <p class="bp-example-note"><strong>needs <code>runs</code>:</strong> <%= entry[:runs_note] %>.
           An empty <code>runs</code> is refused — the operation draws across the
           records it is given, so there is nothing to draw without them.</p>
      <% end %>
      <script type="application/json" class="bp-example-json" data-bp-example-json="<%= entry[:op] %>"><%== BpExamples.job_spec_json(entry[:op]) %></script>
    </div>
  <% end %>

  <div class="card bp-example" data-bp-example-op="trace" data-bp-example-half="pipeline">
    <div class="card-head">
      <h3>Pipeline trace <span class="mono bp-example-op">an svg job</span></h3>
      <span class="tech-tag">for contrast</span>
    </div>
    <p class="bp-example-what"><%= BpExamples::TRACE_NOTE %></p>
    <div class="actions-row">
      <button type="button" class="btn btn-secondary bp-example-copy"
              data-bp-example-copy="trace"
              title="Copy this spec to the clipboard"
              aria-label="Copy the trace job spec">Copy spec</button>
      <span class="tech-tag bp-example-source">from docs/agent-api.md</span>
    </div>
    <script type="application/json" class="bp-example-json" data-bp-example-json="trace"><%== JSON.pretty_generate(BpExamples::TRACE) %></script>
  </div>
</section>

<script>
  // #bp-examples-copy: one delegated click handler for every "Copy spec" button.
  // Delegated from document, like the rest of the page's wiring, so the buttons
  // need no per-element binding and the handler survives any body swap.
  //
  // The spec is read from the page's own <script type="application/json">
  // rather than kept in a JS constant beside it. Two copies of the same spec in
  // one page is exactly the drift the jobs-index partials exist to avoid, and
  // JSON.parse of the server-rendered text cannot disagree with what the page
  // is showing.
  (function () {
    if (window.__csBpExamples) return;
    window.__csBpExamples = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-bp-example-copy]');
      if (!btn) return;
      e.preventDefault();
      var op = btn.dataset.bpExampleCopy;
      var block = document.querySelector('script[data-bp-example-json="' + op + '"]');
      if (!block) return;
      var text = block.textContent;
      var done = function () {
        var old = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = old; }, 1400);
      };
      // navigator.clipboard needs a secure context; loopback http is not one, so
      // the execCommand path is the fallback that actually works here rather
      // than a branch that silently does nothing.
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(done, function () { legacy(text, done); });
      } else {
        legacy(text, done);
      }
    });
    function legacy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (e) { /* nothing to do */ }
      document.body.removeChild(ta);
    }
  })();
</script>

