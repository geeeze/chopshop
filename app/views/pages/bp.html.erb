<%# The rules, straight from the models, so the browser does not restate them.
    Two scripts, one per half, in the order the halves appear. %>
<script type="application/json" id="plotFacts"><%= raw(PlotConf.facts.to_json) %></script>
<script type="application/json" id="blenderFacts"><%= raw(BlenderConf.facts.to_json) %></script>

<script>
(function () {
  // The form fields are the source of truth and the JSON is a view of them --
  // the same arrangement the JSON, Jev and FLUX pages use, for the same reason:
  // the terminal view is what you copy, but the fields are what you edit.
  var FACTS = JSON.parse(document.getElementById('plotFacts').textContent);
  var out = document.getElementById('plotConfOutput');
  var status = document.getElementById('plotConfStatus');

  function val(name) {
    var el = document.querySelector('[data-plot-field="' + name + '"]');
    return el ? el.value : '';
  }

  // The contract's rules, in the browser. Their tested twin is
  // PlotConf.validate in Ruby; this is the same two branches -- a chart belongs
  // to its own operation, and an axis must be a numeric metric field -- read
  // from FACTS rather than restated with a field list in JS.
  function check(op, chart, x, y, color) {
    var problems = [];
    var notes = [];
    var digestCharts = FACTS.digestCharts, queryCharts = FACTS.queryCharts;

    // Which operation takes chart axes at all, and which query charts take two
    // of them, both come from FACTS rather than from a literal in here: the
    // model is the source, and this is only the shape of the answer.
    if (FACTS.axisOps.indexOf(op) === -1) {
      // The operations that take a document of their own rather than a chart.
      // Their descriptions come from the model (FACTS.opSpecs, built from the
      // Ruby conf's OPERATIONS array), so a new operation cannot be described
      // here by a sentence this file invented.
      var spec = FACTS.opSpecs[op];
      notes.push(spec
        ? op + ' takes no chart: it takes ' + spec.takes + ' and draws ' + spec.draws + '.'
        : op + ' takes no chart: it takes a document of its own and draws it directly.');
      return { problems: problems, notes: notes };
    }
    if (digestCharts.indexOf(chart) === -1 && queryCharts.indexOf(chart) === -1) {
      problems.push("'chart' must be one of " + digestCharts.join(', ') + ' for digest or ' +
                    queryCharts.join(', ') + ' for query, got ' + chart);
      return { problems: problems, notes: notes };
    }
    if (op === 'digest' && digestCharts.indexOf(chart) === -1) {
      problems.push(chart + ' is a query chart: the digest operation reads one run\'s numbers and knows ' +
                    digestCharts.join(', ') + ' only.');
      return { problems: problems, notes: notes };
    }
    if (op === 'query' && queryCharts.indexOf(chart) === -1) {
      problems.push(chart + ' is a digest chart: the query operation reads run records and knows ' +
                    queryCharts.join(', ') + ' only.');
      return { problems: problems, notes: notes };
    }
    if (FACTS.queryAxisCharts.indexOf(chart) !== -1) {
      [['x', x], ['y', y]].forEach(function (pair) {
        if (!pair[1]) { problems.push(chart + ': ' + pair[0] + ' is required'); }
        else if (FACTS.numericFields.indexOf(pair[1]) === -1) {
          problems.push(chart + ': axis ' + "'" + pair[1] + "'" + ' is not a numeric metric field');
        }
      });
      if (color && FACTS.categoricalFields.indexOf(color) === -1) {
        problems.push(chart + ": 'color' must be a categorical field");
      }
    }
    if (!problems.length) {
      notes.push("the axis is the user's choice — nothing here ranks the fields or recommends one");
    }
    return { problems: problems, notes: notes };
  }

  function build() {
    var env = {};
    ['bind', 'port', 'token', 'runner url', 'runner kind'].forEach(function (k) {
      env[k] = val(k);
    });

    var result = check(val('op'), val('chart'), val('x'), val('y'), val('color'));

    return {
      service: FACTS.service,
      env: {
        CHOPSHOP_BP_BIND: env['bind'],
        CHOPSHOP_BP_PORT: Number(env['port']),
        CHOPSHOP_BP_TOKEN: env['token'] === '' ? null : env['token']
      },
      runner: {
        label: env['runner kind'],
        kind: env['runner kind'],
        url: env['runner url']
      },
      operations: FACTS.operations,
      metrics_version: FACTS.metricsVersion,
      charts: { digest: FACTS.digestCharts, query: FACTS.queryCharts },
      check: {
        op: val('op'), chart: val('chart'),
        x: val('x'), y: val('y'), color: val('color') || null
      },
      problems: result.problems,
      notes: result.notes
    };
  }

  function renderCheck(conf) {
    var verdict = document.getElementById('plotCheckVerdict');
    var list = document.getElementById('plotCheckProblems');
    if (!verdict || !list) return;
    var rejected = conf.problems.length > 0;
    verdict.className = 'a ' + (rejected ? 'is-bad' : 'is-ok');
    verdict.textContent = rejected ? 'rejected' : 'accepted';
    verdict.nextElementSibling.textContent = rejected
      ? 'the service would refuse this as a caller error'
      : 'the service would draw it';
    list.textContent = '';
    (rejected ? conf.problems : conf.notes).forEach(function (line) {
      var p = document.createElement('p');
      p.className = 'jev-note' + (rejected ? ' is-bad' : '');
      p.textContent = line;
      list.appendChild(p);
    });
  }

  function write() {
    var conf = build();
    if (out) out.value = JSON.stringify(conf, null, 2);
    if (status) {
      var bits = [];
      if (conf.problems.length) bits.push(conf.problems.length + ' problem(s)');
      if (conf.notes.length) bits.push(conf.notes.length + ' note(s)');
      status.className = 'plot-conf-status mono ' + (conf.problems.length ? 'is-bad' : 'is-ok');
      status.textContent = bits.length
        ? bits.join(', ') + ' — see ' + (conf.problems.length ? 'problems' : 'notes') + ' in the JSON'
        : 'valid — ' + out.value.length + ' bytes';
    }
    renderCheck(conf);
  }

  document.addEventListener('input', function (e) {
    if (e.target.id === 'plotConfOutput') { if (status) status.textContent = ''; return; }
    if (e.target.closest('.card[data-plot-card], .card[data-plot-checks]')) write();
  });
  document.addEventListener('change', function (e) {
    if (!e.target.closest('.card[data-plot-card], .card[data-plot-checks]')) return;
    write();
  });

  // JSON opens with the current conf already in the terminal.
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-popup="plot-conf-popup"]')) return;
    write();
  });

  var copyBtn = document.getElementById('copyPlotConfBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (navigator.clipboard) navigator.clipboard.writeText(out.value);
      copyBtn.classList.add('is-copied');
      setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1200);
    });
  }

  write();
})();
</script>

<script>
(function () {
  // The form fields are the source of truth and the JSON is a view of them --
  // the same arrangement the JSON, Jev, FLUX and Plot halves use, for the same
  // reason: the terminal view is what you copy, but the fields are what you edit.
  var FACTS = JSON.parse(document.getElementById('blenderFacts').textContent);
  var out = document.getElementById('blenderConfOutput');
  var status = document.getElementById('blenderConfStatus');

  // A card field, by the data attribute the cards render with.
  function val(name) {
    var el = document.querySelector('[data-blender-field="' + name + '"]');
    return el ? el.value : '';
  }

  // A check field, BY ID: the Checks card deliberately repeats two of the
  // render block's names (views, engine) as controls of its own, so it is read
  // by id rather than by field name -- and only one of them is what the
  // document is checked against.
  function checkVal(name) {
    var el = document.getElementById('f_blender_check_' + name);
    return el ? el.value : '';
  }

  function checkDoc() {
    var raw = checkVal('document');
    if (!raw) return { ok: false, empty: true, error: 'nothing to parse' };
    try {
      return { ok: true, value: JSON.parse(raw) };
    } catch (e) {
      return { ok: false, error: e.message };
    }
  }

  // The contract's rules, in the browser. Their tested twin is
  // BlenderConf.validate in Ruby; this is the same three branches -- a document
  // needs an elements list, views must be a positive whole number, and an
  // engine must be one the spec knows -- read from FACTS rather than restated
  // with an options list in JS.
  function check() {
    var problems = [];
    var notes = [];
    var doc = checkDoc();

    if (!doc.ok) {
      problems.push(doc.empty
        ? "a document is required: an 'elements' list"
        : 'that document is not valid JSON: ' + doc.error);
      return { problems: problems, notes: notes };
    }
    if (!doc.value || typeof doc.value !== 'object' || Array.isArray(doc.value)) {
      problems.push('the document must be a JSON object, got ' + (Array.isArray(doc.value) ? 'an array' : typeof doc.value));
      return { problems: problems, notes: notes };
    }

    var d = doc.value;
    var hasElements = Array.isArray(d.elements);

    if (d.elements !== undefined && !hasElements) {
      problems.push("'elements' must be an array of element objects, got " + typeof d.elements);
    }
    if (!hasElements) {
      problems.push("a document needs an 'elements' list: there is nothing to render");
    }

    var views = checkVal('views');
    if (views !== '' && !/^\d+$/.test(views)) {
      problems.push("'views' must be a whole number, got " + views);
    } else if (/^\d+$/.test(views) && Number(views) < 1) {
      problems.push("'views' must be at least 1, got " + views);
    }

    var engine = checkVal('engine');
    if (engine && FACTS.engines.indexOf(engine) === -1) {
      problems.push("'engine' must be one of " + FACTS.engines.join(', ') + ", got " + engine);
    }

    if (/^\d+$/.test(views) && Number(views) > 1) {
      notes.push('views > 1 answers with a frames manifest (' + FACTS.successManifest + ') rather than one ' +
                 FACTS.successFrame + ' frame — the studio fetches each frame from /files/<name>.');
    }
    // An empty `elements` list is NOT legal on its own: chopshop-bp raises
    // "nothing to render -- 'elements' is empty and there is no 'tiling'"
    // (chopshop_bp/blender.py:241-243) and answers 400 invalid_spec. The
    // one case it renders is with a `tiling` block, because the tiling is then
    // the geometry the scene repeats. Same rule as BlenderConf.validate, which
    // is the tested twin of this function -- both read the DOCUMENT, not the
    // list alone, precisely so the tiling is visible.
    if (hasElements && d.elements.length === 0) {
      if (d.tiling && typeof d.tiling === 'object' && !Array.isArray(d.tiling)) {
        notes.push("an empty 'elements' list is legal HERE because the document carries a 'tiling' block -- the tiling is the geometry the scene repeats, and 'elements' only adds to it.");
      } else {
        problems.push("an empty 'elements' list renders nothing: the service refuses it unless the document carries a 'tiling' block, which would be the geometry instead");
      }
    }
    if (!problems.length) {
      notes.push("the engine and the size are the document's to set — nothing here ranks the options or recommends one");
    }
    return { problems: problems, notes: notes };
  }

  function build() {
    var env = {};
    ['bind', 'port', 'token', 'runner url', 'runner kind'].forEach(function (k) {
      env[k] = val(k);
    });

    var result = check();
    var doc = checkDoc();

    return {
      service: FACTS.service,
      op: FACTS.op,
      route: FACTS.route,
      env: {
        CHOPSHOP_BP_BIND: env['bind'],
        CHOPSHOP_BP_PORT: Number(env['port']),
        // ONE service, ONE token, and it is the PLOT one: chopshop-bp reads
        // CHOPSHOP_BP_TOKEN and nothing else (chopshop_bp/config.py:70-77).
        // This used to say CHOPSHOP_BLENDER_TOKEN, a name that exists nowhere
        // in the service -- so following the generated conf on a token-
        // protected deployment sent a bearer the service had never seen and
        // every render answered 401. The Blender half shares the Plot half's
        // token because it is the same server.
        CHOPSHOP_BP_TOKEN: env['token'] === '' ? null : env['token']
      },
      runner: {
        label: env['runner kind'],
        kind: env['runner kind'],
        url: env['runner url']
      },
      document: doc.ok ? doc.value : null,
      render_defaults: FACTS.defaults,
      responses: {
        frame: FACTS.successFrame,
        manifest: FACTS.successManifest,
        unavailable: FACTS.unavailable
      },
      check: {
        views: checkVal('views'),
        engine: checkVal('engine'),
        problems: result.problems,
        notes: result.notes
      }
    };
  }

  function renderCheck(conf) {
    var verdict = document.getElementById('blenderCheckVerdict');
    var list = document.getElementById('blenderCheckProblems');
    if (!verdict || !list) return;
    var rejected = conf.problems.length > 0;
    verdict.className = 'a ' + (rejected ? 'is-bad' : 'is-ok');
    verdict.textContent = rejected ? 'rejected' : 'accepted';
    verdict.nextElementSibling.textContent = rejected
      ? 'the service would refuse this as a caller error'
      : 'the service would render it';
    list.textContent = '';
    (rejected ? conf.problems : conf.notes).forEach(function (line) {
      var p = document.createElement('p');
      p.className = 'jev-note' + (rejected ? ' is-bad' : '');
      p.textContent = line;
      list.appendChild(p);
    });
  }

  function write() {
    var conf = build();
    if (out) out.value = JSON.stringify(conf, null, 2);
    if (status) {
      var bits = [];
      if (conf.check.problems.length) bits.push(conf.check.problems.length + ' problem(s)');
      if (conf.check.notes.length) bits.push(conf.check.notes.length + ' note(s)');
      status.className = 'blender-conf-status mono ' + (conf.check.problems.length ? 'is-bad' : 'is-ok');
      status.textContent = bits.length
        ? bits.join(', ') + ' — see ' + (conf.check.problems.length ? 'problems' : 'notes') + ' in the JSON'
        : 'valid — ' + out.value.length + ' bytes';
    }
    renderCheck(conf.check);
  }

  document.addEventListener('input', function (e) {
    if (e.target.id === 'blenderConfOutput') { if (status) status.textContent = ''; return; }
    if (e.target.closest('.card[data-blender-card], .card[data-blender-checks]')) write();
  });
  document.addEventListener('change', function (e) {
    if (!e.target.closest('.card[data-blender-card], .card[data-blender-checks]')) return;
    write();
  });

  // JSON opens with the current conf already in the terminal.
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-popup="blender-conf-popup"]')) return;
    write();
  });

  var copyBtn = document.getElementById('copyBlenderConfBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (navigator.clipboard) navigator.clipboard.writeText(out.value);
      copyBtn.classList.add('is-copied');
      setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1200);
    });
  }

  write();
})();
</script>
