<div class="page-head">
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">JSON</span> — spec builder</h1>
    <%# Three siblings in a 2x2 grid, NOT a flex row with a button column on the
        right. As a column, `align-items: center` centred the COLUMN (77px tall)
        in the row, so the title sank ~10px and the Run Job button -- the
        column's top item -- rode up with it. That is why the button sat high
        here and mid-line on the Jobs and Run Job pages, which have no column
        to centre. Putting the title and Run Job in grid row 1 makes them
        centre against each other exactly as they do there, with JSON below. %>
    <button type="button" class="btn btn-primary head-action" id="useSpecBtn"
            title="Run Job" aria-label="Run Job">Run Job</button>
    <button type="button" class="btn btn-secondary head-action" data-popup="spec-popup"
            title="View and edit the generated job-contract JSON"
            aria-label="View and edit the generated job-contract JSON">JSON</button>
    <p class="page-head-blurb">Every job runs against a contract: colour budget, geometry limits, tolerances, sweep caps. Every key is optional — anything you leave out falls back to the pipeline's default.</p>
  </div>
</div>

<div class="grid-2" style="align-items:stretch;">
  <div class="card">
    <div class="card-head">
      <h3>Job Spec</h3>
      <button type="button" class="help-btn" data-help-title="Job Spec" data-help-target="help-job-spec" aria-label="Explain Job Spec" title="Explain Job Spec">?</button>
    </div>

    <div class="print-grid">
      <div class="field">
        <label>print_method</label>
        <select id="f_print_method">
          <option value="">(default — none)</option>
          <option value="screen_print" selected>screen_print</option>
          <option value="dtg">dtg</option>
          <option value="vinyl">vinyl</option>
        </select>
        <div class="hint">How the job is produced.</div>
      </div>

      <div class="field">
        <label>min_stroke_width_pt</label>
        <input type="number" id="f_min_stroke" min="0" step="0.1" value="1.5">
        <div class="hint">Thinner strokes are a hard finding.</div>
      </div>

      <div class="field">
        <label>max_nodes_per_path</label>
        <input type="number" id="f_max_nodes" min="1" value="500">
        <div class="hint">Node cap per path — trace weight / RIP load.</div>
      </div>

      <div class="field">
        <label>allow_raster_embed</label>
        <select id="f_raster_embed"><option value="false" selected>false</option><option value="true">true</option></select>
        <div class="hint">Allow &lt;image&gt; raster embeds inside the SVG.</div>
      </div>

      <div class="field">
        <label>allow_gradients</label>
        <select id="f_gradients"><option value="false" selected>false</option><option value="true">true</option></select>
        <div class="hint">Allow gradients / continuous tone.</div>
      </div>

      <div class="field">
        <label>allow_open_paths</label>
        <select id="f_open_paths"><option value="true" selected>true</option><option value="false">false</option></select>
        <div class="hint">Allow unclosed paths.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <h3>Print &amp; tolerances</h3>
      <button type="button" class="help-btn" data-help-title="Print &amp; tolerances" data-help-target="help-print" aria-label="Explain Print & tolerances" title="Explain Print & tolerances">?</button>
    </div>

    <div class="print-grid">
      <div class="field">
        <label>dpi</label>
        <input type="number" id="f_dpi" min="72" value="300">
        <div class="hint">Render / measurement DPI.</div>
      </div>

      <div class="field">
        <label>ink_limit_percent (TAC)</label>
        <input type="number" id="f_ink_limit" min="100" max="400" value="300">
        <div class="hint">Total area coverage cap.</div>
      </div>

      <div class="field">
        <label>count_white_as_ink</label>
        <select id="f_white_ink"><option value="true" selected>true</option><option value="false">false</option></select>
        <div class="hint">Count pure white as an ink.</div>
      </div>

      <div class="field">
        <label>ink_merge_tolerance</label>
        <input type="number" id="f_ink_merge" min="0" max="441" value="20">
        <div class="hint">Merge colours closer than this (sRGB).</div>
      </div>

    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <h3>Sweep</h3>
      <button type="button" class="help-btn" data-help-title="Sweep" data-help-target="help-sweep" aria-label="Explain Sweep" title="Explain Sweep">?</button>
    </div>

    <div class="print-grid">
      <div class="field">
        <label>presets</label>
        <div class="check-row">
          <label class="check"><input type="checkbox" id="f_preset_bw" checked> <span>bw</span></label>
          <label class="check"><input type="checkbox" id="f_preset_poster" checked> <span>poster</span></label>
          <label class="check"><input type="checkbox" id="f_preset_photo" checked> <span>photo</span></label>
        </div>
        <div class="hint">VTracer parameter sets. photo needs allow_gradients on.</div>
      </div>

      <div class="field">
        <label>max_candidates</label>
        <input type="number" id="f_sweep_max" min="1" max="24" value="12">
        <div class="hint">Candidate cap per job.</div>
      </div>

      <div class="field">
        <label>filter_speckle</label>
        <input type="text" id="f_speckle" class="mono" value="2, 8, 16" spellcheck="false" autocomplete="off">
        <div class="hint">Comma-separated speckle sizes, in px.</div>
      </div>

      <div class="field">
        <label>hierarchical</label>
        <div class="check-row">
          <label class="check"><input type="checkbox" id="f_hier_cutout" checked> <span>cutout</span></label>
          <label class="check"><input type="checkbox" id="f_hier_stacked" checked> <span>stacked</span></label>
        </div>
        <div class="hint">Layer stacking modes to sweep.</div>
      </div>

      <div class="field">
        <label>use_palette</label>
        <select id="f_use_palette">
          <option value="both" selected>both</option>
          <option value="off">off only</option>
          <option value="on">palette only</option>
        </select>
        <div class="hint">Whether a candidate is pre-quantised to the palette.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <h3>Colour Spec</h3>
      <button type="button" class="help-btn" data-help-title="Colour Spec" data-help-target="help-colour-spec" aria-label="Explain Colour Spec" title="Explain Colour Spec">?</button>
    </div>

    <%# Row 1 — pitch_shift and background_hex share the full card width. %>
    <div class="colour-set-row colour-set-row-2">
      <div class="field">
        <label>pitch_shift</label>
        <select id="f_pitch_shift">
          <option value="false" selected>off</option>
          <option value="true">on</option>
        </select>
        <div class="hint">on — palette recolours the source.</div>
      </div>

      <div class="field">
        <label>background_hex</label>
        <div class="pal-picker">
          <span class="pal-swatch-lg" id="f_bg_swatch" style="background:#ffffff" aria-hidden="true"></span>
          <input type="text" id="f_bg_hex" value="#ffffff" class="mono" spellcheck="false" autocomplete="off" aria-label="Print background hex">
        </div>
        <div class="hint">Alpha flattens onto this before tracing.</div>
      </div>
    </div>

    <%# Lower half as an explicit 2x3 grid, so the two bottom controls share a
        ROW rather than each column stacking on its own:

          row 1   max_colors                     | (empty)
          row 2   colour palette — pick         | current selected colours
          row 3   hex + ✂ scissor orb           | Palettes

        Row 3 is the contract: the Palettes button loads a whole palette into
        the strip above it, and the orb adds a single colour to the strip, so
        the two "change the selected colours" controls belong opposite each
        other on one line. Two independent flex columns could not do this --
        the right column's button sat directly under its own strip, which is
        a different line entirely. %>  
    <div class="colour-set-pair">
      <div class="field colour-set-budget">
        <label>max_colors</label>
        <input type="number" id="f_max_colors" min="1" max="16" value="6">
      </div>

      <div aria-hidden="true"></div>

      <div class="field">
        <label>colour palette — pick</label>
        <div class="pal-quick" id="pal_quick" aria-label="Quick colour picks"></div>
      </div>

      <div class="field">
        <label>current selected colours</label>
        <div class="pal-strip" id="pal_strip" aria-label="Colours in this spec's palette"></div>
        <div class="pal-count" id="pal_count"></div>
      </div>

      <div class="pal-picker colour-set-picker">
        <span class="pal-swatch-lg" id="pal_swatch" style="background:#ffffff" aria-hidden="true"></span>
        <input type="text" id="pal_hex" class="mono" value="#ffffff" spellcheck="false" autocomplete="off" aria-label="Hex value">
        <button type="button" class="btn btn-primary btn-scissor" id="pal_add" title="Add colour" aria-label="Add colour">✂</button>
        <span class="pal-note" id="pal_note" role="status"></span>
      </div>

      <div class="colour-set-lib-cell">
        <button type="button" class="btn btn-secondary btn-sm" id="pal_presets_btn">Palettes</button>
      </div>
    </div>

    <textarea id="f_palette" class="mono" hidden><%= h(%w[#000000 #FFFFFF #FF0000 #0000FF #FFFF00 #00FF00].join("\n")) %></textarea>
  </div>
</div>

<%# Deeper field notes, surfaced by the "?" buttons on each card heading. %>
<div id="help-job-spec" hidden>
  <dl class="help-notes">
    <dt>print_method</dt><dd>How the job is produced — screen_print, dtg, or vinyl. Drives a few derived defaults (e.g. open-path tolerance).</dd>
    <dt>min_stroke_width_pt</dt><dd>Thinner strokes are a hard finding. 1.5pt ≈ most screen printers' floor.</dd>
    <dt>max_nodes_per_path</dt><dd>Node-count limit per path — trace weight / RIP load.</dd>
    <dt>allow_raster_embed</dt><dd>Whether <span class="mono">&lt;image&gt;</span> raster embeds inside the SVG are permitted. Default bans them — a "vector" that hides a bitmap is not printable.</dd>
    <dt>allow_gradients</dt><dd>Gradients / continuous tone. Also gates the <span class="mono">photo</span> preset — with gradients banned, photo-like traces are never generated.</dd>
    <dt>allow_open_paths</dt><dd>Open (unclosed) paths. Acceptable for most garments; vinyl cutting wants them closed.</dd>
  </dl>
</div>
<div id="help-sweep" hidden>
  <dl class="help-notes">
    <dt>presets</dt><dd>Which VTracer parameter sets the sweep traces. <span class="mono">bw</span> is a binary trace (one ink), <span class="mono">poster</span> a flat colour posterisation, <span class="mono">photo</span> a smooth-tone trace. <span class="mono">photo</span> is dropped automatically when <span class="mono">allow_gradients</span> is false — smooth tone is unprintable as spot colour. The sweep still samples every selected preset even at a small cap.</dd>
    <dt>max_candidates</dt><dd>Cap on traced candidates per job. The sweep is interleaved across its axes before truncation, so a small cap still covers every preset, every speckle value and both hierarchical modes.</dd>
    <dt>filter_speckle</dt><dd>Speckle sizes (px) to sweep. Larger values drop more isolated dots — fewer nodes, and small artwork detail can go with them.</dd>
    <dt>hierarchical</dt><dd>Layer stacking for the trace: <span class="mono">cutout</span> punches each layer out of the one below (smaller file, no overlaps), <span class="mono">stacked</span> draws them over one another (more forgiving of hairline gaps between shapes).</dd>
    <dt>use_palette</dt><dd>Whether one candidate is pre-quantised to the spec palette before tracing, which is often what makes a colour trace pass the palette gate. With <span class="mono">pitch_shift</span> on this axis retires — the <span class="mono">pitch</span> variant <em>is</em> the palette candidate.</dd>
  </dl>
</div>
<div id="help-colour-spec" hidden>
  <dl class="help-notes">
    <dt>pitch_shift</dt><dd>When on, the palette stops failing the source and recolours it instead: the source is traced as three variants — <span class="mono">source</span> (unchanged), <span class="mono">inverse</span> (RGB-inverted twin), and <span class="mono">pitch</span> (converted onto the palette) — each through the full sweep. The <span class="mono">use_palette</span> axis retires because <span class="mono">pitch</span> <em>is</em> the palette candidate.</dd>
    <dt>background_hex</dt><dd>The colour any alpha is flattened onto before tracing. Type a #rrggbb.</dd>
    <dt>colour palette</dt><dd>Expected spot colours. Layer A checks the artwork against them; the sweep pre-quantises one candidate to this palette — or, with <span class="mono">pitch_shift</span> on, recolours the source onto it as the <span class="mono">pitch</span> variant. Pick from the quick swatches, or type a #rrggbb and Add colour. Click a chip to load it back into the box, × to drop it, or the hex to copy it. "Palettes" opens the shop's predefined library.</dd>
    <dt>max_colors</dt><dd>Colour budget — Layer A hard gate. Declared colours must not exceed it.</dd>
  </dl>
</div>
<div id="help-print" hidden>
  <dl class="help-notes">
    <dt>dpi</dt><dd>Render / measurement DPI for proofs and fidelity.</dd>
    <dt>ink_limit_percent (TAC)</dt><dd>Total area coverage limit, percent — beyond this the ink floods the garment.</dd>
    <dt>count_white_as_ink</dt><dd>Count pure white as an ink. Set true for dark garments (white = underbase screen) — implies the underbase.</dd>
    <dt>ink_merge_tolerance</dt><dd>Colours closer than this (Euclidean sRGB, max 441) merge into one ink — keeps anti-alias fringe from inflating the count.</dd>
  </dl>
</div>

<%# The predefined palettes are the pipeline's own library (chopshop-svg
    scripts/palettes.json), rendered read-only from config/palettes.json.
    Nothing here is authoritative — clicking a palette's frame just fills the
    textarea, which stays the spec's source of truth. Kept off-canvas and
    shown in the glass modal by the "Palettes" button. %>
<div id="palPresetsTemplate" hidden>
  <div class="pal-src-line mono">chopshop-svg · scripts/palettes.json<% if @palette_library.version.present? %> v<%= @palette_library.version %><% end %></div>

  <% if @palette_library.any? %>
    <p class="hint">The shop's palette library — geometry is untouched by a palette, only the colour vectors change. Click a palette's frame to copy it in whole, or take colours from it one at a time with ＋; the spec's own palette stays editable in the colour spec block.</p>
    <div class="pal-presets">
      <% @palette_library.palettes.each do |pal| %>
        <div class="pal-preset" data-palette-id="<%= pal.id %>"
             data-colours="<%= pal.colours.map(&:hex).join(",") %>">
          <%# The whole frame is the control. The hit area is a real <button>
              laid UNDER the card's content (see .pal-preset-hit): tabbable and
              announced by a screen reader, while the content sits above it so
              the ＋ / → bg buttons keep their own clicks. There is deliberately
              no separate "Use this palette" button. %>
          <button type="button" class="pal-preset-hit"
                  aria-label="Use this palette: <%= pal.name %>, <%= pal.colours.size %> colours"
                  title="Replace the spec palette with this palette's <%= pal.colours.size %> colours"></button>
          <div class="pal-preset-head">
            <strong><%= pal.name %></strong>
            <span class="mono pal-preset-id"><%= pal.id %></span>
          </div>
          <% if pal.note.present? %><p class="hint"><%= pal.note %></p><% end %>
          <div class="pal-strip pal-strip-sm">
            <% pal.colours.each do |colour| %>
              <span class="pal-chip<%= " is-bg" if pal.background == colour.hex %>">
                <span class="pal-swatch" style="background:<%= colour.hex %>"></span>
                <span class="mono pal-hex"><%= colour.hex %></span>
                <span class="pal-role"><%= colour.role %><%= " · ground" if pal.background == colour.hex %></span>
                <button type="button" class="pal-add-one" data-hex="<%= colour.hex %>"
                        title="Add <%= colour.hex %> to the spec palette">＋</button>
                <% if pal.background == colour.hex %>
                  <button type="button" class="pal-set-bg" data-hex="<%= colour.hex %>"
                          title="Use <%= colour.hex %> as print.background_hex">→ bg</button>
                <% end %>
              </span>
            <% end %>
          </div>
          <% if pal.map.any? %>
            <div class="pal-map mono">
              pinned: <% pal.map.each do |from, to| %><%= from %> → <%= to %>&nbsp;<% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="hint">
      No palette library on disk. Run <span class="mono">bin/sync-palettes</span> to copy
      <span class="mono">chopshop-svg/scripts/palettes.json</span> into <span class="mono">config/palettes.json</span>
      (or point <span class="mono">CHOPSHOP_SVG_DIR</span> at the pipeline checkout first) and reload this page.
    </p>
  <% end %>
</div>

<%# The generated spec lives in a popup opened by the "JSON" button under the
    Run Job button on the title row. 60% wide, terminal-styled, and EDITABLE:
    #specOutput is the live target the builder JS writes into, so what you type
    is what the chips and the Run Job submit read back. The Close control is a
    word, not an &times; -- a bare glyph in the corner of a wide panel is easy
    to miss, and this panel is the one you dismiss most often. %>
<div class="popup" id="spec-popup" role="dialog" aria-modal="true"
     aria-labelledby="spec-popup-title" hidden>
  <div class="popup-panel popup-terminal">
    <header class="popup-head">
      <h2 id="spec-popup-title">job-contract.json</h2>
      <button type="button" class="btn btn-secondary btn-sm popup-close-text"
              data-popup-close>Close</button>
    </header>
    <div class="popup-body">
      <div class="spec-frame">
        <textarea id="specOutput" rows="20" class="mono spec-terminal" spellcheck="false"></textarea>
        <button type="button" class="copy-ghost" id="copySpecBtn"
                title="Copy JSON" aria-label="Copy JSON to clipboard">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <rect x="8.5" y="8.5" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M6 15.5H5.5A1.5 1.5 0 0 1 4 14V5.5A1.5 1.5 0 0 1 5.5 4H14a1.5 1.5 0 0 1 1.5 1.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var out = $('specOutput');
  var form = document.createElement('form');
  var palette = $('f_palette');

  function val(id) { return $(id).value.trim(); }
  function num(id) { var v = val(id); return v === '' ? null : Number(v); }

  // ---------- palette helpers: the textarea is the spec's source of truth,
  // the chips are just a view of it (and a way to write to it).

  var HEX_RE = /^#[0-9a-fA-F]{6}$/;

  function normHex(h) { return (h || '').trim().toLowerCase(); }
  function validHex(h) { return HEX_RE.test(h); }

  function paletteList() {
    return palette.value.split('\n')
      .map(function (l) { return normHex(l); })
      .filter(validHex);
  }

  function writePalette(list) {
    palette.value = list.join('\n');
    renderStrip();
    build();
  }

  // The textarea is the source of truth and the operator may be part-way
  // through typing a line, so chip actions edit the LINES rather than
  // rebuilding from paletteList() — that filter only keeps complete #rrggbb
  // values, so a round-trip would silently eat a half-typed colour and
  // lowercase every hex already in the box.
  function writeLines(lines) {
    palette.value = lines.join('\n');
    renderStrip();
    build();
  }

  function note(msg, bad) {
    var el = $('pal_note');
    el.textContent = msg || '';
    el.style.color = bad ? 'var(--danger)' : 'var(--text-tertiary)';
    if (msg) setTimeout(function () {
      if (el.textContent === msg) el.textContent = '';
    }, 2600);
  }

  function setPicker(hex) {
    $('pal_hex').value = hex;
    updateSwatch($('pal_swatch'), hex);
  }

  function addColour(hex) {
    hex = normHex(hex);
    if (!validHex(hex)) { note('not a #rrggbb colour: ' + (hex || '(empty)'), true); return; }
    if (paletteList().indexOf(hex) !== -1) { note(hex + ' is already in the palette'); return; }
    var lines = palette.value.split('\n');
    // append after the last non-empty line, so a trailing blank doesn't push
    // the new colour to the bottom of a growing gap
    while (lines.length && normHex(lines[lines.length - 1]) === '') lines.pop();
    lines.push(hex);
    writeLines(lines);
    setPicker(hex);
    note('added ' + hex);
  }

  // Remove the first line matching this colour and leave every other line
  // byte-for-byte alone — including blanks and half-typed entries.
  function removeColour(hex) {
    var lines = palette.value.split('\n');
    var kept = [];
    var removed = false;
    for (var i = 0; i < lines.length; i++) {
      if (!removed && normHex(lines[i]) === hex) { removed = true; continue; }
      kept.push(lines[i]);
    }
    writeLines(kept);
    note('removed ' + hex);
  }

  function renderStrip() {
    var list = paletteList();
    var strip = $('pal_strip');
    strip.textContent = '';
    list.forEach(function (hex) {
      var chip = document.createElement('span');
      chip.className = 'pal-chip';

      var sw = document.createElement('span');
      sw.className = 'pal-swatch';
      sw.style.background = hex;
      chip.appendChild(sw);

      var label = document.createElement('span');
      label.className = 'mono pal-hex';
      label.textContent = hex;
      label.title = 'Click to copy ' + hex;
      chip.appendChild(label);

      var drop = document.createElement('button');
      drop.type = 'button';
      drop.className = 'pal-drop';
      drop.textContent = '×';
      drop.title = 'Remove ' + hex;
      drop.addEventListener('click', function (e) {
        e.stopPropagation();
        removeColour(hex);
      });
      chip.appendChild(drop);

      chip.title = 'Load ' + hex + ' into the picker';
      chip.addEventListener('click', function () { setPicker(hex); });
      label.addEventListener('click', function (e) {
        e.stopPropagation();
        if (navigator.clipboard) {
          navigator.clipboard.writeText(hex).then(function () { note('copied ' + hex); });
        }
      });
      strip.appendChild(chip);
    });

    // the colour budget lives on max_colors — a warn, never a block
    var max = num('f_max_colors');
    var count = $('pal_count');
    count.textContent = list.length + (list.length === 1 ? ' colour' : ' colours');
    var over = max && list.length > max;
    if (over) {
      count.textContent += ' — over the max_colors gate (' + max + '). Layer A will flag it.';
      count.className = 'pal-count is-over';
    } else {
      if (max) count.textContent += ' of ' + max + ' allowed by max_colors';
      count.className = 'pal-count';
    }
  }

  // The native <input type="color"> dropper is gone — its OS picker's
  // eyedropper can't sample outside the browser, so the hex box plus the
  // quick-pick row below carry the selection. A non-interactive swatch
  // mirrors whatever hex is typed, so the colour is still visible.
  function updateSwatch(swatch, hex) {
    var h = normHex(hex);
    swatch.style.background = validHex(h) ? h : 'transparent';
  }

  function bindHexSwatch(textId, swatchId) {
    var text = $(textId), swatch = $(swatchId);
    text.addEventListener('input', function () {
      updateSwatch(swatch, text.value);
      build();
    });
  }
  bindHexSwatch('pal_hex', 'pal_swatch');
  bindHexSwatch('f_bg_hex', 'f_bg_swatch');

  // quick-pick row: common spot colours — click one to load it into the box
  var QUICK_COLOURS = [
    '#000000', '#FFFFFF', '#808080', '#C0C0C0',
    '#FF0000', '#FF4500', '#FFD700',
    '#FFFF00', '#00FF00', '#00FFFF',
    '#008080', '#0000FF', '#000080', '#FF00FF',
    '#800080', '#4B0082', '#6366f1',
    '#ec4899', '#06b6d4', '#818cf8'
  ];
  function renderQuickPicks() {
    var row = $('pal_quick');
    row.textContent = '';
    QUICK_COLOURS.forEach(function (hex) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'pal-qswatch';
      b.style.background = hex;
      b.title = 'Use ' + hex;
      b.setAttribute('aria-label', 'Use ' + hex);
      b.addEventListener('click', function () {
        setPicker(hex);
        note('picked ' + hex);
      });
      row.appendChild(b);
    });
  }
  renderQuickPicks();

  $('pal_add').addEventListener('click', function () {
    addColour($('pal_hex').value);
  });
  $('pal_hex').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); addColour($('pal_hex').value); }
  });

  // "Palettes" button opens the predefined library in the glass modal.
  $('pal_presets_btn').addEventListener('click', function () {
    var tpl = document.getElementById('palPresetsTemplate');
    if (window.CsModal && tpl) window.CsModal.open('Predefined palettes', tpl.innerHTML);
  });

  // Preset palette actions — delegated so they work both before and after the
  // template is cloned into the popup (innerHTML copies drop direct bindings).
  //
  // ORDER IS THE CONTRACT. The frame is clickable, so a click on ＋ / → bg
  // inside a card must be resolved FIRST and return — otherwise the frame
  // branch below would also fire and load the whole palette on top of the one
  // colour. stopPropagation() cannot help here: every branch lives in this one
  // listener, so it is the early `return` that keeps the actions exclusive.
  document.addEventListener('click', function (e) {
    var setBg = e.target.closest('.pal-set-bg');
    if (setBg) {
      $('f_bg_hex').value = setBg.dataset.hex;
      updateSwatch($('f_bg_swatch'), setBg.dataset.hex);
      build();
      note('background_hex = ' + setBg.dataset.hex);
      return;
    }
    var addOne = e.target.closest('.pal-add-one');
    if (addOne) {
      addColour(addOne.dataset.hex);
      return;
    }
    // The frame itself: either the hit-area button was clicked, or the click
    // landed on the card's content (name, note, chips) and bubbled up to here.
    var preset = e.target.closest('.pal-preset');
    if (preset) {
      e.preventDefault();
      var colours = (preset.dataset.colours || '').split(',').map(normHex).filter(validHex);
      if (!colours.length) { return; }
      writePalette(colours);
      var nameEl = preset.querySelector('strong');
      note('loaded ' + (nameEl ? nameEl.textContent : 'palette'));
      if (window.CsModal) window.CsModal.close();
      return;
    }
  });

  // hand-editing the textarea updates the strip, and vice versa (writePalette
  // calls renderStrip, so this only needs the one direction)
  palette.addEventListener('input', function () { renderStrip(); build(); });

  function build() {
    var spec = {};
    var pm = val('f_print_method');
    if (pm) spec.print_method = pm;
    var mc = num('f_max_colors'); if (mc) spec.max_colors = mc;
    var pal = paletteList();
    if (pal.length) spec.palette = pal;
    var il = num('f_ink_limit'); if (il) spec.ink_limit_percent = il;

    var geo = {};
    var ms = num('f_min_stroke'); if (ms) geo.min_stroke_width_pt = ms;
    var mn = num('f_max_nodes'); if (mn) geo.max_nodes_per_path = mn;
    geo.allow_raster_embed = val('f_raster_embed') === 'true';
    geo.allow_gradients = val('f_gradients') === 'true';
    geo.allow_open_paths = val('f_open_paths') === 'true';
    spec.geometry = geo;

    var pr = {};
    var dpi = num('f_dpi'); if (dpi) pr.dpi = dpi;
    pr.count_white_as_ink = val('f_white_ink') === 'true';
    if (pr.count_white_as_ink) pr.dark_garment_underbase = true;
    var im = num('f_ink_merge'); if (im !== null) pr.ink_merge_tolerance = im;
    // Sweep axes: the same keys trace_sweep.py reads from print.sweep, so the
    // contract carries the preset choice instead of the pipeline falling back
    // to its own defaults. max_candidates supersedes the old
    // print.sweep_max_candidates (still honoured by the pipeline).
    var sw = {};
    var presets = ['bw', 'poster', 'photo'].filter(function (p) { return $('f_preset_' + p).checked; });
    if (presets.length) sw.presets = presets;
    var sm = num('f_sweep_max'); if (sm) sw.max_candidates = sm;
    var speckles = val('f_speckle').split(',').map(function (v) { return Number(v.trim()); })
      .filter(function (v) { return !isNaN(v) && v >= 0; });
    if (speckles.length) sw.filter_speckle = speckles;
    var hier = ['cutout', 'stacked'].filter(function (h) { return $('f_hier_' + h).checked; });
    if (hier.length) sw.hierarchical = hier;
    var up = val('f_use_palette');
    if (up === 'off') sw.use_palette = [false];
    else if (up === 'on') sw.use_palette = [true];
    // 'both' is the pipeline default, so it is left out rather than spelled out
    if (Object.keys(sw).length) pr.sweep = sw;
    if (val('f_pitch_shift') === 'true') pr.pitch_shift = true;
    pr.invert = true;  // prep-time colour-inverted twin (source + inverse previews)
    var bg = normHex(val('f_bg_hex')); if (validHex(bg)) pr.background_hex = bg;
    spec.print = pr;

    spec.validation = { run_preflight: true, flag_on_any_failure: true, auto_retry_limit: 3 };
    out.value = JSON.stringify(spec, null, 2);
  }

  document.querySelectorAll('#f_print_method,#f_max_colors,#f_min_stroke,#f_max_nodes,#f_raster_embed,#f_gradients,#f_open_paths,#f_dpi,#f_ink_limit,#f_white_ink,#f_ink_merge,#f_pitch_shift,#f_sweep_max,#f_speckle,#f_use_palette,#f_preset_bw,#f_preset_poster,#f_preset_photo,#f_hier_cutout,#f_hier_stacked')
    .forEach(function (el) {
      el.addEventListener('input', build);
      el.addEventListener('change', build);
    });
  // max_colors also moves the counter's warning
  $('f_max_colors').addEventListener('input', renderStrip);
  renderStrip();
  build();

  form.method = 'post';
  form.action = '<%= use_json_path %>';
  var ta = document.createElement('textarea');
  ta.name = 'spec'; ta.style.display = 'none';
  form.appendChild(ta);
  document.body.appendChild(form);

  // Running the job is irreversible from this page — the POST starts a sweep
  // and the form navigates away — so the scissor orb confirms first. The
  // confirm button is the same decorated orb, so the action the dialog is
  // asking about is the control the operator just pressed.
  function submitSpec() {
    ta.value = out.value;
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    var csrfField = document.createElement('input');
    csrfField.type = 'hidden'; csrfField.name = 'authenticity_token'; csrfField.value = csrf;
    form.appendChild(csrfField);
    form.submit();
  }

  // The Run Job button asks before it spends the run, with the same
  // "Confirm?" | Cancel | Run Job dialog the Run Job page uses, so the two
  // pages confirm identically. The dialog shows the exact bytes that will be
  // posted, so a half-typed hex or an unselected preset is visible first.
  $('useSpecBtn').addEventListener('click', function confirmThenRun() {
    if (!window.CsModal) { submitSpec(); return; }
    window.CsModal.open('Confirm?',
      '<div class="cs-confirm">' +
      '  <p class="cs-confirm-msg">Run this job contract as it stands? The spec ' +
      'is sent verbatim — anything left out falls back to the ' +
      'pipeline default, and the run cannot be edited once it starts.</p>' +
      '  <pre class="cs-confirm-json mono" id="useSpecPreview"></pre>' +
      '  <div class="cs-confirm-actions">' +
      '    <button type="button" class="btn btn-secondary btn-sm" data-cs-close="1">Cancel</button>' +
      '    <button type="button" class="btn btn-primary btn-sm" id="useSpecOk"' +
      '      title="Run this job" aria-label="Run this job">Run Job</button>' +
      '  </div>' +
      '</div>');
    var preview = document.getElementById('useSpecPreview');
    if (preview) preview.textContent = out.value;
    var ok = document.getElementById('useSpecOk');
    if (ok) ok.addEventListener('click', function () {
      window.CsModal.close();
      submitSpec();
    });
  });

  $('copySpecBtn').addEventListener('click', function () {
    var btn = $('copySpecBtn');
    navigator.clipboard.writeText(out.value).then(function () {
      btn.classList.add('is-copied');
      setTimeout(function () { btn.classList.remove('is-copied'); }, 1400);
    });
  });

  // Proximity reveal: the ghost copy icon stays transparent until the pointer
  // drifts near it (within ~130px of its centre), then fades in. Keyboard users
  // still get it via :focus-visible.
  var copyBtn = $('copySpecBtn');
  var copyFrame = copyBtn.closest('.spec-frame');
  function nearCopyIcon(x, y) {
    var r = copyBtn.getBoundingClientRect();
    var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    var dx = x - cx, dy = y - cy;
    return (dx * dx + dy * dy) < 130 * 130;
  }
  copyFrame.addEventListener('mousemove', function (e) {
    copyBtn.classList.toggle('is-near', nearCopyIcon(e.clientX, e.clientY));
  });
  copyFrame.addEventListener('mouseleave', function () {
    copyBtn.classList.remove('is-near');
  });
})();
</script>
