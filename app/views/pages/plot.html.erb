<div class="page-head">
  <%# The JSON page's head arrangement, exactly: Run Job in grid row 1, the popup
      pair in row 2 col 2, blurb in row 2 col 1 -- and the blurb LAST in the row,
      which is what the phone media query places by grid-row. %>
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">PLOT</span> — geometry source &amp; run reporter</h1>
    <%= link_to "Run Job", new_job_path, class: "btn btn-primary head-action head-action--top" %>
    <%# A PAIR, like FLUX's: FIELDS first because the metric field registry is
        what decides every axis on this page, so it is what you reach for when a
        chart will not draw. JSON second, the generated conf. %>
    <div class="head-action-pair head-action--below">
      <button type="button" class="btn btn-secondary head-action" data-popup="plot-fields-popup"
              title="The metric field registry, the element types and the chart shapes"
              aria-label="The metric field registry, the element types and the chart shapes">FIELDS</button>
      <button type="button" class="btn btn-secondary head-action" data-popup="plot-conf-popup"
              title="View the generated service configuration as JSON"
              aria-label="View the generated service configuration as JSON">JSON</button>
    </div>
    <p class="page-head-blurb">This page configures the <span class="mono">chopshop-plot</span> service and draws nothing itself — the geometry spec, the chart and the run records are requests to that service.</p>
  </div>
</div>

<%# The four cards render from PlotConf::CARDS, and the help blocks below render
    from the same fields -- so a card's "?" documents that card's fields and
    nothing else by construction, which is the rule the JSON page has to enforce
    with a test because its cards are hand-written. %>
<div class="grid-2" style="align-items:stretch;">
  <% PlotConf::CARDS.each do |card| %>
    <div class="card" data-plot-card="<%= card[:title] %>">
      <div class="card-head">
        <h3><%= card[:title] %></h3>
        <button type="button" class="help-btn" data-help-title="<%= card[:title] %>"
                data-help-target="<%= card[:help] %>"
                aria-label="Explain <%= card[:title] %>" title="Explain <%= card[:title] %>">?</button>
      </div>
      <p class="jev-question"><%= card[:blurb] %></p>

      <% if card[:title] == "Service" %>
        <%# The runners this deployment actually files as plot runners. The map is
            env-driven, so the page reports the live one rather than the default
            it documents -- and "none configured" is a real answer, not an error:
            the settings below stand on their own. The nav's runner pill is the
            live check; this page never calls the service. %>
        <div class="actions-row" id="plotRunnerRow">
          <span class="status-pill <%= @plot_runners.any? ? "status-pass" : "status-pending" %>"
                id="plotRunnerPill"><%= @plot_runners.any? ? "#{@plot_runners.size} configured" : "none configured" %></span>
          <span class="tech-tag" id="plotRunnerNote">
            <% if @plot_runners.any? %>
              <%= @plot_runners.map { |label, url| "#{label} → #{url}" }.join(" · ") %>
            <% else %>
              set CHOPSHOP_RUNNER_PLOT_URL, and CHOPSHOP_RUNNER_PLOT_KIND=plot
            <% end %>
          </span>
        </div>
      <% end %>

      <div class="print-grid">
        <% card[:fields].each do |f| %>
          <% id = "f_plot_#{card[:title].downcase}_#{f[:label].to_s.tr(' ', '_')}" %>
          <div class="field">
            <label for="<%= id %>"><%= f[:label] %></label>
            <% case f[:type] %>
            <% when :select %>
              <select id="<%= id %>" data-plot-field="<%= f[:label] %>">
                <% Array(f[:options]).each do |opt| %>
                  <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt %></option>
                <% end %>
              </select>
            <% when :number %>
              <input type="number" id="<%= id %>" data-plot-field="<%= f[:label] %>"
                     value="<%= f[:default] %>"
                     <%= "min=\"#{f[:min]}\"".html_safe if f[:min] %>
                     <%= "max=\"#{f[:max]}\"".html_safe if f[:max] %>>
            <% when :static %>
              <%# A contract fact, not a setting: shown as a value rather than
                  offered as an input that would do nothing. %>
              <div class="mono" id="<%= id %>" data-plot-field="<%= f[:label] %>"><%= f[:default] %></div>
            <% else %>
              <input type="text" id="<%= id %>" data-plot-field="<%= f[:label] %>"
                     class="mono" value="<%= f[:default] %>">
            <% end %>
            <div class="hint"><%= f[:hint] %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# ============ Checks: the live contract check, full width ============
    Its own card rather than a panel inside Charts: it answers rather than
    configures, and the answer has a legend of its own. Rendered server-side for
    the default combination first, so the card is correct with JavaScript off and
    only upgrades to live. %>
<% check_fields = PlotConf::CHECKS[:fields].index_by { |f| f[:label] } %>
<% initial_check = PlotConf.validate(
     op: check_fields["op"][:default], chart: check_fields["chart"][:default],
     x: check_fields["x"][:default], y: check_fields["y"][:default],
     color: check_fields["color"][:default]) %>
<div class="card" data-plot-checks="<%= PlotConf::CHECKS[:title] %>">
  <div class="card-head">
    <h3><%= PlotConf::CHECKS[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= PlotConf::CHECKS[:title] %>"
            data-help-target="<%= PlotConf::CHECKS[:help] %>"
            aria-label="Explain <%= PlotConf::CHECKS[:title] %>"
            title="Explain <%= PlotConf::CHECKS[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= PlotConf::CHECKS[:blurb] %></p>

  <div class="print-grid">
    <% PlotConf::CHECKS[:fields].each do |f| %>
      <div class="field">
        <label for="f_plot_check_<%= f[:label] %>"><%= f[:label] %></label>
        <select id="f_plot_check_<%= f[:label] %>" data-plot-field="<%= f[:label] %>">
          <% Array(f[:options]).each do |opt| %>
            <option value="<%= opt %>" <%= "selected" if opt.to_s == f[:default].to_s %>><%= opt.to_s.empty? ? "(none)" : opt %></option>
          <% end %>
        </select>
        <div class="hint"><%= f[:hint] %></div>
      </div>
    <% end %>
  </div>

  <div class="jev-derived" id="plotCheckDerived">
    <p class="jev-derived-label">Derived, as the contract would see it</p>
    <div class="jev-card">
      <div class="a <%= initial_check[:problems].any? ? "is-bad" : "is-ok" %>" id="plotCheckVerdict"><%= initial_check[:problems].any? ? "rejected" : "accepted" %></div>
      <div class="note"><%= initial_check[:problems].any? ? "the service would refuse this as a caller error" : "the service would draw it" %></div>
    </div>
    <%# The service's own sentences, and nothing else: an empty list is the whole
        answer when the combination is accepted. JS refills this element; the
        server-rendered content is the default combination. %>
    <div id="plotCheckProblems">
      <% if initial_check[:problems].any? %>
        <% initial_check[:problems].each do |problem| %>
          <p class="jev-note is-bad"><%= problem %></p>
        <% end %>
      <% else %>
        <% initial_check[:notes].each do |note| %>
          <p class="jev-note"><%= note %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%# ============ Metrics schema: the foundation, full width ============
    Whatever a chart is drawn from, it is drawn from these fields -- and the rule
    that makes them safe to read is that missing is a state, not a zero. %>
<div class="card" data-plot-schema="<%= PlotConf::SCHEMA[:title] %>">
  <div class="card-head">
    <h3><%= PlotConf::SCHEMA[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= PlotConf::SCHEMA[:title] %>"
            data-help-target="<%= PlotConf::SCHEMA[:help] %>"
            aria-label="Explain <%= PlotConf::SCHEMA[:title] %>"
            title="Explain <%= PlotConf::SCHEMA[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= PlotConf::SCHEMA[:blurb] %></p>

  <%# The version is one line, so it sits above the grid rather than in a cell of
      it: a one-line block beside a 21-field column leaves that column's whole
      height empty and reads as a broken column. %>
  <dl class="help-notes">
    <dt class="mono">metrics_version</dt>
    <dd><%= PlotConf::METRICS_VERSION %> — a reader refuses a version it does not know.</dd>
  </dl>

  <div class="print-grid">
    <div class="jev-derived">
      <p class="jev-derived-label">Numeric — the selectable axes</p>
      <dl class="help-notes">
        <% PlotConf::NUMERIC_FIELDS.each do |field, gloss| %>
          <dt class="mono"><%= field %></dt>
          <dd><%= gloss %></dd>
        <% end %>
      </dl>
    </div>
    <div class="jev-derived">
      <p class="jev-derived-label">Categorical — colour, filter, group</p>
      <dl class="help-notes">
        <% PlotConf::CATEGORICAL_FIELDS.each do |field, gloss| %>
          <dt class="mono"><%= field %></dt>
          <dd><%= gloss %></dd>
        <% end %>
      </dl>
      <p class="jev-derived-label">Identity — what makes two runs comparable</p>
      <dl class="help-notes">
        <% PlotConf::IDENTITY_FIELDS.each do |field| %>
          <dt class="mono"><%= field %></dt>
          <dd><%= PlotConf::IDENTITY_GLOSS[field] %></dd>
        <% end %>
      </dl>
    </div>
  </div>
</div>

<%# The two deployments, and what has to be true of a host for each. Full width
    for the same reason the two cards above are: two columns of shapes and their
    variables need the room, and half a page would make them a footnote. %>
<div class="card" data-plot-placement="<%= PlotConf::PLACEMENT[:title] %>">
  <div class="card-head">
    <h3><%= PlotConf::PLACEMENT[:title] %></h3>
    <button type="button" class="help-btn" data-help-title="<%= PlotConf::PLACEMENT[:title] %>"
            data-help-target="<%= PlotConf::PLACEMENT[:help] %>"
            aria-label="Explain <%= PlotConf::PLACEMENT[:title] %>"
            title="Explain <%= PlotConf::PLACEMENT[:title] %>">?</button>
  </div>
  <p class="jev-question"><%= PlotConf::PLACEMENT[:blurb] %></p>

  <div class="print-grid">
    <% PlotConf::PLACEMENT[:shapes].each do |name, why, vars| %>
      <div class="jev-derived">
        <p class="jev-derived-label"><%= name %></p>
        <p class="jev-note"><%= why %></p>
        <%# The variables ARE the difference between the two shapes, so they sit
            on the card rather than only behind the help: the variable, then what
            it does. %>
        <dl class="help-notes">
          <% vars.each do |var, gloss| %>
            <dt class="mono"><%= var %></dt>
            <dd><%= gloss %></dd>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>
</div>

<%# ============ the help each "?" reveals ============
    One block per card, built from that card's own fields: the <dt> is the
    field's label and the <dd> its help, so the help cannot document a field the
    card does not have, nor miss one it does. %>
<% PlotConf::CARDS.each do |card| %>
  <div id="<%= card[:help] %>" hidden>
    <dl class="help-notes">
      <% card[:fields].each do |f| %>
        <dt><%= f[:label] %><% if f[:env] %> <span class="mono">· <%= f[:env] %></span><% end %></dt>
        <dd><%= f[:help] %></dd>
      <% end %>
    </dl>
  </div>
<% end %>

<%# The Checks, schema and placement cards answer rather than configure, so their
    help documents what the card shows rather than a field list. Same dl
    vocabulary, so they read like the four above. %>
<div id="<%= PlotConf::CHECKS[:help] %>" hidden>
  <dl class="help-notes">
    <% PlotConf::CHECKS[:fields].each do |f| %>
      <dt><%= f[:label] %></dt>
      <dd><%= f[:help] %></dd>
    <% end %>
  </dl>
</div>

<div id="<%= PlotConf::SCHEMA[:help] %>" hidden>
  <dl class="help-notes">
    <% PlotConf::SCHEMA[:entries].each do |label, help| %>
      <dt><%= label %></dt>
      <dd><%= help %></dd>
    <% end %>
  </dl>
</div>

<div id="<%= PlotConf::PLACEMENT[:help] %>" hidden>
  <dl class="help-notes">
    <% PlotConf::PLACEMENT[:entries].each do |label, help| %>
      <dt><%= label %></dt>
      <dd><%= help %></dd>
    <% end %>
  </dl>
</div>

<%# ============ FIELDS: the registry and the shapes ============ %>
<div class="popup" id="plot-fields-popup" role="dialog" aria-modal="true"
     aria-labelledby="plot-fields-popup-title" hidden>
  <div class="popup-panel">
    <header class="popup-head">
      <h2 id="plot-fields-popup-title">Fields</h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <p class="jev-question">Transcribed from <span class="mono">chopshop_plot/metrics.py</span> and <span class="mono">chopshop_plot/spec.py</span>. Every axis on this page is one of the numeric fields below — the engine never picks one for you.</p>

      <h3 class="jev-help-h">What each element must carry</h3>
      <p class="jev-note">Seven types — <span class="mono">rect, circle, ellipse, polygon, polyline, line, path</span> — and every positional field in the table is required.</p>
      <div class="jev-help">
        <% PlotConf::ELEMENTS.each do |type, required| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= type %></div>
            <div class="jev-help-v">
              <span class="mono"><%= required.join(", ") %></span> required
              <% extra = { "rect" => "rx, fill, stroke, stroke_width",
                           "circle" => "fill, stroke, stroke_width",
                           "ellipse" => "fill, stroke, stroke_width",
                           "polygon" => "fill, stroke, stroke_width",
                           "polyline" => "stroke, stroke_width",
                           "line" => "stroke, stroke_width",
                           "path" => "fill, stroke, stroke_width" }[type] %>
              · optional <span class="mono"><%= extra %></span>
            </div>
          </div>
        <% end %>
      </div>

      <h3 class="jev-help-h">What each chart reads</h3>
      <div class="jev-help">
        <div class="jev-help-row">
          <div class="jev-help-k mono">bar / line</div>
          <div class="jev-help-v"><span class="mono">labels</span> plus <span class="mono">series</span>
            (<span class="mono">{name, values}</span>), or a bare <span class="mono">values</span> array.
            Each series is a polyline on <span class="mono">line</span>.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">scatter</div>
          <div class="jev-help-v">digest: <span class="mono">points</span> as
            <span class="mono">{x, y}</span>, or <span class="mono">series</span> of
            <span class="mono">{name, points}</span>. query: <span class="mono">x</span> and
            <span class="mono">y</span> naming two numeric fields, with every candidate across
            every run as a point.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">pareto</div>
          <div class="jev-help-v">the same two axes, both MINIMISED, with the non-dominated
            candidates highlighted. Non-domination is computed on the data values, never on
            screen pixels — screen y is inverted, so the pixel test would maximise y.</div>
        </div>
        <div class="jev-help-row">
          <div class="jev-help-k mono">diff</div>
          <div class="jev-help-v"><span class="mono">left</span> and
            <span class="mono">right</span>, each <span class="mono">{candidate_id}</span> or
            <span class="mono">{recipe_hash, source_sha256}</span>. A recipe+source pair diffs the
            cleanest instance of that recipe on that source — never "the winner", there is none.</div>
        </div>
      </div>

      <h3 class="jev-help-h">The registry</h3>
      <div class="jev-help">
        <% PlotConf::NUMERIC_FIELDS.each do |field, gloss| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= field %></div>
            <div class="jev-help-v"><%= gloss %></div>
          </div>
        <% end %>
        <% PlotConf::CATEGORICAL_FIELDS.each do |field, gloss| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= field %></div>
            <div class="jev-help-v"><%= gloss %> <span class="tech-tag">categorical</span></div>
          </div>
        <% end %>
        <% PlotConf::IDENTITY_FIELDS.each do |field| %>
          <div class="jev-help-row">
            <div class="jev-help-k mono"><%= field %></div>
            <div class="jev-help-v">identity <span class="tech-tag">not an axis</span></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# ============ JSON: the generated conf, terminal-ish, like FLUX's ============ %>
<div class="popup" id="plot-conf-popup" role="dialog" aria-modal="true"
     aria-labelledby="plot-conf-popup-title" hidden>
  <div class="popup-panel popup-terminal">
    <header class="popup-head">
      <h2 id="plot-conf-popup-title">plot.conf.json</h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <div class="spec-frame">
        <textarea id="plotConfOutput" rows="22" class="mono spec-terminal" spellcheck="false"></textarea>
        <button type="button" class="copy-ghost" id="copyPlotConfBtn"
                title="Copy JSON" aria-label="Copy the plot configuration to the clipboard">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <rect x="8.5" y="8.5" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M6 15.5H5.5A1.5 1.5 0 0 1 4 14V5.5A1.5 1.5 0 0 1 5.5 4H14a1.5 1.5 0 0 1 1.5 1.5V6" fill="none" stroke="currentColor" stroke-width="1.6"/>
          </svg>
        </button>
      </div>
      <p class="plot-conf-status mono" id="plotConfStatus" role="status"></p>
      <p class="jev-question">A working copy. This page does not run the service and cannot set
        its environment — start it with these, or paste the <span class="mono">env</span> block
        into whatever supervises it. <span class="mono">python3 cli.py serve</span> in the plot
        repo is the whole service.</p>
    </div>
  </div>
</div>

<%# The rules, straight from the model, so the browser does not restate them. %>
<script type="application/json" id="plotFacts"><%= raw(PlotConf.facts.to_json) %></script>

<script>
(function () {
  // The form fields are the source of truth and the JSON is a view of them --
  // the same arrangement the JSON, Jev and FLUX pages use, for the same reason:
  // the terminal view is what you copy, but the fields are what you edit.
  var FACTS = JSON.parse(document.getElementById('plotFacts').textContent);
  var out = document.getElementById('plotConfOutput');
  var status = document.getElementById('plotConfStatus');

  function val(name) {
    var el = document.querySelector('[data-plot-field="' + name + '"]');
    return el ? el.value : '';
  }

  // The contract's rules, in the browser. Their tested twin is
  // PlotConf.validate in Ruby; this is the same two branches -- a chart belongs
  // to its own operation, and an axis must be a numeric metric field -- read
  // from FACTS rather than restated with a field list in JS.
  function check(op, chart, x, y, color) {
    var problems = [];
    var notes = [];
    var digestCharts = FACTS.digestCharts, queryCharts = FACTS.queryCharts;

    // Which operation takes chart axes at all, and which query charts take two
    // of them, both come from FACTS rather than from a literal in here: the
    // model is the source, and this is only the shape of the answer.
    if (FACTS.axisOps.indexOf(op) === -1) {
      notes.push('generate takes no chart: it takes a geometry spec and draws the SVG directly.');
      return { problems: problems, notes: notes };
    }
    if (digestCharts.indexOf(chart) === -1 && queryCharts.indexOf(chart) === -1) {
      problems.push("'chart' must be one of " + digestCharts.join(', ') + ' for digest or ' +
                    queryCharts.join(', ') + ' for query, got ' + chart);
      return { problems: problems, notes: notes };
    }
    if (op === 'digest' && digestCharts.indexOf(chart) === -1) {
      problems.push(chart + ' is a query chart: the digest operation reads one run\'s numbers and knows ' +
                    digestCharts.join(', ') + ' only.');
      return { problems: problems, notes: notes };
    }
    if (op === 'query' && queryCharts.indexOf(chart) === -1) {
      problems.push(chart + ' is a digest chart: the query operation reads run records and knows ' +
                    queryCharts.join(', ') + ' only.');
      return { problems: problems, notes: notes };
    }
    if (FACTS.queryAxisCharts.indexOf(chart) !== -1) {
      [['x', x], ['y', y]].forEach(function (pair) {
        if (!pair[1]) { problems.push(chart + ': ' + pair[0] + ' is required'); }
        else if (FACTS.numericFields.indexOf(pair[1]) === -1) {
          problems.push(chart + ': axis ' + "'" + pair[1] + "'" + ' is not a numeric metric field');
        }
      });
      if (color && FACTS.categoricalFields.indexOf(color) === -1) {
        problems.push(chart + ": 'color' must be a categorical field");
      }
    }
    if (!problems.length) {
      notes.push("the axis is the user's choice — nothing here ranks the fields or recommends one");
    }
    return { problems: problems, notes: notes };
  }

  function build() {
    var env = {};
    ['bind', 'port', 'token', 'runner url', 'runner kind'].forEach(function (k) {
      env[k] = val(k);
    });

    var result = check(val('op'), val('chart'), val('x'), val('y'), val('color'));

    return {
      service: FACTS.service,
      env: {
        CHOPSHOP_PLOT_BIND: env['bind'],
        CHOPSHOP_PLOT_PORT: Number(env['port']),
        CHOPSHOP_PLOT_TOKEN: env['token'] === '' ? null : env['token']
      },
      runner: {
        label: env['runner kind'],
        kind: env['runner kind'],
        url: env['runner url']
      },
      operations: FACTS.operations,
      metrics_version: FACTS.metricsVersion,
      charts: { digest: FACTS.digestCharts, query: FACTS.queryCharts },
      check: {
        op: val('op'), chart: val('chart'),
        x: val('x'), y: val('y'), color: val('color') || null
      },
      problems: result.problems,
      notes: result.notes
    };
  }

  function renderCheck(conf) {
    var verdict = document.getElementById('plotCheckVerdict');
    var list = document.getElementById('plotCheckProblems');
    if (!verdict || !list) return;
    var rejected = conf.problems.length > 0;
    verdict.className = 'a ' + (rejected ? 'is-bad' : 'is-ok');
    verdict.textContent = rejected ? 'rejected' : 'accepted';
    verdict.nextElementSibling.textContent = rejected
      ? 'the service would refuse this as a caller error'
      : 'the service would draw it';
    list.textContent = '';
    (rejected ? conf.problems : conf.notes).forEach(function (line) {
      var p = document.createElement('p');
      p.className = 'jev-note' + (rejected ? ' is-bad' : '');
      p.textContent = line;
      list.appendChild(p);
    });
  }

  function write() {
    var conf = build();
    if (out) out.value = JSON.stringify(conf, null, 2);
    if (status) {
      var bits = [];
      if (conf.problems.length) bits.push(conf.problems.length + ' problem(s)');
      if (conf.notes.length) bits.push(conf.notes.length + ' note(s)');
      status.className = 'plot-conf-status mono ' + (conf.problems.length ? 'is-bad' : 'is-ok');
      status.textContent = bits.length
        ? bits.join(', ') + ' — see ' + (conf.problems.length ? 'problems' : 'notes') + ' in the JSON'
        : 'valid — ' + out.value.length + ' bytes';
    }
    renderCheck(conf);
  }

  document.addEventListener('input', function (e) {
    if (e.target.id === 'plotConfOutput') { if (status) status.textContent = ''; return; }
    if (e.target.closest('.card[data-plot-card], .card[data-plot-checks]')) write();
  });
  document.addEventListener('change', function (e) {
    if (!e.target.closest('.card[data-plot-card], .card[data-plot-checks]')) return;
    write();
  });

  // JSON opens with the current conf already in the terminal.
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-popup="plot-conf-popup"]')) return;
    write();
  });

  var copyBtn = document.getElementById('copyPlotConfBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', function () {
      if (navigator.clipboard) navigator.clipboard.writeText(out.value);
      copyBtn.classList.add('is-copied');
      setTimeout(function () { copyBtn.classList.remove('is-copied'); }, 1200);
    });
  }

  write();
})();
</script>
