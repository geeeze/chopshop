<%
  running = Job::IN_FLIGHT_STATES.include?(@job.state)
  cands = @job.comparison.is_a?(Hash) ? Array(@job.comparison["candidates"]) : []
  pitch_shift = @job.spec.is_a?(Hash) && @job.spec.dig("print", "pitch_shift")
  # per-candidate finished proof, keyed by file, for proof links in the rows
  proof_by_file = @job.validations.select { |v| v.state == "done" }
                        .each_with_object({}) do |v, h|
    h[v.file] = v.manifest if v.manifest.is_a?(Hash) && v.manifest["proof"].present?
  end

  # ---------------------------------------------------------------------
  # THE SOURCE PAIR, and the provenance behind it.
  #
  # A pipeline job's pair is the runner's prep output — source.png and its
  # colour-inverted twin source.inverse.png — proxied through the file route.
  # A FLUX job is not that, in either tile, because its origin is a GENERATION
  # the studio did rather than a prep a runner ran:
  #
  #   source   raster-only: the generated raster, from storage/uploads — there
  #                         is no runner to hold a copy of it.
  #            trace mode:  the runner's source.png, which IS the raster the
  #                         hand-off wrote there before tracing it.
  #   inverse  raster-only: the twin inverted locally when the raster landed
  #                         (RunJob -> FluxInverseTwin), stored in uploads.
  #            trace mode:  the runner's source.inverse.png from prep.
  #
  # An img2img generation gets a REFERENCE tile as well: the image that was
  # piped in is the one artefact of the provenance no runner ever holds, and
  # it is genuinely "the source" the picture came from.
  #
  # Everything here is served through a route that already exists (the runner
  # file proxy, or the login-gated upload_preview for storage/uploads), and
  # every img self-hides on error, so an absent twin collapses its tile rather
  # than showing a broken image. The tiles open in the site popup: `data-cs-view`
  # without a `data-cs-group` takes the plain-image branch of the viewer.
  flux = @job.flux?
  raster_only = @job.raster_only?
  # The RUNNER's precondition pair, by name: a trace-mode flux job's tiles proxy
  # these, and the candidate sweep compares every traced candidate against them
  # (data-cs-ref-source / -inverse). Named once, here.
  inverse_name = "source.inverse.png"
  flux_raster = flux ? @job.flux_variations.dig(0, "file") : nil
  flux_twin = flux ? @job.flux_inverse_file : nil
  flux_ref = flux ? @job.flux_reference_file : nil
  ref_url = flux_ref && upload_preview_jobs_path(name: flux_ref)

  if raster_only
    # Both tiles are local uploads: a raster-only job has no runner at all.
    source_local = true
    source_name = flux_raster
    source_url = source_name && upload_preview_jobs_path(name: source_name)
    inverse_local = true
    twin_name = flux_twin
    twin_url = twin_name && upload_preview_jobs_path(name: twin_name)
  else
    source_local = false
    source_name = "source.png"
    source_url = file_job_path(@job, name: source_name)
    inverse_local = false
    twin_name = inverse_name
    twin_url = file_job_path(@job, name: twin_name)
  end

  # What drew the raster on the source tiles: the prompt and the whole
  # generation config, as one JSON blob the preview popup reads (see
  # csFluxConfig() in aether.js). Nil for a pipeline job, where there is no
  # generation to reveal — the same asymmetry that keeps the popup's Prompt /
  # Source control off a traced candidate.
  pair_prompt = flux ? @job.flux_prompt : nil
  pair_config = flux ? JSON.generate(@job.flux_reveal_config(@job.flux_variations.first)) : nil
  # ---------------------------------------------------------------------
  # THE SOURCE STACK: what the run was made FROM and everything it MADE.
  #
  # Every preview of the run's lineage goes in ONE vertical, bottom-aligned
  # column at the foot of the page: the raster pair (and the img2img reference
  # beside it), a flux job's generated variations, and a plot job's drawn SVG.
  # They used to be a 2x2 dock in the page head plus two cards ABOVE the
  # candidates table, which put the provenance between the operator and the
  # run. Resolved here rather than inline in the stack because the container
  # itself is left out when it has nothing to show.
  variations = @job.flux_variations
  show_variations = variations.size > 1 || (@job.raster_only? && variations.any?)
  plot_file = @job.plot_output_file
  source_tiles = ref_url || source_url || twin_url
  show_source_stack = source_tiles || show_variations || plot_file.present?
%>

<div class="page-head">
  <div class="page-head-line">
    <h1 class="section-title"><%= @job.name %> <span class="gradient-text job-state">· <%= @job.state %></span></h1>

    <%#
      The source previews used to ride here, on the title line. They now live in
      .source-stack at the foot of the page, BELOW the candidates and the
      proofs -- resolved in the page preamble, rendered in one vertical,
      bottom-aligned column. Nothing about the tiles changed but where they
      sit: the data-* contract, the self-hiding onerror and the favourite
      partials moved with them intact.
    %>
  </div>

  <div class="page-sub">
    <div class="page-sub-main">
      <div class="actions-row" style="margin:0;">
        <%= link_to "← All jobs", jobs_path, class: "btn btn-secondary btn-sm" %>
        <%= link_to "↻ Refresh", refresh_job_path(@job), class: "btn btn-secondary btn-sm" %>
      </div>
    </div>

    <div class="job-stats" aria-label="Run summary">
      <div class="job-stat"><div class="value"><%= cands.size %></div><div class="label">candidates</div></div>
      <div class="job-stat"><div class="value" style="color:var(--success)"><%= cands.count { |c| c["passed"] } %></div><div class="label">passed</div></div>
      <div class="job-stat"><div class="value" style="color:var(--danger)"><%= cands.sum { |c| c["hard"] } %></div><div class="label">hard</div></div>
    </div>
  </div>
</div>

<% if @job.error.present? %>
  <div class="flash alert mono"><%= @job.error %></div>
<% end %>

<% if running %>
  <div class="card card-glow" data-poll-url="<%= job_path(@job, format: :json) %>" data-poll-interval="2000">
    <% if @job.state == "queued" %>
      <h3><span class="spinner"></span>&nbsp; Queued…</h3>
      <p style="color:var(--text-secondary);margin:0.5rem 0 1rem;">
        waiting for its turn — the studio runs one job at a time. This page refreshes itself when it starts.
      </p>
    <% elsif @job.flux? && @job.runner_job_id.blank? %>
      <h3><span class="spinner"></span>&nbsp; Generating raster…</h3>
      <p style="color:var(--text-secondary);margin:0.5rem 0 1rem;">
        the FLUX box is drawing this. This page refreshes itself when the raster lands.
      </p>
    <% else %>
      <h3><span class="spinner"></span>&nbsp; Tracing candidates…</h3>
      <p style="color:var(--text-secondary);margin:0.5rem 0 1rem;">
        prep → trace sweep → compare. This page refreshes itself when candidates land.
      </p>
    <% end %>
    <div class="log-console" id="job-log"><pre>waiting for runner log…</pre></div>
  </div>
<% end %>


<% if @job.state == "done" && @job.comparison.is_a?(Hash) %>
  <%# 67 / 33. The candidates table is the work; the proof column is what you
      act on once you have read it. At full width the table spread so wide that
      the numbers lost their column and the one control that matters sat under
      a second full-width table. %>
  <div class="results-split">
  <div class="card results-main" style="padding:0;overflow:hidden;">
    <%# The viewer's playlist rides on this wrapper as an escaped data attribute
        (never a raw JSON script tag): every candidate in table order, so the
        popup can cycle with prev/next and ←/→. The SVG bytes are fetched on
        demand and inserted as text, never parsed as markup. Each entry carries
        its candidate's proof (if one exists for it), so the
        popup's Proof control can offer the download instead of a re-run.
        Built here rather than inline in the tag: a nested ternary inside a
        hash inside an ERB tag is unreadable and easy to break.
        Also carried: the job id, the validations path and a CSRF token, which
        is what lets the popup submit a real Proof form from JS. %>
    <%
      cc_playlist = cands.map do |c|
        pr = proof_by_file[c["file"]]
        { "file" => c["file"],
          "url" => file_job_path(@job, name: c["file"]),
          "proof" => pr && pr["proof"],
          "proof_url" => (pr ? file_job_path(@job, name: pr["proof"], download: 1) : nil) }
      end
    %>
    <div class="tbl-wrap" style="border:none;" id="cs-candidates"
         data-cs-job="<%= @job.id %>"
         data-cs-ref-source="<%= file_job_path(@job, name: "source.png") %>"
         data-cs-ref-inverse="<%= file_job_path(@job, name: inverse_name) %>"
         data-cs-proof-url="<%= validations_path %>"
         data-cs-csrf="<%= form_authenticity_token %>"
         data-cs-playlist="<%= JSON.generate(cc_playlist) %>">
      <table class="candidates">
        <thead>
          <tr>
            <th class="col-thumb">Preview</th>
            <th class="col-center">Preset</th>
            <th class="col-narrow col-center">Layer A</th>
            <th class="col-narrow col-center">Layer B</th>
            <%#
              There were three more columns here: Hard, Adv and Fidelity. All
              three now live in the row's detail popup (the "Findings & detail"
              button at the end of the row), which carries the fidelity verdict
              with all four of its numbers AND the Layer A / Layer B / hard /
              advisory line -- read from the same comparison entry, so the popup
              cannot disagree with a column that no longer exists.

              Fidelity was the one worth arguing for: "passed" only means no gate
              fired, and a bw/binary trace of a colour image discards the whole
              artwork and still comes back clean, so a candidate that threw the
              design away used to look identical to one that reproduced it. That
              argument is why the DOMINANT verdict is still one click away on
              every row rather than absent -- it is not a reason for a permanent
              column, and the column cost 100px of a table whose width is the
              work the operator is scanning.
            %>
            <th class="col-narrow" aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody>
          <% cands.each_with_index do |c, i| %>
            <% furl = file_job_path(@job, name: c["file"]) %>
            <% proof = proof_by_file[c["file"]] %>
            <tr class="rowlink" data-cs-view="svg" data-cs-url="<%= furl %>" data-cs-title="<%= c["file"] %>"
                data-cs-group="cs-candidates" data-cs-index="<%= i %>">
              <td class="col-thumb">
                <span class="thumb cand-thumb" title="<%= c["file"] %> — click to view, drag to favourite"
                      draggable="true" data-scrap-job="<%= @job.id %>" data-scrap-name="<%= c["file"] %>">
                  <img src="<%= furl %>" alt="<%= c["file"] %>" loading="lazy"
                       data-cs-view="svg" data-cs-url="<%= furl %>" data-cs-title="<%= c["file"] %>"
                       data-cs-group="cs-candidates" data-cs-index="<%= i %>"
                       onerror="this.parentNode.dataset.missing = '1'; this.dataset.broken = '1';">
                </span>
              </td>
              <td class="col-center"><span class="tech-tag"><%= c.dig("sweep", "preset") %></span></td>
              <td class="col-narrow col-center"><span class="status-pill status-<%= c.dig("layer_a", "status") %>"><%= c.dig("layer_a", "status") %></span></td>
              <td class="col-narrow col-center"><span class="status-pill status-<%= c.dig("layer_b", "status") %>"><%= c.dig("layer_b", "status") %></span></td>
              <td class="col-narrow">
                <div class="cs-row-actions">
                  <%= render "scrapbook/fav_button", job_id: @job.id, name: c["file"] %>
                  <%= link_to file_job_path(@job, name: c["file"], download: 1),
                        class: "btn btn-icon cs-job-download", title: "Download SVG",
                        download: c["file"], "aria-label" => "Download #{c["file"]}" do %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  <% end %>
                  <button type="button" class="btn btn-icon" data-cs-detail="<%= c["file"] %>"
                          title="Findings & detail" aria-label="Findings and detail for <%= c["file"] %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                  </button>
                  <% if proof %>
                    <%# The SAME width as the Proof button it replaces. That button
                        is `btn-sm` with a text label -- measured 82.0 x 32.0 --
                        and this was `btn-icon` at 32.0 x 32.0, so the column
                        changed width the moment a proof was generated and rows
                        with and without one sat at two different widths against
                        each other. Same class, same label, same 82px. The label
                        is what makes the download legible anyway: an icon-only
                        control here is the only way to fetch the proof, and
                        nothing on the row says so. %>
                    <%= link_to "PNG", file_job_path(@job, name: proof["proof"], download: 1),
                          class: "btn btn-secondary btn-sm cs-proof-btn cs-job-proof-download",
                          title: "Download proof PNG", download: proof["proof"],
                          "aria-label" => "Download proof PNG for #{c["file"]}" %>
                  <% else %>
                    <%# cs-proof-btn: the Proof button wears the sticky header's
                        DAMPED ring (0.62, like .logo-icon) instead of the
                        full-strength .btn-primary ring. A full-strength glow on
                        every un-proofed row made a column of beacons that
                        outshouted the one action the operator is scanning for. %>
                    <%= button_to "Proof", validations_path,
                          params: { job_id: @job.id, candidate_file: c["file"] },
                          class: "btn btn-primary btn-sm cs-proof-btn" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <aside class="results-side">
    <%#
      The proofs live HERE, in the second column, as a table you can read
      without clicking anything. It was a full-width table under the candidates,
      and then briefly a giant Proof button -- both of which hid the proofs
      themselves behind something else to look at. At 33% each row carries less
      than the old full-width one: the advisory count, the inks, the nodes, the
      dpi, the hard count and the findings are all one click away in that row's
      detail popup, so the row itself carries only what identifies a proof and
      where it got to -- its name, its render and its state.

      Jev is a button per row because jev_answers lives on the VALIDATION, not
      the job -- one job-level button would have had to pick a proof
      arbitrarily.
    %>
    <h3 class="results-side-head">Proofs</h3>
    <% if @validations.any? %>
      <div class="tbl-wrap results-side-tbl">
        <table class="candidates proofs-tbl">
          <thead><tr>
            <th class="col-thumb">Preview</th>
            <th>Proof</th>
            <th class="col-narrow col-center">State</th>
            <%# Hard was here too. It is in this row's detail popup with the
                advisory count, the inks, the nodes, the dpi and the findings
                themselves -- so the column was repeating a number you can reach
                in one click on the row, in a table that is already only a third
                of the width. State stays: it is what you scan for. %>
            <th class="col-narrow" aria-label="Actions"></th>
          </tr></thead>
          <tbody>
            <% @validations.each do |v| %>
              <%
                proof_png = v.manifest.is_a?(Hash) ? v.manifest["proof"] : nil
                proof_url = proof_png.present? ? file_job_path(@job, name: proof_png) : nil
                # Only a finished proof has a PNG to favourite, so only that
                # render is a drag-to-favourite source — the same condition the
                # star button uses.
                proof_drag = proof_url ? %( draggable="true" data-scrap-job="#{@job.id}" data-scrap-name="#{ERB::Util.html_escape(proof_png)}").html_safe : ""
              %>
              <%# The thumbnail and the name both open the proof page. They were
                  inert -- a <span> and a bare <td> -- so the column that
                  identifies a proof was the one part of the row you could not
                  click, and the only route to /proofs/:id was the detail popup's
                  "Open proof ->" buried inside it. Real <a> elements, like the
                  Jobs list's name and thumb: focusable, middle-clickable, and
                  working with JS off. %>
              <tr>
                <td class="col-thumb">
                  <a href="<%= validation_path(v) %>" title="<%= proof_name(v.file) %> — open the proof">
                    <span class="thumb cand-thumb"<%= proof_drag %><%= proof_url ? "" : " data-missing=\"1\"" %> title="<%= proof_name(v.file) %> — proof render">
                      <% if proof_url %>
                        <img src="<%= proof_url %>" alt="Proof render for <%= proof_name(v.file) %>" loading="lazy"
                             onerror="this.dataset.broken = '1';">
                      <% end %>
                    </span>
                  </a>
                </td>
                <td class="mono"><a class="cs-job-name" href="<%= validation_path(v) %>"><%= proof_name(v.file) %></a></td>
                <td class="col-narrow col-center"><span class="status-pill status-<%= v.state %>"><%= v.state %></span></td>
                <td class="col-narrow">
                  <div class="cs-row-actions">
                    <%# The detail popup carries what the narrow column gives up:
                        hard, advisory, inks, nodes, dpi, the findings themselves,
                        the clearances, and the links to the render, the PDF and
                        the full proof page. It is the only place these live, so
                        it is not an optional extra. %>
                    <% if proof_url %>
                      <%# The proof render PNG, downloadable straight from the row --
                          the same download the candidate row offers, so the proof
                          is not reachable only through the detail popup. %>
                      <%= link_to file_job_path(@job, name: proof_png, download: 1),
                            class: "btn btn-icon cs-job-download", title: "Download proof PNG",
                            download: proof_png, "aria-label" => "Download proof PNG for #{proof_name(v.file)}" do %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                      <% end %>
                    <% end %>
                    <button type="button" class="btn btn-icon" data-popup="proof-detail-<%= v.id %>"
                            title="Proof detail for <%= proof_label(v.file) %>"
                            aria-label="Proof detail for <%= proof_label(v.file) %>">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                    </button>
                    <%# Only a finished proof has a PNG to favourite. %>
                    <% if proof_url %>
                      <%= render "scrapbook/fav_button", job_id: @job.id, name: proof_png,
                                 label: proof_label(v.file) %>
                    <% end %>
                    <% if v.state == "done" %>
                      <%# has-answers is rendered server-side as well as added by
                          aether.js, so the green state survives a reload with
                          JS off -- and data-has-answers is what stops askJev()
                          firing on open. %>
                      <button type="button"
                              class="btn btn-primary btn-sm jev-btn<%= " has-answers" if v.jev_answers.present? %>"
                              data-popup="jev-popup-<%= v.id %>"
                              data-jev-url="<%= ask_jev_validation_path(v, format: :json) %>"
                              data-jev-csrf="<%= form_authenticity_token %>"
                              data-has-answers="<%= v.jev_answers.present? ? 1 : 0 %>"
                              title="Ask Jev about <%= proof_label(v.file) %>"
                              aria-label="Ask Jev about <%= proof_label(v.file) %>">Jev</button>
                    <% else %>
                      <span class="mono">–</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="results-side-note">No proofs yet — pick a candidate to prove it.</p>
    <% end %>
  </aside>
  </div>

  <p style="color:var(--text-tertiary);font-size:0.8rem;margin-top:0.75rem;">
    Sorted by fewest hard gates failed, then whether the trace kept the artwork, then fewest advisories.
    Fidelity is not a gate: a <code>bw</code> preset on a colour image discards the design and still passes every
    layer, so it is ranked and labelled rather than rejected — a single-colour job is a legitimate ask.
    Click a preview to eyeball the SVG full-size and step the sweep with ‹ ›. Each row's list icon opens that
    candidate's findings and metrics.
  </p>

  <%#
    One DETAIL popup per proof, whatever its state, ids proof-detail-<id>. It
    carries what the narrow column gives up: advisory, inks, nodes, dpi, the
    findings themselves, the clearances, and the links. Server-rendered rather
    than fetched, so opening it costs no request -- the same reasoning as the
    Jev dialog: the data is already in the page.
  %>
  <% @validations.each do |v| %>
    <% d = proof_detail(v) %>
  <%# The body lives in validations/_proof_detail so the Jobs LIST can open the
      same popup for a job's proof. %>
  <%= render "validations/proof_detail", d: d, job: @job %>
  <% end %>

  <%#
    One Jev dialog per FINISHED proof, ids jev-popup-<id>. When the proof
    already has answers they are pre-rendered into the dialog, so opening it
    shows the stored answer and askJev() is never called -- and if the POST is
    sent anyway (a reload in another tab, a hand-typed URL) ask_jev serves the
    stored answer without touching the runner.
  %>
  <% @validations.select { |v| v.state == "done" }.each do |v| %>
  <div class="popup" id="jev-popup-<%= v.id %>" role="dialog" aria-modal="true"
       aria-labelledby="jev-popup-<%= v.id %>-title" hidden>
    <div class="popup-panel">
      <header class="popup-head">
        <h2 id="jev-popup-<%= v.id %>-title">Jev <span class="mono">· <%= proof_label(v.file) %></span></h2>
        <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
      </header>
      <div class="popup-body" data-jev-body>
        <% if v.jev_answers.present? %>
          <%= render partial: "validations/jev_answers", locals: { validation: v } %>
        <% else %>
          <p class="popup-empty">
            Four typed advisory questions — dominant issue, next action, evidence
            quality, whether a human should eyeball the proof. Advisory only; the
            deterministic gates stay untouched.
          </p>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
<% end %>

<%#
  THE SOURCE STACK. All of it: the raster pair the run was built from (and, for
  an img2img edit, the reference that was piped in), a flux job's generated
  variations, and a plot job's drawn SVG -- ONE vertical, bottom-aligned column
  at the foot of the page, below the candidates and the proofs.

  Why it moved: as a 2x2 dock on the title line the pair pushed the heading
  aside, and the variations/plot cards sat directly above the candidates table,
  so the provenance was read before the run. The page now reads work first
  (candidates, then proofs) with the sources it came from underneath.

  Nothing about the tiles themselves changed. Every data-* attribute the
  popup, the viewer, the drag-to-favourite and the scrapbook partials depend on
  is the same, each favourite renders beside the same tile, and a preview whose
  file may legitimately be absent still self-removes on error. Only the
  position moved.
%>
<% if show_source_stack %>
<div class="source-stack" aria-label="Source previews">
  <% if ref_url %>
    <%# The img2img reference: the image that was piped in. It lives in
        storage/uploads, never on a runner, so it is served through the
        login-gated upload_preview route. %>
    <div class="pv-tile-wrap">
      <a class="pv-tile pv-tile-reference" href="<%= ref_url %>"
         data-cs-view="svg" data-cs-url="<%= ref_url %>"
         data-cs-title="<%= flux_ref %>"
         draggable="true" data-scrap-job="<%= @job.id %>" data-scrap-name="<%= flux_ref %>"
         data-cs-job="<%= @job.id %>" data-cs-name="<%= flux_ref %>" data-cs-fav-off="1"
         title="Reference image — the img2img source this was drawn from. Click to view, drag to favourite">
        <img src="<%= ref_url %>" alt="Reference image" loading="lazy"
             onerror="this.closest('.pv-tile').remove()">
        <span class="pv-label">ref</span>
      </a>
    </div>
  <% end %>

  <% if source_url %>
    <div class="pv-tile-wrap">
      <a class="pv-tile" href="<%= source_url %>"
         data-cs-view="svg" data-cs-url="<%= source_url %>"
         data-cs-title="<%= source_name %>"
         draggable="true" data-scrap-job="<%= @job.id %>" data-scrap-name="<%= source_name %>"
         data-cs-job="<%= @job.id %>" data-cs-name="<%= source_name %>"
         <% if source_local %>data-cs-fav-off="1"
         <% else %>data-cs-reuse-url="<%= reuse_job_path(@job) %>"
         <% end %><% if pair_prompt.present? %>data-cs-prompt="<%= pair_prompt %>" data-cs-flux-config="<%= pair_config %>"
         <% end %>title="<%= source_local ? "Generated raster (the deliverable)" : (flux ? "Generated raster handed to the pipeline" : "Source raster") %> — click to view, drag to favourite">
        <img src="<%= source_url %>" alt="<%= source_local ? "Generated raster" : "Source raster" %>" loading="lazy"
             onerror="this.closest('.pv-tile').remove()">
        <span class="pv-label">src</span>
      </a>
      <% unless source_local %>
        <%= render "scrapbook/fav_button", job_id: @job.id, name: source_name,
                   label: "source raster", css_class: "pv-fav fav-btn" %>
      <% end %>
    </div>
  <% end %>

  <% if twin_url %>
    <div class="pv-tile-wrap">
      <a class="pv-tile pv-tile-inverse" href="<%= twin_url %>"
         data-cs-view="svg" data-cs-url="<%= twin_url %>"
         data-cs-title="<%= twin_name %>"
         data-cs-job="<%= @job.id %>" data-cs-name="<%= twin_name %>"
         <% if inverse_local %>data-cs-fav-off="1"
         <% else %>data-cs-reuse-url="<%= reuse_job_path(@job) %>" data-cs-use-url="<%= use_inverse_job_path(@job) %>"
         <% end %>draggable="true" data-scrap-job="<%= @job.id %>" data-scrap-name="<%= twin_name %>"
         <% if pair_prompt.present? %>data-cs-prompt="<%= pair_prompt %>" data-cs-flux-config="<%= pair_config %>"
         <% end %>title="Colour-inverted twin — click to view, drag to favourite">
        <img src="<%= twin_url %>" alt="Colour-inverted twin" loading="lazy"
             onerror="this.closest('.pv-tile').remove()">
        <span class="pv-label">inv</span>
      </a>
      <% unless inverse_local %>
        <%= render "scrapbook/fav_button", job_id: @job.id, name: twin_name,
                   label: "colour-inverted source", css_class: "pv-fav fav-btn" %>
      <% end %>
    </div>
  <% end %>

  <%# The generated variations (a batch / triptych / swatch set, or a single
    raster-only deliverable), in the source stack below the proofs. Raster-only
    flux jobs have no candidates and no proofs, so this is the ONLY place their
    output is visible. A trace job with more than one variation shows its set
    here too. Each variation is a local upload, so the save button posts to
    save_upload rather than the runner-fetching favourite.

    flux_ref (the img2img reference: spec.flux.image, a basename in
    storage/uploads) is resolved once in the page preamble and used both here
    and by the raster-pair tiles above it in the same stack. Blank for a
    text-to-image generation, which is why the prompt/source reveal only offers
    a source on an edit. %>
  <% if show_variations %>
    <div class="card">
      <div class="card-head">
        <h3><%= variations.size > 1 ? "Variations" : "Generated raster" %></h3>
      </div>
      <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:1rem;">
        <% if variations.size > 1 %>
          One batched generation — a set of <%= variations.size %>. Each one is saveable to the scrapbook.
        <% else %>
          The generated raster, kept as the deliverable. Saveable to the scrapbook.
        <% end %>
      </p>
      <div class="variations-grid" aria-label="Flux variations">
        <% variations.each_with_index do |v, i| %>
          <%
            # The provenance of THIS variation, carried to the preview popup: the
            # prompt, whether it was an img2img edit (and from which reference),
            # the facts recorded for the render, and — as ONE JSON blob the popup
            # parses — the whole generation config, so the reveal is the complete
            # ask (model, size, steps, guidance, seed, images, mode and the two
            # parameters a model may or may not take) rather than the prompt
            # alone. A traced candidate has none of these, which is what keeps the
            # Prompt / Source toggle off the popups that have no prompt behind
            # them.
            vfacts = [v["model"], ("seed #{v["seed"]}" if v["seed"].present?),
                      ("#{v["width"]}×#{v["height"]}" if v["width"].present? && v["height"].present?),
                      ("#{v["seconds"]}s" if v["seconds"].present?)].compact.join(" · ")
            vconfig = JSON.generate(@job.flux_reveal_config(v))
          %>
          <div class="variation-tile">
            <%# data-cs-fav-off: the favourite in the popup is the runner-fetching
                star, and a generated raster has no runner file behind it — this
                tile is saved through scrapbook/save_upload (the button below)
                instead, so the popup must not offer a POST that would 502. %>
            <a href="<%= upload_preview_jobs_path(name: v["file"]) %>"
               data-cs-view="svg" data-cs-url="<%= upload_preview_jobs_path(name: v["file"]) %>"
               data-cs-title="<%= v["file"] %>"
               data-cs-job="<%= @job.id %>" data-cs-name="<%= v["file"] %>" data-cs-fav-off="1"
               data-cs-prompt="<%= @job.flux_prompt %>"
               data-cs-flux-config="<%= vconfig %>"
               <% if flux_ref.present? %>data-cs-prompt-source="<%= upload_preview_jobs_path(name: flux_ref) %>"
               <% end %><% if vfacts.present? %>data-cs-facts="<%= vfacts %>"
               <% end %>title="Variation <%= i + 1 %> — click to view full size">
              <img src="<%= upload_preview_jobs_path(name: v["file"]) %>" alt="Variation <%= i + 1 %>"
                   loading="lazy">
              <span class="variation-label"><%= i + 1 %></span>
            </a>
            <div class="variation-save">
              <%= button_to "Save to scrapbook", scrapbook_save_upload_path,
                    params: { name: v["file"], job_id: @job.id },
                    class: "btn btn-secondary btn-sm",
                    title: "Save variation #{i + 1} to the scrapbook" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# A plot job's deliverable, the last preview in the source stack: it has no
    candidates and no proofs -- the service draws one SVG and that IS the run --
    so this is the only place its output is visible. Served through the
    login-gated upload_preview route, exactly like a flux variation, never a new
    public path. %>
  <% if plot_file.present? %>
    <div class="card">
      <div class="card-head">
        <h3>Plot output</h3>
      </div>
      <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:1rem;">
        Drawn by the <span class="mono">plot</span> service — operation
        <span class="mono"><%= @job.plot_op %></span>. The SVG is the deliverable.
      </p>
      <div class="variations-grid" aria-label="Plot output">
        <div class="variation-tile">
          <a href="<%= upload_preview_jobs_path(name: plot_file) %>"
             data-cs-view="svg" data-cs-url="<%= upload_preview_jobs_path(name: plot_file) %>"
             data-cs-title="<%= plot_file %>"
             title="Plot output — click to view full size">
            <img src="<%= upload_preview_jobs_path(name: plot_file) %>"
                 alt="Plot output SVG" loading="lazy">
            <span class="variation-label">svg</span>
          </a>
          <div class="variation-save">
            <%= link_to "Download SVG", upload_preview_jobs_path(name: plot_file),
                  class: "btn btn-secondary btn-sm", download: plot_file,
                  title: "Download the drawn SVG" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
<% end %>

<script>
  document.addEventListener('click', function (e) {
    var row = e.target.closest('tr.rowlink');
    if (row && row.dataset.href && !e.target.closest('form, a, button')) window.location = row.dataset.href;
  });

  (function () {
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function detailHtml(data) {
      var fh = data.sweep || {};
      var bh = data.proof || null;
      var sw = fh.sweep || {};
      var f = fh.fidelity || {};
      var h = '<div class="cs-findings-head mono">' + esc(data.file || '') + '</div>';

      // Fidelity first, and BEFORE the proof check: the verdict and the numbers
      // come from the comparison entry (fh), not from a proof, so they exist for
      // every candidate -- including the ones with no proof yet.
      h += '<h4 class="cs-detail-h">Fidelity</h4>';
      h += '<div class="cs-fidelity">'
        + '<span class="status-pill status-' + esc(fh.fidelity_status || 'pending') + '">'
        + esc(String(fh.fidelity_verdict || 'unmeasured').replace(/_/g, ' ')) + '</span>'
        + '<div class="cs-metrics">';
      [['MAE all', f.mae], ['MAE art', f.mae_art], ['P95', f.p95], ['within 10', f.within_10]]
        .forEach(function (r) {
          h += '<div class="cs-metric"><span>' + esc(r[0]) + '</span><b class="mono">' + esc(r[1]) + '</b></div>';
        });
      h += '</div></div>';

      h += '<h4 class="cs-detail-h">Findings</h4>';
      var findings = (bh && bh.findings) || [];
      if (findings.length) {
        h += '<div class="cs-findings">';
        findings.forEach(function (x) {
          var hard = x.severity === 'hard';
          h += '<div class="cs-finding">'
            + '<span class="cs-finding-rule mono">' + esc(x.rule || '') + '</span>'
            + '<span class="cs-finding-sev ' + (hard ? 'hard' : 'adv') + '">' + esc(x.severity || '') + '</span>'
            + '<span class="cs-finding-layer mono">' + (x.layer ? 'L' + esc(x.layer) : '') + '</span>'
            + '<div class="cs-finding-detail">' + esc(x.detail || '') + '</div>'
            + '</div>';
        });
        h += '</div>';
      } else {
        var la = (fh.layer_a || {}).status || '–';
        var lb = (fh.layer_b || {}).status || '–';
        h += '<p style="color:var(--text-secondary);margin:0;">No proof yet. Trace gates: '
          + 'Layer A <b>' + esc(la) + '</b> · Layer B <b>' + esc(lb) + '</b> · '
          + 'hard <b>' + (fh.hard || 0) + '</b> · advisory <b>' + (fh.advisory || 0) + '</b>.</p>';
      }

      h += '<h4 class="cs-detail-h">Metrics</h4>';
      var rows = [
        ['preset', sw.preset], ['speckle', sw.filter_speckle], ['hierarchical', sw.hierarchical],
        ['variant', sw.variant || 'source'], ['palette', sw.use_palette ? 'y' : '–'],
        ['nodes', fh.node_count_total], ['size', fh.file_size], ['inks', fh.rendered_ink_colors]
      ];
      h += '<div class="cs-metrics">';
      rows.forEach(function (r) {
        h += '<div class="cs-metric"><span>' + esc(r[0]) + '</span><b class="mono">' + esc(r[1]) + '</b></div>';
      });
      h += '</div>';

      h += '<details class="cs-detail-raw"><summary class="mono">Raw data</summary>'
        + '<div class="log-console" style="margin:0.6rem 0 0;"><pre>'
        + esc(JSON.stringify({ sweep: fh, proof: bh }, null, 2))
        + '</pre></div></details>';
      return h;
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-cs-detail]');
      if (!btn || !window.CsModal) return;
      var file = btn.getAttribute('data-cs-detail');
      window.CsModal.open('Findings — ' + file,
        '<div class="log-console" style="margin:0;max-height:none;"><pre id="csDetailPre">loading…</pre></div>');
      fetch('<%= job_path(@job, format: :json) %>?candidate=' + encodeURIComponent(file),
            { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var body = document.getElementById('csModalBody');
          if (body) body.innerHTML = detailHtml(data);
        })
        .catch(function () {
          var pre = document.getElementById('csDetailPre');
          if (pre) pre.textContent = 'Could not load detail.';
        });
    });
  })();
</script>
