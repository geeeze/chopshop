<%
  running = Job::IN_FLIGHT_STATES.include?(@job.state)
  cands = @job.comparison.is_a?(Hash) ? Array(@job.comparison["candidates"]) : []
  pitch_shift = @job.spec.is_a?(Hash) && @job.spec.dig("print", "pitch_shift")
  # per-candidate done validation, keyed by file, for proof links in the rows
  proof_by_file = @job.validations.select { |v| v.state == "done" }
                        .each_with_object({}) do |v, h|
    h[v.file] = v.manifest if v.manifest.is_a?(Hash) && v.manifest["proof"].present?
  end
%>

<div class="page-head">
  <div class="job-head">
    <div class="job-head-main" style="min-width:0;">
      <h1 class="section-title"><%= @job.name %> <span class="gradient-text">· <%= @job.state %></span></h1>
      <div class="actions-row" style="margin:0.5rem 0 0;">
        <%= link_to "↻ Refresh", refresh_job_path(@job), class: "btn btn-secondary btn-sm" %>
        <%= link_to "← All jobs", jobs_path, class: "btn btn-secondary btn-sm" %>
        <% if @job.state == "done" %>
          <button type="button" class="btn btn-secondary btn-sm" id="csLogBtn">Log</button>
        <% end %>
      </div>
    </div>

    <div class="job-stats" aria-label="Run summary">
      <div class="job-stat"><div class="value"><%= cands.size %></div><div class="label">candidates</div></div>
      <div class="job-stat"><div class="value" style="color:var(--success)"><%= cands.count { |c| c["passed"] } %></div><div class="label">passed</div></div>
      <div class="job-stat"><div class="value" style="color:var(--danger)"><%= cands.sum { |c| c["hard"] } %></div><div class="label">hard</div></div>
    </div>

    <%
      # Source tile + its colour-inverted twin. The twin is produced at prep
      # time (print.invert on the real pipeline; always in the mock). It is a
      # DERIVED artefact and legitimately absent for vector jobs or old runs.
      # The img self-hides on error, so a missing twin collapses the tile
      # rather than showing a broken image. Candidate previews do NOT live here
      # (they cluttered the header); this row is the source pair only.
      #
      # Both tiles open in the site popup (blurred glass backdrop), not a new
      # tab: `data-cs-view` without a `data-cs-group` takes the plain-image
      # branch of the viewer. The href stays as the no-JS / middle-click
      # fallback. See wireViewers() in aether.js.
      inverse_name = "source.inverse.png"
    %>
    <div class="preview-grid" aria-label="Previews">
      <a class="pv-tile" href="<%= file_job_path(@job, name: "source.png") %>"
         data-cs-view="svg" data-cs-url="<%= file_job_path(@job, name: "source.png") %>"
         data-cs-title="source.png"
         title="Source raster — click to view">
        <img src="<%= file_job_path(@job, name: "source.png") %>" alt="Source raster" loading="lazy"
             onerror="this.closest('.pv-tile').remove()">
        <span class="pv-label">src</span>
      </a>
      <a class="pv-tile pv-tile-inverse" href="<%= file_job_path(@job, name: inverse_name) %>"
         data-cs-view="svg" data-cs-url="<%= file_job_path(@job, name: inverse_name) %>"
         data-cs-title="<%= inverse_name %>"
         title="Colour-inverted source (prep twin) — click to view">
        <img src="<%= file_job_path(@job, name: inverse_name) %>" alt="Colour-inverted source" loading="lazy"
             onerror="this.closest('.pv-tile').remove()">
        <span class="pv-label">inv</span>
      </a>
    </div>
  </div>
</div>

<% if @job.error.present? %>
  <div class="flash alert mono"><%= @job.error %></div>
<% end %>

<% if running %>
  <div class="card card-glow" data-poll-url="<%= job_path(@job, format: :json) %>" data-poll-interval="2000">
    <h3><span class="spinner"></span>&nbsp; Front half is running…</h3>
    <p style="color:var(--text-secondary);margin:0.5rem 0 1rem;">
      prep → trace sweep → compare. This page refreshes itself when candidates land.
    </p>
    <div class="log-console" id="job-log"><pre>waiting for runner log…</pre></div>
  </div>
<% end %>

<% if @job.state == "done" && @job.comparison.is_a?(Hash) %>
  <div class="card" style="padding:0;overflow:hidden;">
    <%# The viewer's playlist rides on this wrapper as an escaped data attribute
        (never a raw JSON script tag): every candidate in table order, so the
        popup can cycle with prev/next and ←/→. The SVG bytes are fetched on
        demand and inserted as text, never parsed as markup. Each entry carries
        its candidate's proof (if the back half has already run on it), so the
        popup's Proof control can offer the download instead of a re-run.
        Built here rather than inline in the tag: a nested ternary inside a
        hash inside an ERB tag is unreadable and easy to break.
        Also carried: the job id, the validations path and a CSRF token, which
        is what lets the popup submit a real Proof form from JS. %>
    <%
      cc_playlist = cands.map do |c|
        pr = proof_by_file[c["file"]]
        { "file" => c["file"],
          "url" => file_job_path(@job, name: c["file"]),
          "proof" => pr && pr["proof"],
          "proof_url" => (pr ? file_job_path(@job, name: pr["proof"], download: 1) : nil) }
      end
    %>
    <div class="tbl-wrap" style="border:none;" id="cs-candidates"
         data-cs-job="<%= @job.id %>"
         data-cs-proof-url="<%= validations_path %>"
         data-cs-csrf="<%= form_authenticity_token %>"
         data-cs-playlist="<%= JSON.generate(cc_playlist) %>">
      <table class="candidates">
        <thead>
          <tr>
            <th class="col-thumb">Preview</th>
            <th>Preset</th>
            <th class="col-narrow">Layer A</th>
            <th class="col-narrow">Layer B</th>
            <th class="col-narrow">Hard</th>
            <th class="col-narrow">Adv</th>
            <th class="col-narrow">Palette</th>
            <th class="col-narrow" title="Did the trace keep the design? Artwork MAE compares the render against the source on the artwork pixels only.">Fidelity</th>
            <th class="col-narrow" aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody>
          <% cands.each_with_index do |c, i| %>
            <% furl = file_job_path(@job, name: c["file"]) %>
            <% proof = proof_by_file[c["file"]] %>
            <tr class="rowlink" data-cs-view="svg" data-cs-url="<%= furl %>" data-cs-title="<%= c["file"] %>"
                data-cs-group="cs-candidates" data-cs-index="<%= i %>">
              <td class="col-thumb">
                <span class="thumb cand-thumb" title="<%= c["file"] %> — click to view">
                  <img src="<%= furl %>" alt="<%= c["file"] %>" loading="lazy"
                       data-cs-view="svg" data-cs-url="<%= furl %>" data-cs-title="<%= c["file"] %>"
                       data-cs-group="cs-candidates" data-cs-index="<%= i %>"
                       onerror="this.parentNode.dataset.missing = '1'; this.dataset.broken = '1';">
                </span>
              </td>
              <td><span class="tech-tag"><%= c.dig("sweep", "preset") %></span></td>
              <td class="col-narrow"><span class="status-pill status-<%= c.dig("layer_a", "status") %>"><%= c.dig("layer_a", "status") %></span></td>
              <td class="col-narrow"><span class="status-pill status-<%= c.dig("layer_b", "status") %>"><%= c.dig("layer_b", "status") %></span></td>
              <td class="col-narrow mono" style="color:var(--danger)"><%= c["hard"] %></td>
              <td class="col-narrow mono" style="color:var(--warning)"><%= c["advisory"] %></td>
              <td class="col-narrow">
                <% if pitch_shift %>
                  <span class="tech-tag"><%= c.dig("sweep", "variant").presence || "source" %></span>
                <% else %>
                  <span class="mono"><%= c.dig("sweep", "use_palette") ? "palette" : "–" %></span>
                <% end %>
              </td>
              <%#
                Fidelity, and specifically whether the trace kept the design.
                "passed" only means no gate fired: a bw/binary trace of a colour
                image discards the whole artwork and still comes back clean, so
                without this column a candidate that threw the design away looks
                identical to one that reproduced it.
              %>
              <% fv = c["fidelity_verdict"] || "faithful" %>
              <% fr = c["fidelity_reason"] %>
              <% mae_art = (c["fidelity"] || {})["mae_art"] %>
              <td class="col-narrow" title="<%= fr %>">
                <span class="status-pill status-<%= fv == "faithful" ? "pass" : (fv == "drift" ? "warn" : "fail") %>"><%= fv.tr("_", " ") %></span>
                <% if mae_art %>
                  <div class="mono fid-mae"><%= mae_art %></div>
                <% end %>
              </td>
              <td class="col-narrow">
                <div class="cs-row-actions">
                  <%= link_to file_job_path(@job, name: c["file"], download: 1),
                        class: "btn btn-icon cs-job-download", title: "Download SVG",
                        download: c["file"], "aria-label" => "Download #{c["file"]}" do %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  <% end %>
                  <button type="button" class="btn btn-icon" data-cs-detail="<%= c["file"] %>"
                          title="Findings & detail" aria-label="Findings and detail for <%= c["file"] %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                  </button>
                  <% if proof %>
                    <%= link_to file_job_path(@job, name: proof["proof"], download: 1),
                          class: "btn btn-icon cs-job-proof", title: "Download proof PNG",
                          download: proof["proof"], "aria-label" => "Download proof for #{c["file"]}" do %>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <% end %>
                  <% else %>
                    <%= button_to "Proof", validations_path,
                          params: { job_id: @job.id, candidate_file: c["file"] },
                          class: "btn btn-primary btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <p style="color:var(--text-tertiary);font-size:0.8rem;margin-top:0.75rem;">
    Sorted by fewest hard gates failed, then whether the trace kept the artwork, then fewest advisories.
    Fidelity is not a gate: a <code>bw</code> preset on a colour image discards the design and still passes every
    layer, so it is ranked and labelled rather than rejected — a single-colour job is a legitimate ask.
    Click a preview to eyeball the SVG full-size and step the sweep with ‹ ›. Each row's list icon opens that
    candidate's findings and metrics.
  </p>

  <% if @validations.any? %>
    <h3 style="margin-top:var(--space-lg);">Back-half runs on this job</h3>
    <div class="tbl-wrap" style="margin-top:0.75rem;">
      <table class="candidates">
        <thead><tr><th class="col-thumb">Preview</th><th>Validation</th><th>Candidate</th><th>State</th><th>Hard</th><th>Advisory</th><th>Jev</th></tr></thead>
        <tbody>
          <% @validations.each do |v| %>
            <%
              # Proof PNG from the back-half manifest; nil for pending/running
              # runs or a manifest that has not produced one yet.
              proof_name = v.manifest.is_a?(Hash) ? v.manifest["proof"] : nil
              proof_url = proof_name.present? ? file_job_path(@job, name: proof_name) : nil
            %>
            <tr class="rowlink" data-href="<%= validation_path(v) %>">
              <td class="col-thumb">
                <span class="thumb cand-thumb"<%= proof_url ? "" : " data-missing=\"1\"" %> title="<%= v.file %> — proof render">
                  <% if proof_url %>
                    <img src="<%= proof_url %>" alt="Proof render for <%= v.file %>" loading="lazy"
                         onerror="this.dataset.broken = '1';">
                  <% end %>
                </span>
              </td>
              <td class="mono">#<%= v.id %></td>
              <td class="mono"><%= v.file %></td>
              <td><span class="status-pill status-<%= v.state %>"><%= v.state %></span></td>
              <td class="mono"><%= v.manifest.is_a?(Hash) ? v.manifest.dig("summary", "hard") : "–" %></td>
              <td class="mono"><%= v.manifest.is_a?(Hash) ? v.manifest.dig("summary", "advisory") : "–" %></td>
              <td class="mono"><%= v.jev_answers.present? ? "✓" : "–" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<script>
  document.addEventListener('click', function (e) {
    var row = e.target.closest('tr.rowlink');
    if (row && row.dataset.href && !e.target.closest('form, a, button')) window.location = row.dataset.href;
  });

  (function () {
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function detailHtml(data) {
      var fh = data.front_half || {};
      var bh = data.back_half || null;
      var sw = fh.sweep || {};
      var f = fh.fidelity || {};
      var h = '<div class="cs-findings-head mono">' + esc(data.file || '') + '</div>';

      h += '<h4 class="cs-detail-h">Findings</h4>';
      var findings = (bh && bh.findings) || [];
      if (findings.length) {
        h += '<div class="cs-findings">';
        findings.forEach(function (x) {
          var hard = x.severity === 'hard';
          h += '<div class="cs-finding">'
            + '<span class="cs-finding-rule mono">' + esc(x.rule || '') + '</span>'
            + '<span class="cs-finding-sev ' + (hard ? 'hard' : 'adv') + '">' + esc(x.severity || '') + '</span>'
            + '<span class="cs-finding-layer mono">' + (x.layer ? 'L' + esc(x.layer) : '') + '</span>'
            + '<div class="cs-finding-detail">' + esc(x.detail || '') + '</div>'
            + '</div>';
        });
        h += '</div>';
      } else {
        var la = (fh.layer_a || {}).status || '–';
        var lb = (fh.layer_b || {}).status || '–';
        h += '<p style="color:var(--text-secondary);margin:0;">No back-half run yet. Front-half gates: '
          + 'Layer A <b>' + esc(la) + '</b> · Layer B <b>' + esc(lb) + '</b> · '
          + 'hard <b>' + (fh.hard || 0) + '</b> · advisory <b>' + (fh.advisory || 0) + '</b>.</p>';
      }

      h += '<h4 class="cs-detail-h">Metrics</h4>';
      var rows = [
        ['preset', sw.preset], ['speckle', sw.filter_speckle], ['hierarchical', sw.hierarchical],
        ['variant', sw.variant || 'source'], ['palette', sw.use_palette ? 'y' : '–'],
        ['MAE all', f.mae], ['MAE art', f.mae_art], ['P95', f.p95], ['within 10', f.within_10],
        ['nodes', fh.node_count_total], ['size', fh.file_size], ['inks', fh.rendered_ink_colors]
      ];
      h += '<div class="cs-metrics">';
      rows.forEach(function (r) {
        h += '<div class="cs-metric"><span>' + esc(r[0]) + '</span><b class="mono">' + esc(r[1]) + '</b></div>';
      });
      h += '</div>';

      h += '<details class="cs-detail-raw"><summary class="mono">Raw data</summary>'
        + '<div class="log-console" style="margin:0.6rem 0 0;"><pre>'
        + esc(JSON.stringify({ front_half: fh, back_half: bh }, null, 2))
        + '</pre></div></details>';
      return h;
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-cs-detail]');
      if (!btn || !window.CsModal) return;
      var file = btn.getAttribute('data-cs-detail');
      window.CsModal.open('Findings — ' + file,
        '<div class="log-console" style="margin:0;max-height:none;"><pre id="csDetailPre">loading…</pre></div>');
      fetch('<%= job_path(@job, format: :json) %>?candidate=' + encodeURIComponent(file),
            { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var body = document.getElementById('csModalBody');
          if (body) body.innerHTML = detailHtml(data);
        })
        .catch(function () {
          var pre = document.getElementById('csDetailPre');
          if (pre) pre.textContent = 'Could not load detail.';
        });
    });

    var logBtn = document.getElementById('csLogBtn');
    if (logBtn) logBtn.addEventListener('click', function () {
      if (!window.CsModal) return;
      window.CsModal.open('Runner log',
        '<div class="log-console" style="margin:0;max-height:none;"><pre id="csLogPre">loading…</pre></div>');
      fetch('<%= job_path(@job, format: :json) %>?log=1', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var pre = document.getElementById('csLogPre');
          if (!pre) return;
          pre.textContent = (data.log || []).join('\n') || '(no log captured)';
          // The snapshot is a tail, so land on the newest lines. The console in
          // here has max-height:none — the modal BODY is the scroller — so pin
          // that, not the console, and the operator can scroll up freely.
          var scroller = document.getElementById('csModalBody');
          if (scroller) scroller.scrollTop = scroller.scrollHeight;
        })
        .catch(function () {
          var pre = document.getElementById('csLogPre');
          if (pre) pre.textContent = 'Could not load the log.';
        });
    });
  })();
</script>
