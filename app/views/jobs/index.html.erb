<div class="page-head">
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">Jobs</span></h1>
    <%= link_to "Run Job", new_job_path, class: "btn btn-primary head-action" %>

  <p class="page-head-blurb page-head-blurb--long">Every run traces a raster into candidates, measures printability and pixel fidelity, then waits for you to pick. Nothing advances on its own — the trace stage stops at the menu, because choosing which candidate goes to final is a visual call a machine has no business making for you.</p>
  </div></div>

<% if @jobs.any? %>
  <div class="tbl-wrap tbl-wrap--narrow">
    <table class="candidates">
      <thead>
        <tr>
          <th class="col-thumb">Preview</th>
          <th>Name</th>
          <th>State</th>
          <th>Passed</th>
          <th>Runner</th>
          <th>Queued</th>
          <th class="col-narrow" aria-label="Actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @jobs.each do |job| %>
          <tr class="rowlink" data-href="<%= job_path(job) %>">
            <td class="col-thumb">
              <%# The runner writes the prepped raster as source.png inside the job
                  dir, so the existing file proxy serves it like any other artifact.
                  It does not exist until prep has run, so the cell degrades to the
                  matte-grey scissor placeholder rather than a broken-image icon —
                  and never hides the row. %>
              <%# A real <a>, not just the row's JS data-href: the thumbnail has
                  to be focusable, followable with the keyboard, and open in a
                  new tab on middle-click. It points at the PROOF result page
                  where there is one, and at the job itself otherwise, so it is
                  never a dead cell. %>
              <a class="thumb job-thumb" href="<%= job_proof_path(job) %>"
                 title="<%= job.name %> — open the proof result">
                <span class="thumb" title="<%= job.name %> — source raster">
                  <img src="<%= file_job_path(job, name: "source.png") %>" alt="Source raster preview for <%= job.name %>"
                       loading="lazy" onerror="this.parentNode.dataset.missing = '1'; this.remove();">
                </span>
              </a>
            </td>
            <td><a class="cs-job-name" href="<%= job_proof_path(job) %>"><strong><%= job.name %></strong></a></td>
            <td><span class="status-pill status-<%= job.state %>"><%= job.state %></span></td>
            <td class="mono" style="color:var(--success)"><%= job.passed_count %></td>
            <td class="mono"><%= job.runner %></td>
            <td class="mono" style="color:var(--text-tertiary)"><%= job.created_at.strftime("%b %d %H:%M") %></td>
            <td class="col-narrow">
              <div class="cs-row-actions">
                <% if job.state == "done" %>
                  <%= link_to "⬇", download_job_path(job),
                        class: "btn btn-icon cs-job-download", title: "Download 7z",
                        "aria-label" => "Download #{job.name}" %>
                <% end %>
                <% if job.in_flight? %>
                  <button type="button" class="btn btn-icon cs-job-action cs-job-cancel"
                          data-cs-job-action="cancel" data-url="<%= cancel_job_path(job) %>"
                          data-name="<%= job.name %>" title="Cancel" aria-label="Cancel <%= job.name %>">✕</button>
                <% else %>
                  <button type="button" class="btn btn-icon cs-job-action cs-job-delete"
                          data-cs-job-action="delete" data-url="<%= job_path(job) %>"
                          data-name="<%= job.name %>" title="Delete" aria-label="Delete <%= job.name %>">✕</button>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card empty-state">
    <p>No runs yet. Feed it a raster to get started.</p>
  </div>
<% end %>

<script>
  document.addEventListener('click', function (e) {
    if (e.target.closest('a,button,form,input,select,textarea')) return;
    var row = e.target.closest('tr.rowlink');
    if (row) window.location = row.dataset.href;
  });
</script>
