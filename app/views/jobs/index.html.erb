<div class="page-head">
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title"><span class="gradient-text">Jobs</span></h1>
    <%= link_to "Run Job", new_job_path, class: "btn btn-primary head-action" %>

  <p class="page-head-blurb page-head-blurb--long">Every run traces a raster into candidates, measures printability and pixel fidelity, then waits for you to pick. Nothing advances on its own — the trace stage stops at the menu, because choosing which candidate goes to final is a visual call a machine has no business making for you.</p>
  </div></div>

<% if @jobs.any? %>
  <div class="tbl-wrap tbl-wrap--narrow">
    <table class="candidates">
      <thead>
        <tr>
          <th class="col-thumb">Preview</th>
          <th>Name</th>
          <th class="col-center">State</th>
          <th class="col-center">Passed</th>
          <th class="col-center">Runner</th>
          <th class="col-narrow" aria-label="Actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @jobs.each do |job| %>
          <tr class="rowlink" data-href="<%= job_path(job) %>">
            <td class="col-thumb">
              <%# Which file previews the row is the model's call (Job#preview_file
                  / #preview_from_upload?): the TOP CANDIDATE when the run has
                  one, served like any other runner artifact through the file
                  proxy -- that is the result the operator is being asked to
                  pick. Only a run with no candidates falls back to the drawn SVG
                  (plot), the generated raster (flux), or the runner's source.png
                  (a pipeline job before its sweep lands). A file that is not
                  there yet degrades to the matte-grey scissor placeholder rather
                  than a broken-image icon -- and never hides the row. %>
              <%# A real <a>, not just the row's JS data-href: the thumbnail has
                  to be focusable, followable with the keyboard, and open in a
                  new tab on middle-click. It points at the JOB, which is also
                  what the row's data-href says -- they used to disagree, with
                  the name and thumb going to the proof while the row went to
                  the job, so clicking the name took you somewhere other than
                  the thing it is named after. One destination per row; the
                  proof is reached from the job. %>
              <a class="thumb job-thumb" href="<%= job_path(job) %>"
                 title="<%= job.name %> — open the job">
                <span class="thumb" title="<%= job.name %> — preview">
                  <% if job.preview_file.present? %>
                    <img src="<%= job.preview_from_upload? ? upload_preview_jobs_path(name: job.preview_file) : file_job_path(job, name: job.preview_file) %>"
                         alt="Preview for <%= job.name %>"
                         loading="lazy" onerror="this.parentNode.dataset.missing = '1'; this.remove();">
                  <% end %>
                </span>
              </a>
            </td>
            <td><a class="cs-job-name" href="<%= job_path(job) %>"><strong><%= job.name %></strong></a></td>
            <td class="col-center"><span class="status-pill status-<%= job.state %>"><%= job.state %></span></td>
            <td class="col-center mono" style="color:var(--success)"><%= job.passed_count %></td>
            <td class="col-center mono"><%= job.runner %></td>
            <td class="col-narrow">
              <div class="cs-row-actions">
                <% if job.state == "done" %>
                  <%# Same button the Proof control was, pointed at the archive.
                      The box was always 32x32, but the Proof control drew a
                      14x14 inline SVG while this one used a TEXT glyph -- U+1F5AB,
                      which Press Start 2P does not contain, so it silently fell
                      back to another font and drew at a different visual size
                      inside the same 32px box. Twelve rows of that reads as a
                      broken column. An inline SVG cannot fall back, so it is
                      what the Proof button had and what this one gets. %>
                  <%= link_to download_job_path(job),
                        class: "btn btn-icon cs-job-download", title: "Download 7z",
                        "aria-label" => "Download #{job.name}" do %><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg><% end %>
                <% end %>
                <% if job.in_flight? %>
                  <button type="button" class="btn btn-icon cs-job-action cs-job-cancel"
                          data-cs-job-action="cancel" data-url="<%= cancel_job_path(job) %>"
                          data-name="<%= job.name %>" title="Cancel" aria-label="Cancel <%= job.name %>">✕</button>
                <% else %>
                  <button type="button" class="btn btn-icon cs-job-action cs-job-delete"
                          data-cs-job-action="delete" data-url="<%= job_path(job) %>"
                          data-name="<%= job.name %>" title="Delete" aria-label="Delete <%= job.name %>">✕</button>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card empty-state">
    <p>No runs yet. Feed it a raster to get started.</p>
  </div>
<% end %>

<script>
  document.addEventListener('click', function (e) {
    if (e.target.closest('a,button,form,input,select,textarea')) return;
    var row = e.target.closest('tr.rowlink');
    if (row) window.location = row.dataset.href;
  });
</script>
