<div class="page-head">
  <div class="page-head-row page-head-row--split page-head-row--stacked">
    <h1 class="section-title">Run <span class="gradient-text">Job</span></h1>
    <%# The run action lives in the page head, top right, in the same slot and at
        the same size as the "Run Job" button on the Jobs list. It was down
        on the artwork tile's line, where it read as a third control on that row
        instead of as the thing that starts the job.

        Here it RUNS the job rather than navigating: on the Jobs list this button
        opens this page, and on this page it is the same button's other half. It
        is a type="button" outside the <form> on purpose, so it can ask first
        and only then submit. %>
    <button type="button" class="btn btn-primary head-action head-action--top" id="runJobBtn"
            title="Run Job" aria-label="Run Job">Run Job</button>
    <%# Compose sits under Run Job, like the JSON button on the JSON page: the
        composite builder is a page you reach from here, not a header listing. %>
    <%= link_to "Compose", new_composite_path,
          class: "btn btn-secondary head-action head-action--below",
          title: "Build a composite from scrapbook pieces, sources or a blank slate",
          aria: { label: "Compose a composite" } %>
    <p class="page-head-blurb" id="runIntro">
      <span data-run-intro="svg">Upload a raster. It gets prepped, VTracer sweeps across the presets you choose, and every candidate is compared through both gates.</span>
      <span data-run-intro="flux" hidden>Describe an image. The FLUX service generates it, and that raster becomes this job's source — or the deliverable itself, if you stop at the image.</span>
      <span data-run-intro="plot" hidden>Paste a document. The plot service draws it — geometry, a metrics digest or a cross-run query — and the SVG it answers with is this job's deliverable.</span>
      <span data-run-intro="blender" hidden>Paste a scene. The blender operation renders it in 3D — the geometry document, its views and its export are the request — and the frame it answers with (or the set of frames) is this job's deliverable.</span>
      <span data-run-intro="bp" hidden>Paste a document and pick the operation. The blend-plot service draws it — geometry, a metrics chart, a cross-run query, a tree or a timeline — or renders it in 3D, and what it answers with is this job's deliverable.</span>
    </p>
  </div>
</div>

<%# The form card and the job contract are two half-width columns. The contract
    was a COLLAPSED accordion inside the form (display:none), so the one thing
    that configures the run was hidden behind a toggle; it is a permanent,
    always-visible column beside the form now, where it is read and edited
    side by side with the job it configures. %>
<%= form_with model: @job, local: true, id: "new-job-form" do |f| %>
<%# ====== PROJECT: which project this run belongs to. A project-less job is
    listed NOWHERE under the Projects workspace (the redesign's one jobs
    surface is the per-project page), so the form ASKS instead of silently
    filing an invisible one. The select lists the operator's own projects;
    "Create a new project…" reveals a name input and jobs#create makes the
    project (owner stamped, is_test false) before filing the run under it.

    A real select where the hidden project_id field used to sit, because the
    prompt is the point: every Run Job entry lands on THIS form — the JSON
    page's spec hand-off (json/use -> new_job_path), the FLUX/JEV/BP head
    buttons (plain new_job_path links), the workspace's own (preselected
    below). Required while nothing is preselected, so a browser blocks a
    blank submit; jobs#create refuses it for HTML even then, and re-renders
    with the picker intact (assign_form_context). %>
<div class="field project-field" data-project-picker>
  <label for="job_project_id">Project</label>
  <div class="tpl-row">
    <% picker = @owned_projects.map { |p| [p.name, p.id.to_s] }
       picker << ["\u2795 Create a new project\u2026", "__new__"] %>
    <%= f.select :project_id, options_for_select(picker, @job.project_id.to_s),
                 { include_blank: @job.project_id.present? ? nil : "Choose a project\u2026" },
                 class: "form-control", id: "job_project_id",
                 data: { project_picker_select: true },
                 required: @job.project_id.blank? %>
    <%= text_field_tag "job[project_name]", nil, class: "form-control",
                       placeholder: "New project name", id: "job_project_name",
                       hidden: @job.project_id.present?,
                       data: { project_picker_name: true } %>
  </div>
</div>
<script>
  // The reveal: "Create a new project…" shows the name input and makes it
  // required; anything else hides it and clears it. Direct binding is enough
  // — the form is a whole page, not a turbo frame — and the data flag guards
  // a double include. Without JS the select still posts a real project_id;
  // only the new-project branch needs this.
  (function () {
    var picker = document.querySelector('[data-project-picker]');
    if (!picker || picker.dataset.pickerWired) return;
    picker.dataset.pickerWired = '1';
    var sel = picker.querySelector('[data-project-picker-select]');
    var name = picker.querySelector('[data-project-picker-name]');
    if (!sel || !name) return;
    function apply() {
      var isNew = sel.value === '__new__';
      name.hidden = !isNew;
      name.required = isNew;
      if (!isNew) name.value = '';
    }
    sel.addEventListener('change', apply);
    apply();
  })();
</script>
<div class="run-grid">
  <div class="card card-glow run-form-col">
    <%# ====== TEMPLATE: what to run, without knowing the runner's spec ======
    The first control, because it decides what the rest of the form is showing:
    a template is a CHOSEN SUBSET of the pipeline's levers (PipelineConf), so
    picking one narrows the contract to a shape an operator can reason about,
    and `standard` is deliberately small enough that demonstrating the basic
    flow never has to touch a setting.

    It composes a SPEC rather than writing the controls, so the one existing
    round trip — hydratePanels() reads the contract into these panels,
    writePanels() writes them back — stays the only way a contract is ever
    built here. A template with its own DOM writer would be a second spec path
    that could quietly disagree with the first.

    The levers themselves are NOT rendered as a form column: they already exist,
    inside the kind's own panel (the sweep's `sweep_max`, the flux model's
    `flux_guidance`), and rendering them twice is two answers to one question.
    So this control sets the contract, the existing panels show the values, and
    the JSON page remains the place anyone goes for the raw thing. %>
<div class="field tpl-field">
  <label for="job_template">Template</label>
  <div class="tpl-row">
    <select id="job_template" name="job_template">
      <% PipelineConf::TEMPLATES.each do |key, tpl| %>
        <%# data-levers maps each lever this template exposes to the CONTROL that
            already edits it, so the JS can read the operator's current value
            without this view restating where every control lives. A lever with
            NO control is simply absent from the map: nothing on the form edits
            it, so nothing is posted for it, and the template's own default is
            what composes. That is the honest outcome — a control invented here
            for a lever the form never offered would be a second place to edit
            the same number.

            The map is declared ONCE below, next to the templates, rather than
            repeated per option. %>
        <% levers = run_job_lever_controls.select { |l, _| tpl[:levers].include?(l) } %>
        <option value="<%= key %>"
                data-kind="<%= PipelineConf.template_kind(key) %>"
                data-blurb="<%= tpl[:blurb] %>"
                data-levers="<%= levers.map { |l, c| "#{l}=#{c}" }.join(" ") %>"
                data-defaults="<%= tpl[:levers].to_h { |l| [l, PipelineConf.default_for(key, l)] }.to_json %>"><%= tpl[:label] %></option>
      <% end %>
    </select>
    <button type="button" class="btn btn-secondary btn-sm" id="tplApplyBtn"
            title="Apply this template to the contract"
            aria-label="Apply this template to the contract">Apply</button>
  </div>
  <p class="hint" id="tplBlurb"><%= PipelineConf.template(PipelineConf::DEFAULT_TEMPLATE)[:blurb] %></p>
  <dl class="help-notes tpl-notes">
    <dt>What it sets</dt>
    <dd id="tplLevers"></dd>
    <dt>Where the limits come from</dt>
    <dd>A template never restates a range. The bound for each lever belongs to
        the service that enforces it — <span class="mono">trace_sweep.py</span>'s
        <span class="mono">DEFAULT_SWEEP</span>, <span class="mono">config.py</span>'s
        <span class="mono">MIN_DIMENSION</span>, the blend document's own
        <span class="mono">render.views</span> — so a service changing its
        default changes what this offers.</dd>
  </dl>
  <%# Not posted. The template's whole effect is the spec it composes into the
      textarea beside it, and posting the key as well would record a fact the
      job's own contract does not carry — a `template` attribute in the manifest
      that nothing downstream reads, which is the kind of thing that becomes
      load-bearing by accident. The keys a job was actually run under are the
      numbers in its spec. %>
</div>

<div class="field">
      <%= f.label :name, "Job name" %>
      <%# Just the emoji. The name is the one field here whose consequence is not
          obvious from the field itself -- it is not a label, it is the filename
          stem every candidate and report inherits -- and that is what the
          crossed fingers are for. Any sentence explaining it reads as nagging,
          and the hint underneath already says what the stem is for. %>
      <%= f.text_field :name, placeholder: "got-a-jobby", required: true, autofocus: true,
            title: "🤞" %>
      <div class="hint">Used as the stem for candidates and reports.</div>
    </div>

    <div class="field">
      <%= f.label :runner, "Runner" %>
      <%# The kind rides on each option rather than in a JS map, so the form's
          field set and the runner it was chosen for cannot drift apart: a runner
          that is not marked flux is a pipeline runner, which is also the model's
          default. Job.job_runners, not the whole runner map: it is the three
          kinds a JOB can be filed against, so the option can never appear
          without a panel behind it. %>
      <%= f.select :runner,
            options_for_select(
              Job.form_runners.map { |l| [l, l, { "data-kind" => Job.runner_kind(l) }] },
              @job.runner
            ),
            {}, { id: "job_runner" } %>
      <div class="hint">
        <% if @runner_health %>
          <% @runner_health.each do |name, health| %>
            <%= name %>:
            <% if health[:ok] %>
              <span style="color:var(--success)">online</span>
            <% else %>
              <span style="color:var(--warning)">offline</span>
            <% end %>
            &nbsp;·&nbsp;
          <% end %>
        <% end %>
        <span class="mono">svg</span> runners prep, trace and gate ·
        <span class="mono">flux</span> runners generate a raster first ·
        <span class="mono">plot</span> runners draw a pasted document ·
        <span class="mono">blender</span> runners render a pasted scene
        <% if @handoff_runner %>(handed to <span class="mono"><%= @handoff_runner %></span>)<% end %>
      </div>
    </div>

    <div class="field">
      <%= f.label :source_kind, "Source kind" %>
      <%= f.select :source_kind, %w[raster svg] %>
      <div class="hint">raster = PNG/JPG is traced into candidates · svg = straight to a proof (mock: same flow)</div>
    </div>

    <div class="actions-row upload-actions" data-run-fields="svg">
      <div class="field artwork-field">
        <%= f.label :source_file, "Artwork" %>
        <div class="upload-row">
          <label class="upload-tile" id="uploadTile">
            <input type="file" id="sourceFile" accept="image/png,image/jpeg" style="display:none;">
            <span class="upload-tile-plus">＋</span>
            <span class="upload-tile-label" id="uploadTileLabel">PNG / JPEG · ≤ 50MB</span>
          </label>
          <div class="upload-thumb" id="uploadThumb" style="display:none;">
            <img id="thumbImg" alt="Uploaded artwork preview">
            <div class="upload-thumb-meta mono" id="thumbMeta"></div>
            <button type="button" class="upload-thumb-x" id="thumbRemove" title="Remove">×</button>
          </div>
        </div>
        <%= f.hidden_field :input_path, id: "inputPathField", value: params[:input_path].presence %>
      </div>
    </div>

    <%# ====== FLUX: the generation, which happens BEFORE the pipeline ======
        Shown only for a flux runner, and NOT a set of form fields: these controls
        compose the spec's `flux` block, and the spec textarea stays the one thing
        that is posted and the one thing the runner reads. Same arrangement as the
        JSON page (fields -> generated JSON), so there is a single source of truth
        and a hand-edited spec still wins.

        The artwork tile above is hidden for flux rather than reused: its value is
        the job's SOURCE, and for a flux job the source does not exist yet — it is
        what this panel produces. The reference image below is a different thing
        again, an input to the generation rather than its result. %>
    <div data-run-fields="flux" hidden>
      <div class="field">
        <label for="flux_prompt">Prompt</label>
        <textarea id="flux_prompt" class="mono flux-prompt" rows="3" spellcheck="false"
                  placeholder="a woodcut phoenix emblem, two inks, high contrast"><%= @prompt_draft %></textarea>
        <% if @prompt_draft.present? %>
          <div class="hint">
            Carried in from the DATASETS library<%= " — #{@prompt_draft_source}" if @prompt_draft_source.present? %>.
            It is a default, not a commitment: edit it however you like.
          </div>
        <% end %>
        <div class="hint">
          There is no negative prompt, and that is the model rather than a missing
          control: klein is step-wise distilled, so classifier-free guidance never
          runs and the pipeline has nowhere to put one. Steer with the prompt and
          the reference image.
        </div>
      </div>

      <div class="actions-row upload-actions">
        <%# The reference SET, not a single reference. Whether a request may name
            SEVERAL is a property of the checkpoint -- the FLUX.2 [klein] family
            declares a list for its `image` and conditions on all of them at once,
            every img2img family takes exactly one -- so the "add another" control
            is shown ONLY for a model whose mirror says `multi_reference`, and is
            hidden (with its extra slots emptied) the moment the model changes.
            Offering a second slot to a model that would refuse it would walk the
            operator into a failure the form could have prevented.

            The ONE reference is still slot 1 and still rides as the singular
            `image` key, so a single-reference request is byte-for-byte what it
            always was; the extra ones go out as `references`. See
            Job#flux_reference_spec_values for why that order is the contract. %>
        <div class="field artwork-field">
          <label for="fluxRefFile">Reference <span class="mono">(optional)</span></label>
          <div class="upload-row" id="fluxRefSlots"
               data-first="Reference 1 — the one that sets the pose"
               data-next="Reference N — the one that sets the palette">
            <label class="upload-tile" id="fluxRefTile">
              <input type="file" id="fluxRefFile" accept="image/png,image/jpeg" style="display:none;">
              <span class="upload-tile-plus">＋</span>
              <span class="upload-tile-label" id="fluxRefLabel">PNG / JPEG · ≤ 50MB</span>
            </label>
            <div class="upload-thumb" id="fluxRefThumb" style="display:none;">
              <img id="fluxRefImg" alt="Reference image preview">
              <div class="upload-thumb-meta mono" id="fluxRefMeta"></div>
              <button type="button" class="upload-thumb-x" id="fluxRefRemove" title="Remove">×</button>
            </div>
          </div>
          <%# The add control. `hidden` in the markup, not merely absent, so the
              first paint on a non-multi-reference model cannot flash a control
              the JS is about to hide. %>
          <div class="actions-row" id="fluxRefAddRow" hidden>
            <button type="button" class="btn btn-secondary btn-sm" id="fluxRefAdd">
              ＋ Add another reference
            </button>
            <span class="hint" id="fluxRefMultiHint" style="margin:0;">
              This model conditions on all of them at once — the prompt can say
              "the pose from the first, the palette from the second". Order is
              what you attach them in.
            </span>
          </div>
          <div class="hint" id="fluxRefHint">
            With one, this is an edit: the service is asked to transform this image
            rather than draw from scratch. Without one, plain generation.
          </div>
        </div>
      </div>

      <div class="print-grid">
        <div class="field">
          <label for="flux_width">width</label>
          <input type="number" id="flux_width" min="64" step="16" value="1024">
          <div class="hint">Multiple of 16, 64 min, 4 MP cap.</div>
        </div>
        <div class="field">
          <label for="flux_height">height</label>
          <input type="number" id="flux_height" min="64" step="16" value="1024">
          <div class="hint">Multiple of 16.</div>
        </div>
      </div>

      <div class="field">
        <label for="flux_mode">After generating</label>
        <select id="flux_mode">
          <option value="trace" selected>trace it — into candidates on the runner above</option>
          <option value="raster">keep the raster — the image is the deliverable</option>
        </select>
        <div class="hint">
          Keeping the raster stops here: the job is done when the image lands, with
          no tracing, no gates and no candidates.
        </div>
      </div>

      <div class="actions-row">
        <button type="button" class="btn btn-secondary btn-sm" data-popup="flux-settings-popup">
          Settings…
        </button>
        <span class="hint" id="fluxSummary"></span>
      </div>
    </div>

    <%# ====== PLOT: a loaded document in, an SVG out ======
        Shown only for a plot runner, and like the flux panel NOT a set of form
        fields: these controls compose the spec's `plot` block — the operation,
        the document it draws, and a query's run records — and the contract
        textarea stays the one thing posted. The pasted JSON is parsed HERE, in
        the browser, so a bad paste is refused in the form rather than posted and
        round-tripped to the service to be told. %>
    <div data-run-fields="plot" hidden>
      <div class="field">
        <label for="plot_op">Operation</label>
        <select id="plot_op">
          <option value="generate" selected>generate — a geometry spec in, an SVG out</option>
          <option value="digest">digest — one run's metrics, charted</option>
          <option value="query">query — every candidate across every run</option>
        </select>
        <div class="hint">
          Which one it is decides what the document below has to be: a geometry
          spec for generate, a chart spec for digest and query.
        </div>
      </div>

      <div class="field">
        <label for="plot_doc">Document <span class="mono">(JSON)</span></label>
        <textarea id="plot_doc" class="mono plot-doc" rows="10" spellcheck="false"
                  autocomplete="off" placeholder='{ "canvas": { "width": 800, "height": 400 }, "elements": [] }'></textarea>
        <div class="hint">
          Paste the operation's own document. It is parsed before anything is
          queued, so a typo is a form error rather than a failed run.
        </div>
      </div>

      <div class="field" id="plotRunsField" hidden>
        <label for="plot_runs">Run records <span class="mono">(JSON array)</span></label>
        <textarea id="plot_runs" class="mono plot-runs" rows="6" spellcheck="false"
                  autocomplete="off" placeholder='[ { "stem": "run-1", "candidates": [] } ]'></textarea>
        <div class="hint">
          A query draws across runs: paste the <span class="mono">.run.json</span>
          records as an array.
        </div>
      </div>

      <div class="actions-row">
        <span class="hint" id="plotSummary"></span>
      </div>
    </div>

    <%# ====== BLENDER: a geometry document in, a rendered frame out ======
        Shown only for a blender runner, and like the plot panel NOT a set of
        form fields: this control composes the spec's `blender` block, and the
        contract textarea stays the one thing posted. There is no operation to
        choose -- the route IS the operation (POST /blender) -- so the document
        is the whole request. The pasted JSON is parsed HERE, in the browser, so
        a bad paste is refused in the form rather than posted and round-tripped
        to the service to be told. %>
    <div data-run-fields="blender" hidden>
      <div class="field">
        <label for="blender_doc">Document <span class="mono">(JSON)</span></label>
        <textarea id="blender_doc" class="mono blender-doc" rows="12" spellcheck="false"
                  autocomplete="off" placeholder='{ "elements": [ { "type": "rect", "x": 0, "y": 0, "width": 200, "height": 120 } ], "render": { "views": 1 } }'></textarea>
        <div class="hint">
          The geometry document: an <span class="mono">elements</span> list, plus
          the optional tiling, extrude, render and export blocks. It is parsed
          before anything is queued, so a typo is a form error rather than a
          failed render.
        </div>
      </div>

      <div class="actions-row">
        <span class="hint" id="blenderSummary"></span>
      </div>
    </div>

    <%# ====== BP: one action, six operations ======
        The combined blend-plot action. The site used to offer TWO runner
        actions for ONE service — `plot`, which drew a document, and `blender`,
        which rendered geometry in 3D — so the selector here spans all six of
        that service's operations and the one it names decides which half
        answers. Like the panels it front-ends this is NOT a set of form fields:
        it composes the spec's `bp` block, and the contract textarea stays the
        one thing posted. The pasted JSON is parsed HERE, in the browser, so a
        bad paste is a form error rather than a round trip to be told.

        The legacy `plot` and `blender` panels above are KEPT deliberately.
        Those kinds are still valid — a job already filed against one has to
        keep resolving and running — so a deployment that still offers those
        labels keeps a working form. What the form OFFERS by default is BP alone
        (Job.form_runners), which is the whole point of the merge. %>
    <div data-run-fields="bp" hidden>
      <div class="field">
        <label for="bp_op">Operation</label>
        <select id="bp_op">
          <option value="generate" selected>generate — a geometry spec in, an SVG out</option>
          <option value="digest">digest — one run's metrics, charted</option>
          <option value="query">query — every candidate across every run</option>
          <option value="tree">tree — a hierarchy, laid out</option>
          <option value="log">log — an event timeline</option>
          <option value="blender">blender — geometry rendered in 3D</option>
        </select>
        <div class="hint">
          Five of the six DRAW a document — that is the plot half. The sixth,
          <span class="mono">blender</span>, renders geometry in 3D and answers
          with files instead: that is the blend half. The operation decides what
          the document below has to be.
        </div>
      </div>

      <div class="field">
        <label for="bp_doc">Document <span class="mono">(JSON)</span></label>
        <textarea id="bp_doc" class="mono bp-doc" rows="10" spellcheck="false"
                  autocomplete="off" placeholder='{ "canvas": { "width": 800, "height": 400 }, "elements": [] }'></textarea>
        <div class="hint">
          The document the operation reads: a geometry spec for
          <span class="mono">generate</span> and <span class="mono">blender</span>,
          a chart spec for <span class="mono">digest</span> and
          <span class="mono">query</span>, a hierarchy for
          <span class="mono">tree</span>, an event list for
          <span class="mono">log</span>. Parsed before anything is queued.
        </div>
      </div>

      <div class="field" id="bpRunsField" hidden>
        <label for="bp_runs">Run records <span class="mono">(JSON array)</span></label>
        <textarea id="bp_runs" class="mono bp-runs" rows="6" spellcheck="false"
                  autocomplete="off" placeholder='[ { "stem": "run-1", "candidates": [] } ]'></textarea>
        <div class="hint">
          Only <span class="mono">query</span> draws across runs: paste the
          <span class="mono">.run.json</span> records as an array.
        </div>
      </div>

      <%# ====== BLENDER: the render block, as controls ======
          Before these the form exposed ONE bp control — the operation — and a
          template's render levers were composed into the contract and then
          editable only in the JSON box. These write THROUGH to the pasted
          document: the textarea stays the single source of truth and the only
          thing posted, so the contract still shows exactly what will run.

          Shown only for the `blender` operation: the five drawing operations
          have no render block, and a control that edits nothing is the failure
          this panel exists to avoid. %>
      <div id="bpRenderFields" hidden>
        <div class="print-grid">
          <div class="field">
            <label for="bp_render_width">render width</label>
            <input type="number" id="bp_render_width" min="64" max="4096" step="1" value="1024">
            <div class="hint">Pixels. A power of two is what a game engine wants for a texture.</div>
          </div>
          <div class="field">
            <label for="bp_render_height">render height</label>
            <input type="number" id="bp_render_height" min="64" max="4096" step="1" value="1024">
            <div class="hint">Pixels.</div>
          </div>
        </div>

        <div class="print-grid">
          <div class="field">
            <label for="bp_background">background</label>
            <select id="bp_background">
              <option value="#1a1a24">#1a1a24 — the default</option>
              <option value="#0d0f16">#0d0f16 — near black</option>
              <option value="#ffffff">#ffffff — white</option>
              <option value="transparent">transparent — RGBA, world omitted</option>
            </select>
            <div class="hint">Transparent writes an alpha frame — the sprite. bp accepts a hex colour or this one word, nothing else.</div>
          </div>
          <div class="field">
            <label for="bp_projection">projection</label>
            <select id="bp_projection">
              <option value="ortho">ortho — framing independent of distance</option>
              <option value="perspective">perspective</option>
            </select>
            <div class="hint">Ortho is the technical read: the sprite, the plan view, the tumbling prop.</div>
          </div>
        </div>

        <div class="print-grid">
          <div class="field">
            <label for="bp_elevation">elevation</label>
            <input type="number" id="bp_elevation" min="0" max="360" step="1" value="25">
            <div class="hint">Degrees above the horizon: 0 is the horizon (front view), 90 the plan view.</div>
          </div>
          <div class="field">
            <label for="bp_azimuth">azimuth</label>
            <input type="number" id="bp_azimuth" min="0" max="360" step="1" value="0">
            <div class="hint">Where the view sweep starts; <span class="mono">views</span> steps evenly from there.</div>
          </div>
        </div>

        <div class="print-grid">
          <div class="field">
            <label for="bp_views">views</label>
            <select id="bp_views">
              <option value="1">1 — one angle</option>
              <option value="2">2 — front and back</option>
              <option value="4">4 — a quarter turn apart</option>
              <option value="8">8 — an eighth turn apart</option>
            </select>
            <div class="hint">bp accepts exactly these four: 1 is one frame, more are a walk around the object.</div>
          </div>
          <div class="field">
            <label for="bp_engine">render engine</label>
            <select id="bp_engine">
              <option value="workbench">workbench — flat, cheap, what the spec's colours say</option>
              <option value="eevee">eevee — lit, honours roughness/metallic/alpha</option>
            </select>
            <div class="hint">bp maps these two words to Blender's own engines; spelling Blender's names breaks the round trip.</div>
          </div>
        </div>

        <div class="print-grid">
          <div class="field">
            <label for="bp_depth">extrude depth</label>
            <input type="number" id="bp_depth" min="0" max="10" step="0.05" value="0.5">
            <div class="hint">The solid's half-thickness. 0 is a flat sheet with nothing to shade.</div>
          </div>
          <div class="field">
            <label for="bp_bevel_depth">bevel</label>
            <input type="number" id="bp_bevel_depth" min="0" max="2" step="0.01" value="0.02">
            <div class="hint">A small round on the extruded edges. Much above a fraction of the depth is a mistake.</div>
          </div>
        </div>
      </div>

      <div class="actions-row">
        <span class="hint" id="bpSummary"></span>
      </div>
    </div>

    <%# ====== SEQUENCE: an ordered step list in ONE job ======
        A job is ONE runner action. Ticking this makes it an ORDERED LIST of them,
        carried in the same contract under `spec["steps"]` — the same per-kind
        blocks the panels above compose, one after another, each naming the runner
        it runs on.

        The STUDIO drives the chain, not the runner: the runner is stateless and
        serves one operation per request, so RunJob posts a step, waits for it to
        finish, then posts the next with the step before it's file produced handed
        in. That is why nothing here needs a runner change.

        The steps are edited as JSON per step rather than as a second copy of
        every panel's fields: the block a step carries IS the document the panel
        above produces (copy it out of the JSON popup), so there is one place a
        document is defined rather than two that can disagree. %>
    <div id="stepsCard">
      <div class="card-head">
        <h3>Sequence</h3>
        <button type="button" class="help-btn" data-help-title="Sequence"
                data-help-target="help-steps"
                aria-label="Explain sequences" title="Explain sequences">?</button>
      </div>

      <div class="field">
        <label class="check"><input type="checkbox" id="seq_on">
          <span>run an ordered list of steps</span></label>
        <div class="hint">
          Off, this job is the single action above. On, it runs the steps below in
          order as one job — and a step can be handed the file the step before it
          produced.
        </div>
      </div>

      <div id="seqBody" hidden>
        <div id="stepsList"></div>
        <div class="actions-row">
          <button type="button" class="btn btn-sm btn-secondary" id="addStepBtn">＋ Add step</button>
        </div>
        <div class="hint" id="seqSummary"></div>
      </div>

      <div id="help-steps" hidden>
        <dl class="help-notes">
          <dt>Sequence</dt>
          <dd>
            One job, several actions, in order. Each step names the runner it runs
            on and carries that runner's own block — the same document the panel
            above composes. The order in this list is the order they run.
          </dd>
          <dt>Runner</dt>
          <dd>
            Which runner a step is filed against. One step, one runner: the
            service is stateless, so the chain is orchestrated here rather than by
            any runner.
          </dd>
          <dt>Input</dt>
          <dd>
            Where a step's file comes from. <span class="mono">auto</span> derives
            it — a step that cannot run without a source takes what the step before
            it produced when that is a file it accepts.
            <span class="mono">previous</span> asks for it explicitly, and
            <span class="mono">job</span> uses this job's own artwork.
          </dd>
          <dt>Hand-off</dt>
          <dd>
            A step asked for <span class="mono">previous</span> is handed the file
            the step before it left behind. A render step handed a drawing has that
            SVG converted into the render's own geometry vocabulary, because the
            render operation takes geometry rather than a file path.
          </dd>
          <dt>When it fails</dt>
          <dd>
            The chain stops at the step that failed and the job says which one it
            was. Steps already finished keep their output.
          </dd>
        </dl>
      </div>
    </div>

    <%# ====== THE PROOF'S TRAINING SET: a print-side opt-in ======
        NOT a flux setting, and not a pipeline setting either. What it asks for
        is a thing the PRINT CHECK writes while it proves a candidate, so it
        composes `validation.variants` — the same block that already carries
        run_preflight — and NOTHING under `flux`. A hand-edited contract wins as
        it does everywhere else, because this only ever writes that one key.

        It is therefore offered for the two kinds that produce a proof: a
        pipeline run, and a flux run that goes on to be traced. It is hidden for
        plot and blender (their output IS the deliverable) and for a flux run set
        to "keep the raster" — a picture that stops at the raster was never
        proved, so there is nothing to vary.

        `data-proof-fields` is a LIST of kinds rather than one, which is why it
        is not the single-kind `data-run-fields` attribute. %>
    <div id="proofVariantsBlock" data-proof-fields="svg flux">
      <div class="field">
        <label for="proof_variants">Proof variants — build a training set from the proof</label>
        <button type="button" class="help-btn" data-help-title="Proof variants"
                data-help-target="help-proof-variants"
                aria-label="Explain proof variants" title="Explain proof variants">?</button>
        <label class="check"><input type="checkbox" id="proof_variants">
          <span>write flipped / reversed / colour-shifted copies of the proof as a dataset</span></label>
        <div class="hint">
          Flipped, reversed and colour-shifted copies of the PROOF, delivered as a
          raster+vector set with a contact sheet, a manifest and a 7z package.
          It only applies when the run produces a proof — a raster-only flux job
          has no proof to vary.
        </div>
      </div>

      <%# The second FORM of the same key. The contract takes `true` (the whole
          vocabulary) or {enabled: true, transforms: [...]}; the runner's
          vocabulary is a closed, ordered list and a name outside it is REFUSED
          with the list quoted rather than skipped. So this is a free-text box in
          the same shape as the benches' preset boxes: blank asks for everything
          (and writes the bare `true`), a named subset writes the object, and the
          runner stays the only source of truth for the names — a second,
          hardcoded copy of that vocabulary in this view is exactly the drift
          these panels avoid everywhere else. %>
      <div class="field">
        <input type="text" id="proof_variant_transforms" class="mono" spellcheck="false"
               autocomplete="off" placeholder="(all) — or a comma-separated subset: flip-h, hue-90, …"
               aria-label="validation.variants transforms — a comma-separated subset; blank asks for the whole vocabulary">
        <div class="hint">
          Blank asks for every copy. Name a comma-separated subset to ask for
          less — the runner refuses a name it does not know and quotes its
          vocabulary, so a typo fails the run rather than quietly writing fewer.
        </div>
      </div>
    </div>

    <%# The opt-in's deep notes, opened by its "?" — the site-wide .help-btn
        arrangement, and outside the form's field flow so nothing here is
        posted. %>
    <div id="help-proof-variants" hidden>
      <dl class="help-notes">
        <dt>Proof variants</dt>
        <dd>Off by default. When on, the print check writes a dataset beside the
          proof: SIMILAR COPIES of it — flipped horizontally and vertically,
          rotated, transposed, colour-inverted, hue-shifted, channel-swapped and
          palette-cycled — as a raster+vector set plus a contact sheet, a
          <span class="mono">.dataset.json</span> manifest and a
          <span class="mono">.dataset.7z</span> package.</dd>
        <dt>why</dt>
        <dd>It is a training set, not a shortlist. The pipeline does not pick,
          rank or improve any of the copies: it derives them mechanically from
          the one image that was actually checked, so a later phase has more than
          one example of the same artwork to learn from. Nothing about the proof
          itself changes.</dd>
        <dt>when it applies</dt>
        <dd>Only a run that produces a PROOF has anything to vary. A pipeline run
          does; a flux run that is traced does; a plot or blender run does not
          (its drawn or rendered output is the deliverable), and a raster-only
          flux run does not either. The control is hidden for those rather than
          left on screen meaning nothing. The proof page grows a Training set
          card once a proof has one, and is unchanged when it does not.</dd>
        <dt>which copies</dt>
        <dd>
          Every copy the artwork admits, unless a subset is named in the box
          under the control. The contract takes <span class="mono">true</span>
          (flipped horizontally and vertically, rotated, transposed,
          colour-inverted, hue-shifted, channel-swapped, palette-cycled — the
          whole vocabulary) or
          <span class="mono">{"enabled": true, "transforms": [...]}</span> for a
          subset; blank in that box writes the first and asks for all of it. The
          vocabulary belongs to the print check, a name outside it is REFUSED
          with the list quoted rather than silently skipped, and a finished
          proof's Training set card names the copies that were actually written.
        </dd>
      </dl>
    </div>

    <%# The hint sits BELOW the row, not inside it. Inside, it wrapped to three
        lines and the row's `align-items: flex-end` bottom-aligned the buttons
        against the HINT rather than against the tile — so the button floated
        down past the artwork picker instead of sitting beside it.
        Measured: tile.top=625, buttons.top=680. With the hint out of the row,
        flex-end aligns the buttons to the bottom of the tile itself. %>
    <div class="hint upload-hint" id="uploadHint">
      <% if @carried %>
        Artwork carried over from <strong style="color:var(--text-primary)"><%= @carried %></strong>'s inverse twin —
        name this run and start it, or pick a different file.
      <% else %>
        Click the tile to pick a file — it uploads immediately and shows a small preview.
      <% end %>
    </div>
  </div>

  <%# Right column: the job contract, always visible. This is a real form field
      (f.text_area :spec), so it stays a <textarea> — the operator edits it here
      and it is posted with the job. What changed is that it is no longer
      collapsed behind a toggle and no longer buried in a 760px card: it is a
      column beside the form, the size of the thing it configures. %>
  <div class="card run-contract-col">
    <div class="card-head">
      <h3>Job contract</h3>
      <button type="button" class="btn btn-secondary btn-sm" id="copySpecBtn"
              title="Copy JSON" aria-label="Copy JSON to clipboard">Copy</button>
    </div>
    <%# JSON.pretty_generate, NOT `to_json(pretty: true)`: on this Rails version
        the option is silently ignored and the contract arrives as ONE 290-char
        line, which is the opposite of "properly formatted, not long lines".
        Verified by running both: to_json(pretty: true) emitted the compact
        form, pretty_generate emitted the indented one. %>
    <%# ONE authoritative sweep cap. The sweep panel in the settings popup writes
        print.sweep.max_candidates, and trace_sweep.py treats THAT as the modern
        key, with print.sweep_max_candidates as a legacy fallback that loses to
        it whenever a spec carries both (trace_sweep.py: the legacy key is only
        read when the namespaced one is absent). This default used to write the
        legacy key, so one contract carried two caps — and because
        hydratePanels() reads the modern key back, the legacy 12 never even
        appeared in the panel. The modern key is the one written here: the one
        the panel writes and the tracer prefers. %>
    <% spec_default = JSON.pretty_generate(
      print_method: "screen_print",
      max_colors: 6,
      palette: ["#000000", "#FFFFFF", "#FF0000", "#0000FF", "#FFFF00", "#00FF00"],
      geometry: { min_stroke_width_pt: 1.5, max_nodes_per_path: 500,
                  allow_gradients: false, allow_open_paths: true },
      print: { dpi: 300, sweep: { max_candidates: 12 }, invert: true }
    ) %>
    <%= f.text_area :spec,
          value: @spec_draft.presence || params.dig(:job, :spec).presence || spec_default,
          spellcheck: "false", autocomplete: "off",
          class: "mono run-contract" %>
    <div class="hint">Same contract as <span class="mono">spec.json</span> — gates, tolerances, sweep caps. Omitted keys fall back to defaults. Build one on the <a href="<%= json_path %>" style="color:var(--accent);">JSON page</a>.</div>
  </div>
</div>
<% end %>

<%# ====== FLUX deeper settings ======
    Outside the <form> on purpose: nothing in here is a form field. These controls
    compose the spec's `flux` and `print.prep_expand` blocks through the same
    writer the visible panel uses, so the popup cannot post anything the spec does
    not already carry.

    The raster-side passes are here because they run on THIS job's raster whatever
    its origin — a generated source is filtered, prepped, traced and gated exactly
    like an uploaded one. They are the pipeline's own knobs, revealed rather than
    reinvented. %>
<div class="popup" id="flux-settings-popup" role="dialog" aria-modal="true"
     aria-labelledby="flux-settings-popup-title" hidden>
  <div class="popup-panel popup-wide">
    <header class="popup-head">
      <h2 id="flux-settings-popup-title">FLUX settings</h2>
      <button type="button" class="popup-close" data-popup-close aria-label="Close">&times;</button>
    </header>
    <div class="popup-body">
      <p class="jev-question">
        Generation, then the raster passes the pipeline runs before tracing.
        Everything here lands in the spec — <span class="mono">flux</span>,
        <span class="mono">print.sweep</span>,
        <span class="mono">print.prep_expand</span> and the two prep-stage
        switches, <span class="mono">assume_opaque_bg</span> and
        <span class="mono">prep_colors</span> — and the contract on the right
        is where you can see it. Blank means the service's or the pipeline's own
        default, not zero.
      </p>

      <div class="print-grid">
        <div class="field">
          <label for="flux_model">model</label>
          <select id="flux_model">
            <option value="klein-4b" data-multiref="1" selected>klein-4b — Apache-2.0, commercial OK</option>
            <option value="klein-4b-base" data-multiref="1">klein-4b-base — Apache-2.0, undistilled</option>
            <option value="sdxl-1.0" data-negprompt="1" data-img2img="1">sdxl-1.0 — OpenRAIL++-M, commercial OK, SD-style</option>
            <option value="sdxl-turbo" data-negprompt="1" data-img2img="1">sdxl-turbo — NON-COMMERCIAL, refuses to load unacknowledged</option>
            <option value="sd-1.5" data-negprompt="1" data-img2img="1">sd-1.5 — OpenRAIL-M, commercial OK, SD-style</option>
            <%# The three added for the 16 GB box. Sana has no negative_prompt
                parameter (so no data-negprompt) but DOES take an img2img
                strength; ssd-1b is an SDXL, so it has both. The licences are
                Apache-2.0 and the resolution rules differ per family — the
                Sana pair is 32-multiple / 512 floor / 1 MP, not klein's 16/64/4. %>
            <option value="sana-sprint-0.6b" data-img2img="1">sana-sprint-0.6b — Apache-2.0, 2-step (Gemma-2 encoder), 32/512/1MP</option>
            <option value="sana-sprint-1.6b" data-img2img="1">sana-sprint-1.6b — Apache-2.0, 2-step (Gemma-2 encoder), 32/512/1MP</option>
            <option value="ssd-1b" data-negprompt="1" data-img2img="1">ssd-1b — Apache-2.0, commercial OK, SDXL at 1.3B</option>
            <%# z-image-turbo: the fifth family. It HAS a negative_prompt parameter
                and an img2img class, so it carries both data flags — but no CFG runs
                at its own 0.0 schedule, which is why the page's copy says the
                parameter acts only when guidance is raised, rather than claiming it
                is ignored (the service emits no "ignored" warning for it either). %>
            <option value="z-image-turbo" data-negprompt="1" data-img2img="1">z-image-turbo — Apache-2.0, 9-step, 16/128/1MP</option>
          </select>
          <div class="hint">sdxl-turbo's output needs a licence. The service refuses it rather than
            warning, so a commercial run cannot happen by accident.</div>
        </div>
        <div class="field">
          <label for="flux_seed">seed</label>
          <input type="number" id="flux_seed" placeholder="random">
          <div class="hint">Blank is random. Whatever it used is reported back and kept with the
            job — a raster is not reproducible from the prompt alone.</div>
        </div>
        <div class="field">
          <label for="flux_steps">steps</label>
          <input type="number" id="flux_steps" min="1" placeholder="the model's">
          <div class="hint">4 on distilled klein, 2 on the turbo, 28–30 on the undistilled
            checkpoints. Slow to change: this is the denoise loop.</div>
        </div>
        <div class="field">
          <label for="flux_guidance">guidance</label>
          <input type="number" id="flux_guidance" step="0.1" placeholder="the model's">
          <div class="hint">1.0 on distilled klein, 0.0 on sdxl-turbo, 4.5 on Sana Sprint. On a
            distilled model with no guidance embedding it is ignored, and the service says so in
            its warnings; on Sana Sprint guidance is embedded and IS honoured.</div>
        </div>
        <div class="field" id="fluxNegPromptField" hidden>
          <label for="flux_negative_prompt">negative prompt</label>
          <input type="text" id="flux_negative_prompt" class="mono" spellcheck="false"
                 autocomplete="off" placeholder="what to steer away from">
          <div class="hint">Only the SD-family models carry one (sdxl-1.0, sdxl-turbo, sd-1.5).
            Klein has no such parameter — the service says so in its warnings.</div>
        </div>
        <div class="field" id="fluxStrengthField" hidden>
          <label for="flux_strength">strength</label>
          <input type="number" id="flux_strength" min="0" max="1" step="0.05">
          <div class="hint">img2img only — an SD-family model (sdxl-1.0, sdxl-turbo, sd-1.5)
            with a reference image. How far the edit
            may move from that reference, 0–1. Blank leaves the model's own default.
            A text-to-image call never carries it.</div>
        </div>
        <div class="field">
          <label for="flux_images">variations</label>
          <input type="number" id="flux_images" min="1" max="8" value="1">
          <div class="hint">A set in one call — a triptych (3), a swatch sheet. Every one is
            kept and previewed on the job page, each saveable.</div>
        </div>
        <%# MODIFIERS AND THE VAE, from FluxConf — never re-typed here. Each
            option carries the models it may load against in data-targets, and
            the JS rebuilds both lists down to the chosen model's targets, so a
            modifier that cannot load is never OFFERED (a load that fails after
            the GPU has been paid for is the expensive way to learn this). The
            model select already drives which fields apply; this is the same
            idea one level down, at the option rather than the field, because a
            <select> cannot hide an option the way a field hides itself.

            The licence rides in each option's text and tooltip, beside the
            licence treatment the model select already uses. %>
        <div class="field">
          <label for="flux_modifiers">modifiers <span class="mono">(LoRA)</span></label>
          <select id="flux_modifiers" multiple size="6">
            <% FluxConf::MODIFIERS.each_value do |mod| %>
              <% mod_targets = Array(mod["targets"]) %>
              <option value="<%= mod["key"] %>"
                      data-targets="<%= mod_targets.join(",") %>"
                      title="<%= mod["key"] %> — <%= mod["licence"] %> — <%= mod["repo_id"] %> — loads <%= mod["weight_name"] %> onto <%= mod_targets.join(", ") %><%= mod["notes"].present? ? " — #{mod["notes"]}" : "" %>"><%= mod["key"] %> — <%= mod["licence"] %><%= " (NON-COMMERCIAL)" unless mod["commercial_ok"] %></option>
            <% end %>
          </select>
          <div class="hint" id="fluxModifiersHint">
            Stackable, and only the adapters that load against the chosen model
            are listed. Cmd/Ctrl-click for more than one.
          </div>
          <div class="hint" id="fluxModifiersEmpty" hidden>
            No LoRA is registered for this model — the adapters below target the
            SD family, and the klein adapters target klein. Blank is not a
            missing control: there is genuinely nothing to stack on this one.
          </div>
        </div>
        <div class="field">
          <label for="flux_modifier_scales">modifier scales</label>
          <input type="text" id="flux_modifier_scales" class="mono" spellcheck="false"
                 autocomplete="off" placeholder="klein-outpaint=0.8, stickers=1.0">
          <div class="hint">Optional, <span class="mono">name=scale</span> pairs, comma-separated.
            A scale is only composed for a modifier that is actually selected, and blank
            leaves each adapter its registered scale.</div>
        </div>
        <div class="field">
          <label for="flux_vae">vae</label>
          <select id="flux_vae">
            <option value="">(the model's own decoder)</option>
            <% FluxConf::VAES.each_value do |vae| %>
              <% vae_targets = Array(vae["targets"]) %>
              <option value="<%= vae["key"] %>"
                      data-targets="<%= vae_targets.join(",") %>"
                      title="<%= vae["key"] %> — <%= vae["licence"] %> — <%= vae["repo_id"] %> — targets <%= vae_targets.join(", ") %><%= vae["notes"].present? ? " — #{vae["notes"]}" : "" %>"><%= vae["key"] %> — <%= vae["licence"] %><%= vae["tiny"] ? " (tiny decode)" : "" %></option>
            <% end %>
          </select>
          <div class="hint" id="fluxVaeHint">
            Which decoder the latents are decoded with. Only swaps that target the
            chosen model are listed; the <span class="mono">tiny</span> ones decode
            visibly softer.
          </div>
        </div>
      </div>

      <h4 class="flux-settings-h">Raster passes — before tracing</h4>
      <p class="hint">
        The ImageMagick bench is the lever for node count: VTracer traces literal
        pixel boundaries, so grain and soft gradients become hundreds of corrective
        nodes. Each variant is a candidate <em>input</em>, never a trace. Off by
        default, because each costs real time and none of them picks a winner.
      </p>

      <div class="print-grid">
        <%# The two prep-stage switches prep_raster.py itself reads. Both are
            omitted unless touched, so an untouched popup adds nothing. %>
        <div class="field">
          <label>assume_opaque_bg</label>
          <label class="check"><input type="checkbox" id="pe_opaque_bg"> <span>skip background removal</span></label>
          <div class="hint">The source has no transparent background, so prep does
            not strip one. Off is the documented default.</div>
        </div>
        <div class="field">
          <label for="pe_prep_colors">prep_colors</label>
          <input type="text" id="pe_prep_colors" class="mono" placeholder="16 — the pipeline's default"
                 spellcheck="false" autocomplete="off">
          <div class="hint">pngquant's colour budget in prep. <span class="mono">null</span>
            disables quantisation; blank leaves the pipeline its default of 16.</div>
        </div>
        <div class="field">
          <label>filters</label>
          <label class="check"><input type="checkbox" id="pe_filters"> <span>run the raster filter bench</span></label>
        </div>
        <div class="field">
          <label for="pe_filters_presets">presets — filters</label>
          <input type="text" id="pe_filters_presets" class="mono" value="kuwahara, flat6"
                 spellcheck="false" autocomplete="off">
          <div class="hint">denoise for grain, flat6 for hard edges, bilateral for skin and hair.</div>
        </div>
        <div class="field">
          <label>contact_sheet — filters</label>
          <label class="check"><input type="checkbox" id="pe_filters_sheet" checked> <span>write a contact sheet</span></label>
          <div class="hint">The numbers cannot tell you which one looks right.</div>
        </div>
        <div class="field">
          <label>keep_alpha — filters</label>
          <label class="check"><input type="checkbox" id="pe_filters_alpha"> <span>do not flatten alpha</span></label>
          <div class="hint">Off, every variant is flattened onto the print
            background. Only worth it for a genuine knockout.</div>
        </div>
        <div class="field">
          <label for="pe_filters_spec">spec — filters</label>
          <input type="text" id="pe_filters_spec" class="mono" placeholder="the tool's own spec.json"
                 spellcheck="false" autocomplete="off">
          <div class="hint">Which spec.json the remap presets read — their
            background colour and palette. Blank uses the tool's own default,
            which is not this job's contract.</div>
        </div>
        <div class="field">
          <label>tune</label>
          <label class="check"><input type="checkbox" id="pe_tune"> <span>run the trace-parameter bench</span></label>
        </div>
        <div class="field">
          <label for="pe_tune_presets">presets — tune</label>
          <input type="text" id="pe_tune_presets" class="mono" value="baseline, nodewise"
                 spellcheck="false" autocomplete="off">
        </div>
        <div class="field">
          <label for="pe_tune_cells">max_cells</label>
          <input type="number" id="pe_tune_cells" min="0" max="64" value="12">
          <div class="hint">Cap on bench cells. 0 = no cap.</div>
        </div>
        <%# This control was MISSING while prepExpandBlock() already read it:
            boxOn('pe_tune_sheet') on an element that did not exist returned false,
            so every tune block this popup composed silently turned the bench's
            contact sheet off mid-bench. The switch the writer reads is the
            switch the panel shows. %>
        <div class="field">
          <label>contact_sheet — tune</label>
          <label class="check"><input type="checkbox" id="pe_tune_sheet" checked> <span>write a contact sheet</span></label>
          <div class="hint">Every bench cell rendered, side by side.</div>
        </div>
        <div class="field">
          <label for="pe_tune_speckle">filter_speckle — tune</label>
          <input type="text" id="pe_tune_speckle" class="mono" placeholder="the tool's own speckle grid"
                 spellcheck="false" autocomplete="off">
          <div class="hint">Speckle sizes this bench sweeps, comma-separated px.
            Blank uses the tool's own grid.</div>
        </div>
        <div class="field">
          <label for="pe_tune_hier">hierarchical — tune</label>
          <input type="text" id="pe_tune_hier" class="mono" placeholder="cutout, stacked"
                 spellcheck="false" autocomplete="off">
          <div class="hint">Layer stacking modes this bench sweeps, comma-separated.
            Blank sweeps the tool's own list.</div>
        </div>
        <div class="field">
          <label>with_node_reduce — tune</label>
          <label class="check"><input type="checkbox" id="pe_tune_nr"> <span>reduce nodes in every cell</span></label>
          <div class="hint">Ranks the bench on the REDUCED node counts. Off by
            default: it multiplies the bench's cost.</div>
        </div>
        <div class="field">
          <label>node_reduce</label>
          <label class="check"><input type="checkbox" id="pe_nr"> <span>write reduced copies</span></label>
          <div class="hint">The remedy for geometry_overload. Originals kept.</div>
        </div>
        <div class="field">
          <label for="pe_nr_nodes">max_nodes</label>
          <input type="number" id="pe_nr_nodes" min="1" placeholder="geometry gate">
          <div class="hint">Blank falls back to max_nodes_per_path in Geometry.</div>
        </div>
        <div class="field">
          <label for="pe_nr_tolerance">tolerance</label>
          <input type="number" id="pe_nr_tolerance" min="0" step="0.1" placeholder="the tool's own">
          <div class="hint">How far the simplifier may pull a point, in px. Larger
            removes more nodes and bends the outline more.</div>
        </div>
        <div class="field">
          <label for="pe_nr_tolerance_cap">tolerance_cap</label>
          <input type="number" id="pe_nr_tolerance_cap" min="0" step="0.1" placeholder="the tool's own">
          <div class="hint">The ceiling a path's tolerance may be raised to while
            it is still over the gate. Blank leaves the tool its own cap.</div>
        </div>
        <div class="field">
          <label>verify</label>
          <label class="check"><input type="checkbox" id="pe_nr_verify" checked> <span>render before / after</span></label>
          <div class="hint">Ink lost plus the gap blob — clearing the gate is not
            the art surviving.</div>
        </div>
      </div>

      <h4 class="flux-settings-h">Sweep — what gets traced</h4>
      <div class="print-grid">
        <div class="field">
          <label>presets</label>
          <div class="check-row">
            <label class="check"><input type="checkbox" id="sweep_bw" checked> <span>bw</span></label>
            <label class="check"><input type="checkbox" id="sweep_poster" checked> <span>poster</span></label>
            <label class="check"><input type="checkbox" id="sweep_photo" checked> <span>photo</span></label>
          </div>
          <div class="hint">photo needs allow_gradients on; it is dropped otherwise.
            With gradients off, Layer A also refuses a source that declares one
            (<span class="mono">GRADIENT_NOT_ALLOWED</span>).</div>
        </div>
        <div class="field">
          <label for="sweep_max">max_candidates</label>
          <input type="number" id="sweep_max" min="1" max="24" value="12">
        </div>
        <div class="field">
          <label for="sweep_speckle">filter_speckle</label>
          <input type="text" id="sweep_speckle" class="mono" value="2, 8, 16"
                 spellcheck="false" autocomplete="off">
          <div class="hint">Comma-separated, px. Larger drops more isolated dots.</div>
        </div>
        <div class="field">
          <label>hierarchical</label>
          <div class="check-row">
            <label class="check"><input type="checkbox" id="hier_cutout" checked> <span>cutout</span></label>
            <label class="check"><input type="checkbox" id="hier_stacked" checked> <span>stacked</span></label>
          </div>
        </div>
      </div>

      <p class="spec-frame mono" id="fluxSettingsPreview"></p>
    </div>
  </div>
</div>

<script>
(function () {
  // Prefilled when the inverse twin arrived from a job's preview popup: the path
  // is already in the hidden field, so the thumbnail and the hint have to be put
  // into their "uploaded" state on load rather than waiting for a file pick.
  var carried = {
    // Escaped ONCE, by json_escape, and marked safe so it is not escaped AGAIN.
    //
    // json_escape renders the three markup characters as their unicode escapes,
    // which is what stops an attacker-supplied value from ending this block and
    // becoming markup. It returns a plain String, so without html_safe the
    // template helper escapes the result a SECOND time and the structural quotes
    // arrive as the quot entity. Entities are never decoded inside a script
    // element, so the block stopped being JavaScript at all -- every affordance on
    // this page died while the injection test stayed green, because that test
    // checked the unicode escape was present (it was) and never that the result
    // still parsed. Both halves are required, and neither is a loosening.
    //
    // A NOTE FOR THE NEXT READER, learned the hard way: this comment must not
    // spell out the closing script tag, and must not quote a template tag. The
    // former ends the script element for the HTML parser whatever JavaScript
    // thinks of it, and the latter is evaluated rather than left as prose.
    path: <%= json_escape((params[:input_path].presence || "").to_json).html_safe %>,
    preview: <%= json_escape((params[:preview_url].presence || "").to_json).html_safe %>
  };
  var tile = document.getElementById('uploadTile');
  var fileInput = document.getElementById('sourceFile');
  var pathField = document.getElementById('inputPathField');
  var thumb = document.getElementById('uploadThumb');
  var thumbImg = document.getElementById('thumbImg');
  var thumbMeta = document.getElementById('thumbMeta');
  var hint = document.getElementById('uploadHint');
  var removeBtn = document.getElementById('thumbRemove');

  function humanSize(bytes) {
    if (bytes > 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    return Math.round(bytes / 1024) + ' KB';
  }

  // Apply a SOURCE the page has just acquired, whether it arrived from the file
  // picker or from a drag. ONE place sets the four pieces of state, so a dropped
  // file cannot land differently from an uploaded one.
  function applySource(res, label) {
    pathField.value = res.path;
    thumbImg.src = res.preview_url;
    thumbMeta.textContent = label + ' · ' + humanSize(res.size);
    thumb.style.display = 'flex';
    tile.style.display = 'none';
  }

  if (carried.path) {
    thumbImg.src = carried.preview;
    thumbMeta.textContent = 'inverse twin (PNG)';
    thumb.style.display = 'flex';
    tile.style.display = 'none';
  }

  tile.addEventListener('click', function () { fileInput.click(); });

  fileInput.addEventListener('change', function () {
    var file = fileInput.files[0];
    if (!file) return;
    if (file.size > 50 * 1024 * 1024) {
      hint.textContent = 'Too big — ' + humanSize(file.size) + ' exceeds the 50MB limit.';
      hint.style.color = 'var(--danger)';
      fileInput.value = '';
      return;
    }
    hint.style.color = '';
    hint.textContent = 'Uploading ' + file.name + '…';

    var fd = new FormData();
    fd.append('file', file);
    var csrf = document.querySelector('meta[name="csrf-token"]').content;

    fetch('<%= upload_jobs_path %>', { method: 'POST', headers: { 'X-CSRF-Token': csrf }, body: fd })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || !res.j.path) {
          hint.textContent = res.j.alert || 'Upload failed — try again.';
          hint.style.color = 'var(--danger)';
          return;
        }
        applySource(res.j, file.name);
        hint.textContent = 'Uploaded. The runner will prep this file.';
      })
      .catch(function () {
        hint.textContent = 'Upload failed — network error.';
        hint.style.color = 'var(--danger)';
      });
  });

  removeBtn.addEventListener('click', function () {
    pathField.value = '';
    fileInput.value = '';
    thumb.style.display = 'none';
    tile.style.display = '';
    hint.textContent = 'Click the tile to pick a file — it uploads immediately and shows a small preview.';
    hint.style.color = '';
  });

  // Copy the contract. The textarea is the form field, so the bytes copied are
  // the bytes that will be posted -- not a re-serialised approximation.
  var copyBtn = document.getElementById('copySpecBtn');
  var specField = document.getElementById('job_spec');
  copyBtn.addEventListener('click', function () {
    if (!navigator.clipboard || !specField) return;
    navigator.clipboard.writeText(specField.value).then(function () {
      copyBtn.textContent = 'Copied';
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1400);
    });
  });

  // ===================== template =====================
  // The template control composes a SPEC server-side and hands it back as a
  // draft, rather than writing these panels here. One implementation of the
  // bounds and the coercion, in Ruby, is worth more than a second one here that
  // could disagree with it — and hydratePanels() already knows how to read a
  // spec into the panels, because that is what it was written for.
  var tplSel = document.getElementById('job_template');
  var tplBlurb = document.getElementById('tplBlurb');
  var tplLevers = document.getElementById('tplLevers');
  var tplApply = document.getElementById('tplApplyBtn');

  // The LEVER -> CONTROL map. Keyed by the lever name PipelineConf uses, and
  // read off each option's data-levers so this list is not a second copy of the
  // templates: a template that gains a lever and does not name its control here
  // contributes nothing rather than contributing the wrong control.
  function tplLeverMap(opt) {
    var map = {};
    String(opt.getAttribute('data-levers') || '').split(/\s+/).filter(Boolean).forEach(function (pair) {
      var bits = pair.split('=');
      map[bits[0]] = bits[1];
    });
    return map;
  }

  // A lever's value, read only when its control is ON SCREEN. An off-screen
  // control still holds a value, and posting it would carry a stale number into
  // the contract — the same rule writePanels() follows.
  //
  // `ids` is the whole GROUP for a list lever, and the group's value is the
  // ticked boxes' own values joined — `presets` is three checkboxes, so what
  // the operator chose is "which are ticked", not one field's contents. The
  // server splits the comma string back into the list (PipelineConf.coerce).
  //
  // getClientRects() rather than offsetParent: it answers for a fixed or
  // transformed element too, which offsetParent reports as null regardless.
  function tplLeverValue(ids) {
    var parts = String(ids).split('+');
    var els = parts.map(function (id) { return document.getElementById(id); });
    if (els.some(function (el) { return !el; })) return null;
    if (els.some(function (el) { return el.hidden || !el.getClientRects().length; })) return null;
    if (parts.length > 1) {
      return els.filter(function (el) { return el.checked; })
                .map(function (el) { return el.value; }).join(',');
    }
    var el = els[0];
    if (el.type === 'checkbox') return el.checked ? '1' : '';
    return el.value;
  }

  function renderTemplateNotes() {
    var opt = tplSel.options[tplSel.selectedIndex];
    if (!opt) return;
    if (tplBlurb) tplBlurb.textContent = opt.getAttribute('data-blurb') || '';
    if (!tplLevers) return;
    // The levers a template sets, WITH the value each one would compose — so
    // the control states what it is about to do rather than making the operator
    // apply it and read the contract to find out.
    var names = String(opt.getAttribute('data-levers') || '').split(/\s+/).filter(Boolean);
    var vals = JSON.parse(opt.getAttribute('data-defaults') || '{}');
    tplLevers.innerHTML = '';
    names.forEach(function (name) {
      var dt = document.createElement('dt');
      dt.className = 'mono';
      dt.textContent = name;
      var dd = document.createElement('dd');
      var v = vals[name];
      dd.textContent = (v === null || v === undefined) ? "the service's own" :
        (Array.isArray(v) ? v.join(', ') : String(v));
      tplLevers.appendChild(dt);
      tplLevers.appendChild(dd);
    });
  }

  if (tplSel) {
    tplSel.addEventListener('change', renderTemplateNotes);
    renderTemplateNotes();

    if (tplApply) {
      tplApply.addEventListener('click', function () {
        var opt = tplSel.options[tplSel.selectedIndex];
        if (!opt) return;
        // writePanels() FIRST: the panels are the most recent fact about this
        // contract, and the textarea is only as fresh as the last change event.
        // Without this, a lever the operator moved and then immediately hit
        // Apply would be composed from the textarea's older copy.
        writePanels();
        var map = tplLeverMap(opt);
        var levers = {};
        Object.keys(map).forEach(function (name) {
          var v = tplLeverValue(map[name]);
          if (v !== null) levers[name] = v;
        });
        var fd = new FormData();
        fd.append('template', tplSel.value);
        fd.append('spec', specField.value);
        Object.keys(levers).forEach(function (k) { fd.append('levers[' + k + ']', levers[k]); });
        var csrf = document.querySelector('meta[name="csrf-token"]').content;
        tplApply.disabled = true;
        fetch('<%= use_template_path %>', {
          method: 'POST', headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }, body: fd
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            tplApply.disabled = false;
            if (!res.ok || !res.j.spec) {
              if (tplBlurb) {
                tplBlurb.textContent = res.j.error || 'Could not apply that template.';
                tplBlurb.style.color = 'var(--danger)';
              }
              return;
            }
            if (tplBlurb) tplBlurb.style.color = '';
            // Into the TEXTAREA, then hydrate from it — the one round trip the
            // form already has. Setting the field and calling hydratePanels()
            // is what makes the panels show the template's values without this
            // script knowing where any of them live.
            specField.value = JSON.stringify(res.j.spec, null, 2);
            hydratePanels();
            // A template names a KIND (data-kind), and the runner + the panels
            // must follow it: applying a flux template while a trace runner is
            // selected would file the generation against the wrong runner and
            // show the wrong options. Pick the first runner of the template's
            // own kind, then showKind() reveals that runner's panel.
            var tplKind = opt.getAttribute('data-kind') || 'svg';
            Array.prototype.forEach.call(runnerSel.options, function (ro) {
              if ((ro.getAttribute('data-kind') || 'svg') === tplKind) ro.selected = true;
            });
            showKind();
            renderFluxSummary();
            renderPlotSummary();
            renderBpSummary();
            renderBlenderSummary();
            if (tplBlurb) {
              tplBlurb.textContent = opt.getAttribute('data-blurb') + ' — applied.';
            }
          })
          .catch(function () {
            tplApply.disabled = false;
            if (tplBlurb) {
              tplBlurb.textContent = 'Could not apply that template — network error.';
              tplBlurb.style.color = 'var(--danger)';
            }
          });
      });
    }
  }

  // block submit without what the chosen runner actually needs
  var form = document.getElementById('new-job-form');
  form.addEventListener('submit', function (e) {
    var problem = missingForRun();
    if (problem) {
      e.preventDefault();
      showProblem(problem);
      return;
    }
    writePanels();
  });

  // The head button asks before it spends the job. requestSubmit() rather than
  // submit() so the upload guard above still runs: submit() fires no submit
  // event, so a form with no artwork would post regardless of the check.
  var runBtn = document.getElementById('runJobBtn');
  function reallyRun() {
    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit();
    } else {
      var fixer = document.createElement('input');
      fixer.type = 'hidden';
      fixer.name = 'commit';
      fixer.value = 'Run Job';
      form.appendChild(fixer);
      form.submit();
    }
  }

  runBtn.addEventListener('click', function () {
    // Nothing to run yet -- say so here rather than opening a confirm for a
    // form that cannot submit.
    var problem = missingForRun();
    if (problem) {
      showProblem(problem);
      return;
    }
    writePanels();
    var jobName = (document.getElementById('job_name') || {}).value || '';
    if (!window.CsModal) { reallyRun(); return; }
    window.CsModal.open('Confirm?',
      '<div class="cs-confirm">' +
      '  <p class="cs-confirm-msg">Start this run' +
      (jobName ? ' as <strong>' + jobName.replace(/[<>&]/g, '') + '</strong>' : '') +
      '? It goes straight to the runner, and the run cannot be edited or ' +
      'cancelled once it starts.</p>' +
      '  <div class="cs-confirm-actions">' +
      '    <button type="button" class="btn btn-secondary btn-sm" data-cs-close="1">Cancel</button>' +
      '    <button type="button" class="btn btn-primary btn-sm" id="runJobOk"' +
      '      title="Run this job" aria-label="Run this job">Run Job</button>' +
      '  </div>' +
      '</div>');
    var ok = document.getElementById('runJobOk');
    if (ok) ok.addEventListener('click', function () {
      window.CsModal.close();
      reallyRun();
    });
  });

  // ===================== runner kind =====================
  // The form shows one half or the other. The kind comes off the selected
  // option, so it is the same fact the model uses -- a runner that is not
  // marked flux is a pipeline runner.
  var runnerSel = document.getElementById('job_runner');

  function currentKind() {
    var opt = runnerSel.options[runnerSel.selectedIndex];
    return (opt && opt.getAttribute('data-kind')) || 'svg';
  }

  function showKind() {
    var kind = currentKind();
    Array.prototype.forEach.call(document.querySelectorAll('[data-run-fields]'), function (el) {
      el.hidden = el.getAttribute('data-run-fields') !== kind;
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-run-intro]'), function (el) {
      el.hidden = el.getAttribute('data-run-intro') !== kind;
    });
    // The proof-side opt-in answers a different question -- does this run produce
    // a PROOF -- so it is driven by a LIST of kinds rather than by one, and the
    // raster-only flux mode is excluded inside it. Hiding it is also what stops
    // writePanels() composing it: a control that is off screen must not write
    // into the contract.
    Array.prototype.forEach.call(document.querySelectorAll('[data-proof-fields]'), function (el) {
      var applies = el.getAttribute('data-proof-fields').split(/\s+/).indexOf(kind) !== -1;
      if (applies && kind === 'flux' && fieldValue('flux_mode') === 'raster') applies = false;
      el.hidden = !applies;
    });
  }

  // A problem's home depends on which panel is on screen: the artwork hint
  // lives in the pipeline half, so for flux -- and now plot -- it is inside a
  // hidden block and writing there would be writing to nothing.
  function problemTarget() {
    var kind = currentKind();
    if (kind === 'flux') return document.getElementById('fluxSummary');
    if (kind === 'plot') return document.getElementById('plotSummary');
    if (kind === 'blender') return document.getElementById('blenderSummary');
    if (kind === 'bp') return document.getElementById('bpSummary');
    return hint;
  }

  function showProblem(message) {
    var el = problemTarget();
    if (!el) return;
    el.textContent = message;
    el.style.color = 'var(--danger)';
  }

  // ===================== the panels write into the spec =====================
  // The spec textarea stays the one thing posted and the one thing the runner
  // reads, which is the same arrangement the JSON page uses (fields -> generated
  // JSON). One source of truth, and a hand-edited spec still wins.
  var specField = document.getElementById('job_spec');

  function readSpec() {
    try {
      var parsed = JSON.parse(specField.value || '{}');
      return (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) ? parsed : null;
    } catch (e) {
      return null; // hand-edited and mid-keystroke: never clobber it
    }
  }

  function writeSpec(spec) { specField.value = JSON.stringify(spec, null, 2); }

  function fieldValue(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
  function fieldNum(id) { var v = fieldValue(id); return v ? Number(v) : undefined; }
  function boxOn(id) { var el = document.getElementById(id); return !!(el && el.checked); }
  function csvNames(id) {
    return fieldValue(id).split(',').map(function (s) { return s.trim(); })
      .filter(function (s) { return s.length; });
  }
  function csvNums(id) {
    // A blank entry is dropped BEFORE the numeric coercion: Number('') is 0,
    // which is a real speckle value, so a cleared box used to post
    // `filter_speckle: [0]` — an axis nobody asked for. Blank means the tool's
    // own list.
    return fieldValue(id).split(',').map(function (s) { return s.trim(); })
      .filter(function (s) { return s.length > 0; })
      .map(function (s) { return Number(s); })
      .filter(function (n) { return !isNaN(n) && n >= 0; });
  }

  function selectedValues(sel) {
    if (!sel) return [];
    return Array.prototype.slice.call(sel.options)
      .filter(function (o) { return o.selected && o.value; })
      .map(function (o) { return o.value; });
  }

  // `name=scale` pairs, filtered to the modifiers that are actually selected: a
  // pair naming something that is not in the stack is a typo, and sending it
  // would be a scale for an adapter the service is not loading.
  function modifierScales(selected) {
    var scales = {};
    fieldValue('flux_modifier_scales').split(',').forEach(function (pair) {
      var bits = pair.split('=');
      if (bits.length !== 2) return;
      var key = bits[0].trim(), raw = bits[1].trim(), scale = Number(raw);
      if (!key || raw === '' || isNaN(scale)) return;
      if (selected.indexOf(key) === -1) return;
      scales[key] = scale;
    });
    return scales;
  }

  // ===================== the registry's own gating =====================
  // The modifier list and the VAE list are rebuilt down to the chosen model's
  // `targets` every time the model changes. The registry is the SERVER's — every
  // option arrives with its targets in data-targets and nothing here re-types a
  // licence or a target list — and the filter is applied to the OPTIONS rather
  // than to the fields, because a <select> cannot hide an option the way a field
  // hides itself. A selection that the filter drops is one that could not have
  // loaded, so dropping it is the honest answer.
  var modifiersSel = document.getElementById('flux_modifiers');
  var vaeSel = document.getElementById('flux_vae');
  var modifiersHint = document.getElementById('fluxModifiersHint');
  var modifiersEmpty = document.getElementById('fluxModifiersEmpty');
  // Set from the spec on hydrate, consumed by the first filter: the spec is the
  // authority on what was asked for, and the filter decides what is still legal.
  var pendingModifiers = null;
  var pendingVae = null;

  function snapshotOptions(sel) {
    return Array.prototype.slice.call(sel.options).map(function (o) {
      return { value: o.value, text: o.textContent,
               title: o.getAttribute('title') || '',
               targets: (o.getAttribute('data-targets') || '').split(',').filter(Boolean),
               unfiltered: !o.getAttribute('data-targets') };
    });
  }

  var ALL_MODIFIERS = modifiersSel ? snapshotOptions(modifiersSel) : [];
  var ALL_VAES = vaeSel ? snapshotOptions(vaeSel) : [];

  function rebuildOptions(sel, all, model, wanted) {
    if (!sel) return;
    sel.textContent = '';
    all.forEach(function (spec) {
      // An unfiltered option is one the registry did not scope to a model -- the
      // VAE list's "(the model's own decoder)" -- so it is always offered.
      if (!spec.unfiltered && spec.targets.indexOf(model) === -1) return;
      var opt = document.createElement('option');
      opt.value = spec.value;
      opt.textContent = spec.text;
      if (spec.title) opt.setAttribute('title', spec.title);
      if (spec.targets.length) opt.setAttribute('data-targets', spec.targets.join(','));
      if (wanted.indexOf(spec.value) !== -1) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  function syncRegistry() {
    var model = fieldValue('flux_model') || FACTS.constraints.defaultModel;
    var wanted = pendingModifiers || selectedValues(modifiersSel);
    rebuildOptions(modifiersSel, ALL_MODIFIERS, model, wanted);
    var wantedVae = pendingVae !== null ? pendingVae : (vaeSel ? vaeSel.value : '');
    rebuildOptions(vaeSel, ALL_VAES, model, [wantedVae]);
    pendingModifiers = null;
    pendingVae = null;
    // A model nothing targets gets an empty control AND the reason it is empty,
    // rather than a control that looks like it should do something.
    var available = modifiersSel ? modifiersSel.options.length : 0;
    if (modifiersHint) modifiersHint.hidden = available === 0;
    if (modifiersEmpty) modifiersEmpty.hidden = available !== 0;
    if (modifiersSel) modifiersSel.hidden = available === 0;
  }

  function fluxBlock() {
    var b = { prompt: fieldValue('flux_prompt'), mode: fieldValue('flux_mode') || 'trace' };
    var m = fieldValue('flux_model'); if (m) b.model = m;
    var w = fieldNum('flux_width'); if (w) b.width = w;
    var h = fieldNum('flux_height'); if (h) b.height = h;
    var st = fieldNum('flux_steps'); if (st) b.steps = st;
    var g = fieldValue('flux_guidance'); if (g) b.guidance = Number(g);
    var sd = fieldValue('flux_seed'); if (sd) b.seed = Number(sd);
    var img = fieldNum('flux_images'); if (img && img > 1) b.images = img;
    // A negative prompt is only composed for a model that has one — on a
    // distilled klein it would be a no-op the service reports as a warning.
    var neg = negpromptModel() ? fieldValue('flux_negative_prompt') : '';
    if (neg) b.negative_prompt = neg;
    // And a strength only for an SD-style model AND an edit: with no reference
    // this is a text-to-image call, and the engine ignores a strength there.
    var str = fieldValue('flux_strength');
    if (str && img2imgModel() && refName()) b.strength = Number(str);
    // The LoRA stack and the decoder swap, from the registry's own lists. A
    // scale is composed ONLY for a modifier that is actually selected, so a
    // stale pair left in the box cannot travel as a scale for something that is
    // not being loaded; and the whole key is left out when nothing was chosen,
    // so blank means the service's default rather than an empty stack.
    var mods = selectedValues(modifiersSel);
    if (mods.length) b.modifiers = mods;
    var scales = modifierScales(mods);
    if (Object.keys(scales).length) b.modifier_scales = scales;
    var vae = fieldValue('flux_vae');
    if (vae) b.vae = vae;
    // THE SET. The first reference stays on the singular `image` key so a
    // single-reference request is byte-for-byte what it always was, and the
    // extras go out as `references` in the order they were attached. The service
    // reads both and conditions on all of them (Job#flux_reference_spec_values is
    // where the reader on this side is pinned).
    //
    // The gate re-checked HERE, not only in `enforceRefGate`, because the spec is
    // also composed from a RESTORED contract and from the JSON page, and a
    // second reference on a single-reference model must not ride out in either
    // case -- the service would 400 it after the GPU has been paid for.
    var refs = refNames.slice();
    if (!multirefModel()) refs = refs.slice(0, 1);
    if (refs.length) {
      b.image = refs[0];
      if (refs.length > 1) b.references = refs.slice(1);
    }
    return b;
  }

  // ===================== the plot panel =====================
  // The document and the run records are PASTED text, so they are parsed here,
  // in the browser, and only a parse that SUCCEEDS is composed into the spec. A
  // document that does not parse is reported as a form error and the run is
  // refused before anything is posted -- an invalid paste is a typo to fix, not
  // a job to queue and be told about later.
  function parseJsonField(id) {
    var raw = fieldValue(id);
    if (!raw) return { ok: false, empty: true, error: 'nothing to parse' };
    try {
      return { ok: true, value: JSON.parse(raw) };
    } catch (e) {
      return { ok: false, error: e.message };
    }
  }

  function plotDocParsed() { return parseJsonField('plot_doc'); }

  // A query's records are a LIST, so an array is the only shape that counts: a
  // bare object is one record, not the record SET the engine draws across.
  function plotRunsParsed() {
    var parsed = parseJsonField('plot_runs');
    if (!parsed.ok) return parsed;
    if (!Array.isArray(parsed.value)) {
      return { ok: false, error: 'the run records must be a JSON array' };
    }
    return parsed;
  }

  function plotOp() { return fieldValue('plot_op') || 'generate'; }

  // The spec's plot block: the operation, the parsed document, and -- for a
  // query -- the parsed run records. Composed only from values that parsed,
  // because the caller checks first.
  function plotBlock() {
    var block = { op: plotOp(), doc: plotDocParsed().value };
    if (block.op === 'query') block.runs = plotRunsParsed().value;
    return block;
  }

  function renderPlotSummary() {
    var el = document.getElementById('plotSummary');
    if (!el) return;
    var doc = plotDocParsed();
    var bits = [plotOp()];
    if (plotOp() === 'query') {
      var runs = plotRunsParsed();
      bits.push(runs.ok ? runs.value.length + ' run records' : 'run records not parsed');
    }
    bits.push(doc.ok ? 'document parses' : 'no document yet');
    el.textContent = doc.ok ? bits.join(' · ') : '';
    el.style.color = doc.ok ? '' : 'var(--warning)';
  }

  // The document and the records are hydrated from the spec on load, exactly as
  // the flux panel's are: a hand-written spec is the authority and the pasted
  // text is a view of it until the operator edits it.
  function hydratePlot() {
    var spec = readSpec();
    if (!spec) return;
    var pl = (spec.plot && typeof spec.plot === 'object') ? spec.plot : null;
    if (!pl) return;
    if (pl.op) document.getElementById('plot_op').value = pl.op;
    if (pl.doc) document.getElementById('plot_doc').value = JSON.stringify(pl.doc, null, 2);
    if (pl.runs) document.getElementById('plot_runs').value = JSON.stringify(pl.runs, null, 2);
  }

  // ===================== the blender panel =====================
  // The same rule as the plot panel's, one step simpler: there is ONE pasted
  // document (the geometry) and no operation to choose -- the route IS the
  // operation -- so a paste that does not parse is the only thing that can be
  // wrong here, and it is refused in the form rather than by the service.
  function blenderDocParsed() { return parseJsonField('blender_doc'); }

  // The spec's blender block: the parsed geometry document. Composed only from a
  // document that parsed, because the caller checks first.
  function blenderBlock() { return { doc: blenderDocParsed().value }; }

  function renderBlenderSummary() {
    var el = document.getElementById('blenderSummary');
    if (!el) return;
    var doc = blenderDocParsed();
    if (!doc.ok) { el.textContent = ''; el.style.color = 'var(--warning)'; return; }
    // What the document ASKS FOR, read out of the document itself: the studio
    // does not restate the contract's defaults here, and a document that names
    // no views is the service's default rather than a guess made in this panel.
    var d = (doc.value && typeof doc.value === 'object') ? doc.value : {};
    var bits = [];
    if (Array.isArray(d.elements)) bits.push(d.elements.length + ' element(s)');
    var render = (d.render && typeof d.render === 'object') ? d.render : {};
    if (render.views) bits.push(render.views + ' view(s)');
    if (render.engine) bits.push(render.engine);
    if (d.export && d.export.glb) bits.push('glb export');
    bits.push('document parses');
    el.textContent = bits.join(' · ');
    el.style.color = '';
  }

  // Hydrated from the spec on load, like the plot panel's: a hand-written spec
  // is the authority and the pasted text is a view of it until it is edited.
  function hydrateBlender() {
    var spec = readSpec();
    if (!spec) return;
    var bl = (spec.blender && typeof spec.blender === 'object') ? spec.blender : null;
    if (bl && bl.doc) {
      document.getElementById('blender_doc').value = JSON.stringify(bl.doc, null, 2);
    }
  }

  // ===================== the bp panel =====================
  // ONE action over the whole blend-plot service. The document and the run
  // records are PASTED, so they are parsed here, in the browser, exactly as the
  // two panels this replaces did, and only a parse that SUCCEEDS is composed.
  function bpOp() { return fieldValue('bp_op') || 'generate'; }
  function bpDocParsed() { return parseJsonField('bp_doc'); }

  function bpRunsParsed() {
    var parsed = parseJsonField('bp_runs');
    if (!parsed.ok) return parsed;
    if (!Array.isArray(parsed.value)) {
      return { ok: false, error: 'the run records must be a JSON array' };
    }
    return parsed;
  }

  // Only a query draws ACROSS runs. A `runs` field sent with any other operation
  // is a field the service refuses, so it is composed for this one op alone.
  function bpTakesRuns() { return bpOp() === 'query'; }

  // The spec's bp block: the operation, the parsed document, and -- for a query
  // -- the parsed run records. Composed only from values that parsed, because
  // every caller checks first.
  function bpBlock() {
    var block = { op: bpOp(), doc: bpDocParsed().value };
    if (bpTakesRuns()) block.runs = bpRunsParsed().value;
    return block;
  }

  function renderBpSummary() {
    var el = document.getElementById('bpSummary');
    if (!el) return;
    var doc = bpDocParsed();
    var bits = [bpOp()];
    if (bpTakesRuns()) {
      var runs = bpRunsParsed();
      bits.push(runs.ok ? runs.value.length + ' run records' : 'run records not parsed');
    }
    bits.push(doc.ok ? 'document parses' : 'no document yet');
    el.textContent = doc.ok ? bits.join(' · ') : '';
    el.style.color = doc.ok ? '' : 'var(--warning)';
  }

  // Hydrated from the spec on load, like the panels it replaces: a hand-written
  // spec is the authority and the pasted text is a view of it until edited.
  function hydrateBp() {
    var spec = readSpec();
    if (!spec) return;
    var bp = (spec.bp && typeof spec.bp === 'object') ? spec.bp : null;
    if (!bp) return;
    if (bp.op) document.getElementById('bp_op').value = bp.op;
    if (bp.doc) document.getElementById('bp_doc').value = JSON.stringify(bp.doc, null, 2);
    if (bp.runs) document.getElementById('bp_runs').value = JSON.stringify(bp.runs, null, 2);
    hydrateBpRender(bp.doc);
  }

  // The render controls are a VIEW of the pasted document, not a second copy of
  // it: hydrate reads them out of `render`, and every change writes them back
  // in and re-serializes the textarea. The contract is still the only thing
  // posted, and the JSON box still shows exactly what will run — a control that
  // lived only in the DOM would be a second place to edit the same number.
  // lever id -> where it lives in the pasted document. `render` is the render
  // block, `render.size` the nested frame size, `extrude` the document's own
  // solid block (depth and bevel are NOT render fields — putting them there
  // would be a field bp refuses under `render`, and the refusal names the block
  // rather than the value, which is the least debuggable shape).
  var BP_RENDER_FIELDS = {
    bp_render_width:  ['render.size', 'width'],
    bp_render_height: ['render.size', 'height'],
    bp_background:    ['render', 'background'],
    bp_projection:    ['render', 'projection'],
    bp_elevation:     ['render', 'elevation'],
    bp_azimuth:       ['render', 'azimuth'],
    bp_views:         ['render', 'views'],
    bp_engine:        ['render', 'engine'],
    bp_depth:         ['extrude', 'depth'],
    bp_bevel_depth:   ['extrude', 'bevel_depth']
  };
  // Which of them are NUMBERS. bp is strict here: `views` is an integer, not
  // the string a <select> hands back, and `elevation: "25"` is a refusal.
  var BP_RENDER_NUMERIC = ['width', 'height', 'elevation', 'azimuth',
                           'views', 'depth', 'bevel_depth'];

  function bpContainer(doc, path) {
    var node = doc;
    path.split('.').forEach(function (part) {
      if (!node[part] || typeof node[part] !== 'object') node[part] = {};
      node = node[part];
    });
    return node;
  }

  function hydrateBpRender(doc) {
    if (!doc || typeof doc !== 'object') return;
    Object.keys(BP_RENDER_FIELDS).forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      var place = BP_RENDER_FIELDS[id];
      var path = place[0], key = place[1];
      var node = path === 'render' ? (doc.render || {})
               : path === 'render.size' ? ((doc.render || {}).size || {})
               : (doc[path] || {});
      var value = node[key];
      if (value === undefined || value === null) return;   // keep the control's default
      el.value = String(value);
    });
  }

  function applyBpRenderControls() {
    if (!bpIsBlender()) return;
    var parsed = bpDocParsed();
    if (!parsed.ok) return;   // a half-typed paste is not a reason to lose the controls
    var doc = parsed.value;
    Object.keys(BP_RENDER_FIELDS).forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      var place = BP_RENDER_FIELDS[id];
      var path = place[0], key = place[1];
      var raw = el.value;
      // Blank means "the service's own default", so the KEY GOES: bp resolves an
      // absent field, where an explicit null would be a refusal.
      if (raw === '') {
        var holder = path === 'render' ? doc.render
                   : path === 'render.size' ? ((doc.render || {}).size || null)
                   : doc[path];
        if (holder && typeof holder === 'object') delete holder[key];
        return;
      }
      var value = BP_RENDER_NUMERIC.indexOf(key) >= 0 ? Number(raw) : raw;
      bpContainer(doc, path)[key] = value;
    });
    document.getElementById('bp_doc').value = JSON.stringify(doc, null, 2);
    writePanels();
    renderBpSummary();
  }

  // ===================== the sequence =====================
  // An ordered step list in ONE job. The rows compose `spec["steps"]` -- the same
  // per-kind blocks the panels above compose, one per step -- so a step IS the
  // single-action request and a document is defined in one place rather than in a
  // second copy that can disagree with it.
  //
  // The STUDIO drives the chain, not the runner: RunJob posts a step, waits, then
  // posts the next with the previous one's file handed in. Nothing here has to
  // know that -- a row names a runner and carries a block -- but it is why the
  // order in this list is the order they run.
  var seqOnBox = document.getElementById('seq_on');
  var seqBody = document.getElementById('seqBody');
  var stepsList = document.getElementById('stepsList');

  function seqOn() { return !!(seqOnBox && seqOnBox.checked); }

  function stepRows() {
    return stepsList ? Array.prototype.slice.call(stepsList.querySelectorAll('[data-step]')) : [];
  }

  function kindOf(sel) {
    var opt = sel.options[sel.selectedIndex];
    return (opt && opt.getAttribute('data-kind')) || 'svg';
  }

  // The runner choices are the FORM's own list, cloned rather than re-typed: a
  // step names the same labels the job's own runner select offers, with the same
  // data-kind, so the two cannot drift.
  function stepRunnerSelect(selected) {
    var sel = document.createElement('select');
    sel.setAttribute('data-step-runner', '');
    var source = runnerSel.options;
    for (var i = 0; i < source.length; i++) {
      var opt = document.createElement('option');
      opt.value = source[i].value;
      opt.textContent = source[i].value;
      var kind = source[i].getAttribute('data-kind');
      if (kind) opt.setAttribute('data-kind', kind);
      if (source[i].value === selected) opt.selected = true;
      sel.appendChild(opt);
    }
    return sel;
  }

  function stepInputSelect(selected) {
    var sel = document.createElement('select');
    sel.setAttribute('data-step-input', '');
    [['', 'input: auto'], ['previous', 'input: previous'], ['job', 'input: job']].forEach(function (pair) {
      var opt = document.createElement('option');
      opt.value = pair[0];
      opt.textContent = pair[1];
      if (pair[0] === (selected || '')) opt.selected = true;
      sel.appendChild(opt);
    });
    return sel;
  }

  function stepButton(attr, label, title) {
    var b = document.createElement('button');
    b.type = 'button';
    b.setAttribute(attr, '');
    b.className = 'step-btn';
    b.textContent = label;
    b.title = title;
    b.setAttribute('aria-label', title);
    return b;
  }

  function makeStepRow(step) {
    var row = document.createElement('div');
    row.className = 'step-row';
    row.setAttribute('data-step', '');

    var badge = document.createElement('span');
    badge.className = 'step-n mono';
    badge.setAttribute('data-step-n', '');

    var block = {};
    if (step) {
      // Everything that is not the runner or the hand-off IS the step's block,
      // under the kind's own key -- the shape the model reads.
      Object.keys(step).forEach(function (k) {
        if (k !== 'runner' && k !== 'input') block = step[k];
      });
    }

    var body = document.createElement('textarea');
    body.className = 'mono step-block';
    body.setAttribute('data-step-block', '');
    body.rows = 4;
    body.spellcheck = false;
    body.value = JSON.stringify(block || {}, null, 2);

    var actions = document.createElement('div');
    actions.className = 'step-actions';
    actions.appendChild(stepButton('data-step-up', '\u2191', 'Move this step earlier'));
    actions.appendChild(stepButton('data-step-down', '\u2193', 'Move this step later'));
    actions.appendChild(stepButton('data-step-del', '\u00d7', 'Remove this step'));

    row.appendChild(badge);
    row.appendChild(stepRunnerSelect(step && step.runner));
    row.appendChild(stepInputSelect(step && step.input));
    row.appendChild(body);
    row.appendChild(actions);
    return row;
  }

  // The ordinal is re-stamped after every change, so the list always reads as the
  // ORDER it runs -- the numbers are the instruction, not decoration.
  function restampSteps() {
    stepRows().forEach(function (row, i) {
      row.querySelector('[data-step-n]').textContent = String(i + 1);
    });
  }

  function addStep(step) {
    if (!stepsList) return;
    stepsList.appendChild(makeStepRow(step || { runner: (runnerSel.value || 'svg') }));
    restampSteps();
  }

  function moveStep(row, delta) {
    var rows = stepRows();
    var i = rows.indexOf(row);
    var j = i + delta;
    if (i < 0 || j < 0 || j >= rows.length) return;
    if (delta < 0) stepsList.insertBefore(row, rows[j]);
    else stepsList.insertBefore(rows[j], row);
    restampSteps();
  }

  // The parsed step list, or the first thing wrong with it BY STEP INDEX -- the
  // same numbering the model's own validation messages use.
  function readSteps() {
    var out = [];
    var rows = stepRows();
    for (var i = 0; i < rows.length; i++) {
      var n = i + 1;
      var row = rows[i];
      var sel = row.querySelector('[data-step-runner]');
      var raw = row.querySelector('[data-step-block]').value.trim();
      if (!raw) return { ok: false, error: 'step ' + n + ' needs a document' };
      var parsed;
      try {
        parsed = JSON.parse(raw);
      } catch (e) {
        return { ok: false, error: 'step ' + n + ' is not valid JSON: ' + e.message };
      }
      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
        return { ok: false, error: 'step ' + n + ' must be a JSON object' };
      }
      var step = { runner: sel.value };
      var decl = row.querySelector('[data-step-input]').value;
      if (decl) step.input = decl;
      step[kindOf(sel)] = parsed;
      out.push(step);
    }
    return { ok: true, value: out };
  }

  function renderSeqSummary() {
    var el = document.getElementById('seqSummary');
    if (!el) return;
    if (!seqOn()) { el.textContent = ''; return; }
    var rows = stepRows();
    if (!rows.length) {
      el.textContent = 'No steps yet \u2014 add one.';
      el.style.color = 'var(--warning)';
      return;
    }
    var all = readSteps();
    if (!all.ok) {
      el.textContent = all.error.charAt(0).toUpperCase() + all.error.slice(1) + '.';
      el.style.color = 'var(--danger)';
      return;
    }
    el.textContent = rows.length + ' step' + (rows.length === 1 ? '' : 's') +
      ' \u2014 ' + all.value.map(function (x) { return x.runner; }).join(' \u2192 ');
    el.style.color = '';
  }

  // Hydrated from the spec on load, like every other panel: a hand-written or
  // restored contract is the authority and the rows are a view of it.
  function hydrateSeq() {
    var spec = readSpec();
    if (!spec) return;
    var list = spec.steps;
    if (!Array.isArray(list) || !list.length) return;
    seqOnBox.checked = true;
    seqBody.hidden = false;
    list.forEach(function (step) { addStep(step); });
  }

  // These mirror the JSON page's blocks key for key, because they are the same
  // keys the pipeline reads -- a near-miss here would be a control that silently
  // does nothing.
  function prepExpandBlock() {
    var px = {};
    if (boxOn('pe_filters')) {
      var fl = { contact_sheet: boxOn('pe_filters_sheet') };
      var fp = csvNames('pe_filters_presets'); if (fp.length) fl.presets = fp;
      // keep_alpha and spec are the tool's own default off / its own spec.json,
      // so they are written only when asked for -- an untouched bench still
      // composes the block it always did.
      if (boxOn('pe_filters_alpha')) fl.keep_alpha = true;
      var fsp = fieldValue('pe_filters_spec'); if (fsp) fl.spec = fsp;
      px.filters = fl;
    }
    if (boxOn('pe_tune')) {
      var tn = { contact_sheet: boxOn('pe_tune_sheet') };
      var tp = csvNames('pe_tune_presets'); if (tp.length) tn.presets = tp;
      var tc = fieldNum('pe_tune_cells'); if (tc) tn.max_cells = tc;
      var ts = csvNums('pe_tune_speckle'); if (ts.length) tn.filter_speckle = ts;
      var th = csvNames('pe_tune_hier'); if (th.length) tn.hierarchical = th;
      if (boxOn('pe_tune_nr')) tn.with_node_reduce = true;
      px.tune = tn;
    }
    if (boxOn('pe_nr')) {
      var nr = { verify: boxOn('pe_nr_verify') };
      var nn = fieldNum('pe_nr_nodes'); if (nn) nr.max_nodes = nn;
      // 0 is a real tolerance, so these are tested against undefined rather
      // than for truth. Blank is the tool's own value.
      var nt = fieldNum('pe_nr_tolerance');
      if (nt !== undefined && nt >= 0) nr.tolerance = nt;
      var nc = fieldNum('pe_nr_tolerance_cap');
      if (nc !== undefined && nc >= 0) nr.tolerance_cap = nc;
      px.node_reduce = nr;
    }
    return px;
  }

  // The prep-stage switches, which are NOT under print.prep_expand: prep_raster.py
  // reads them at the top level of print, so they are composed the same way and
  // merged into print rather than nested. Both are omitted unless touched, so a
  // popup nobody has opened still composes the contract it composed before they
  // existed. prep_colors takes an integer OR the literal null ("no quantisation"),
  // which is why the null case survives as null instead of collapsing to 0.
  function rasterPrepBlock() {
    var rp = {};
    if (boxOn('pe_opaque_bg')) rp.assume_opaque_bg = true;
    var raw = fieldValue('pe_prep_colors');
    if (raw === 'null') {
      rp.prep_colors = null;
    } else if (raw) {
      var n = Number(raw);
      if (n > 0) rp.prep_colors = n;
    }
    return rp;
  }

  function sweepBlock() {
    var sw = {};
    var presets = ['bw', 'poster', 'photo'].filter(function (p) { return boxOn('sweep_' + p); });
    if (presets.length) sw.presets = presets;
    var mx = fieldNum('sweep_max'); if (mx) sw.max_candidates = mx;
    var sp = csvNums('sweep_speckle'); if (sp.length) sw.filter_speckle = sp;
    var hier = ['cutout', 'stacked'].filter(function (h) { return boxOn('hier_' + h); });
    if (hier.length) sw.hierarchical = hier;
    return sw;
  }

  function writePanels() {
    // Everything the current runner / model / mode decides about what is ON
    // SCREEN is re-derived FIRST, so the spec is never composed from a stale
    // visibility: a control that has just been hidden by a model or mode change
    // must stop writing into the contract on the same change, not one change
    // later. Neither call writes back to the spec, so this cannot loop.
    showKind();
    updateModelGates();

    var spec = readSpec();
    if (!spec) return;
    if (seqOn()) {
      // A sequence IS the request: composing the single-action block as well
      // would leave two answers in one contract. The panels below are SKIPPED
      // rather than cleared, so unticking the box restores what was typed.
      var all = readSteps();
      if (all.ok && all.value.length) spec.steps = all.value;
    } else if (currentKind() === 'flux') {
      spec.flux = fluxBlock();
      spec.print = spec.print || {};
      if (fieldValue('flux_mode') === 'trace') {
        var sw = sweepBlock(); if (Object.keys(sw).length) spec.print.sweep = sw;
        var px = prepExpandBlock(); if (Object.keys(px).length) spec.print.prep_expand = px;
        // The two prep-stage switches, merged at the top level of print where
        // prep_raster.py reads them. Set -> written; cleared -> REMOVED, so a
        // switch turned back off cannot leave a stale value behind.
        var rp = rasterPrepBlock();
        if ('assume_opaque_bg' in rp) spec.print.assume_opaque_bg = rp.assume_opaque_bg;
        else delete spec.print.assume_opaque_bg;
        if ('prep_colors' in rp) spec.print.prep_colors = rp.prep_colors;
        else delete spec.print.prep_colors;
      } else {
        // "keep the raster" has no tracing, so a raster-pass block would be
        // configuration for a stage that never runs. Dropped rather than left
        // looking meaningful.
        delete spec.print.prep_expand;
        delete spec.print.sweep;
        delete spec.print.assume_opaque_bg;
        delete spec.print.prep_colors;
      }
    } else if (currentKind() === 'plot') {
      // Only a document that PARSES is composed: a half-typed textarea must not
      // replace a good contract with a broken one. A refused submit is where the
      // operator is told, not a silent overwrite here.
      if (plotDocParsed().ok) spec.plot = plotBlock();
    } else if (currentKind() === 'blender') {
      // The same rule, one document: a paste that does not parse leaves the job
      // contract exactly as it was written by hand.
      if (blenderDocParsed().ok) spec.blender = blenderBlock();
    } else if (currentKind() === 'bp') {
      // The combined action: the operation, the document, and the run records
      // when the operation is a query. Same rule again -- only a document that
      // PARSES is composed, so a half-typed textarea cannot replace a good
      // contract with a broken one.
      if (bpDocParsed().ok) spec.bp = bpBlock();
    }
    // The proof-side opt-in composes `validation.variants` — the block the back
    // half already reads, beside run_preflight — and NOTHING under `flux`: it is
    // the print check that writes the dataset, not the generator. Unticking it
    // REMOVES the key rather than writing false, so a run that did not ask for a
    // dataset produces exactly the contract it produced before this existed.
    var pvBlock = document.getElementById('proofVariantsBlock');
    var wantVariants = !!(pvBlock && !pvBlock.hidden && boxOn('proof_variants'));
    var validation = (spec.validation && typeof spec.validation === 'object') ? spec.validation : {};
    if (wantVariants) {
      // `true` asks for the whole vocabulary; a named subset is the OBJECT form
      // the print check also accepts ({enabled: true, transforms: [...]}). Both
      // reach the same key, and the runner -- never this page -- owns the names:
      // a name outside its vocabulary is refused with the list quoted.
      var pvt = csvNames('proof_variant_transforms');
      validation.variants = pvt.length ? { enabled: true, transforms: pvt } : true;
    } else {
      delete validation.variants;
    }
    if (Object.keys(validation).length) { spec.validation = validation; } else { delete spec.validation; }
    // Unticking the sequence REMOVES the key rather than leaving a chain behind
    // in a contract that no longer claims to be one.
    if (!seqOn()) delete spec.steps;
    writeSpec(spec);
    renderFluxSummary();
    renderPlotSummary();
    renderBlenderSummary();
    renderBpSummary();
    renderSeqSummary();
  }

  // What the panel is currently set to produce, in one line, so the state of the
  // popup is visible without opening it.
  function renderFluxSummary() {
    var el = document.getElementById('fluxSummary');
    if (!el) return;
    var bits = [];
    var m = fieldValue('flux_model'); if (m) bits.push(m);
    bits.push(fieldValue('flux_width') + '×' + fieldValue('flux_height'));
    var img = fieldNum('flux_images');
    if (img && img > 1) bits.push('×' + img + ' variations');
    var pe = prepExpandBlock();
    var passes = Object.keys(pe);
    if (passes.length) bits.push(passes.join(' + '));
    bits.push(fieldValue('flux_mode') === 'raster' ? 'raster only' : 'then traced');
    el.textContent = bits.join(' · ');
    el.style.color = '';
  }

  // Hydrate the panels FROM the spec, once, on load: a hand-written spec or a
  // generated one is the authority, and the panels are a view of it until the
  // operator touches them.
  function hydratePanels() {
    var spec = readSpec();
    if (!spec) return;
    var f = (spec.flux && typeof spec.flux === 'object') ? spec.flux : null;
    if (f) {
      if (f.prompt) document.getElementById('flux_prompt').value = f.prompt;
      if (f.mode) document.getElementById('flux_mode').value = f.mode;
      if (f.model) document.getElementById('flux_model').value = f.model;
      if (f.width) document.getElementById('flux_width').value = f.width;
      if (f.height) document.getElementById('flux_height').value = f.height;
      if (f.steps) document.getElementById('flux_steps').value = f.steps;
      if (f.guidance !== undefined && f.guidance !== null) {
        document.getElementById('flux_guidance').value = f.guidance;
      }
      if (f.seed !== undefined && f.seed !== null) {
        document.getElementById('flux_seed').value = f.seed;
      }
      if (f.images) document.getElementById('flux_images').value = f.images;
      if (f.negative_prompt) document.getElementById('flux_negative_prompt').value = f.negative_prompt;
      if (f.strength !== undefined && f.strength !== null) {
        document.getElementById('flux_strength').value = f.strength;
      }
      // The LoRA stack and the decoder swap are handed to the FILTER rather than
      // applied here: the spec is the authority on what was asked for, and
      // syncRegistry (run on the model change and on init) is what decides which
      // of those are still legal for the model in the box.
      if (Array.isArray(f.modifiers)) pendingModifiers = f.modifiers.slice();
      if (f.vae !== undefined && f.vae !== null) pendingVae = String(f.vae);
      if (f.modifier_scales && typeof f.modifier_scales === 'object') {
        document.getElementById('flux_modifier_scales').value = Object.keys(f.modifier_scales)
          .map(function (k) { return k + '=' + f.modifier_scales[k]; }).join(', ');
      }
      if (f.image) {
        // The names are all the spec carries. There is no preview to rebuild from
        // them, so the tiles say what they are rather than showing broken images.
        //
        // `references` is read back as well as `image`, in the same order the
        // service would have received them, so a restored multi-reference
        // contract round-trips: without this the extras would be dropped from the
        // form on load and the operator's next unrelated edit would write the
        // spec back with one reference -- a silent narrowing of what they asked
        // for, on a form that looked unchanged.
        refNames = [String(f.image)];
        if (Array.isArray(f.references)) {
          f.references.forEach(function (n) {
            if (n !== null && n !== undefined && String(n).trim() !== '') {
              refNames.push(String(n).trim());
            }
          });
        } else if (typeof f.references === 'string' && f.references.trim() !== '') {
          // A bare string is one more reference, not a list -- see
          // Job#flux_reference_spec_values.
          refNames.push(f.references.trim());
        }
        refMeta.textContent = refNames[0] + ' (from the spec)';
        renderRefSlots();
        if (refNames.length > 1) {
          refHint.textContent = refNames.length + ' references (from the spec).';
          refHint.style.color = '';
        }
      } else {
        // No image in the spec means no references, whatever a stale tile showed.
        // Restoring a contract without a reference must not leave the form
        // claiming one, or the next write puts it back.
        refNames = [];
        renderRefSlots();
      }
    }
    // The proof-side opt-in is read back from the same block it writes to, so a
    // restored or hand-written contract shows its true state rather than an
    // unticked box over a spec that asks for a dataset.
    var vd = (spec.validation && typeof spec.validation === 'object') ? spec.validation : {};
    var pvBox = document.getElementById('proof_variants');
    if (pvBox && vd.variants) pvBox.checked = true;
    // The OBJECT form (`{enabled: true, transforms: [...]}`) is a subset request,
    // and its names go back into the box that composes them -- a hand-written
    // subset that did not survive the round trip would be silently widened to
    // the whole vocabulary on the next panel change.
    if (vd.variants && typeof vd.variants === 'object' && Array.isArray(vd.variants.transforms)) {
      document.getElementById('proof_variant_transforms').value = vd.variants.transforms.join(', ');
    }
    var pr = (spec.print && typeof spec.print === 'object') ? spec.print : {};
    // The prep-stage switches, which live at the top level of print.
    if (pr.assume_opaque_bg) document.getElementById('pe_opaque_bg').checked = true;
    if (pr.prep_colors === null) {
      document.getElementById('pe_prep_colors').value = 'null';
    } else if (pr.prep_colors !== undefined && pr.prep_colors !== '') {
      document.getElementById('pe_prep_colors').value = pr.prep_colors;
    }
    var px = pr.prep_expand || {};
    if (px.filters) {
      document.getElementById('pe_filters').checked = true;
      document.getElementById('pe_filters_sheet').checked = px.filters.contact_sheet !== false;
      if (px.filters.presets) document.getElementById('pe_filters_presets').value = px.filters.presets.join(', ');
      document.getElementById('pe_filters_alpha').checked = !!px.filters.keep_alpha;
      if (px.filters.spec) document.getElementById('pe_filters_spec').value = px.filters.spec;
    }
    if (px.tune) {
      document.getElementById('pe_tune').checked = true;
      document.getElementById('pe_tune_sheet').checked = px.tune.contact_sheet !== false;
      if (px.tune.presets) document.getElementById('pe_tune_presets').value = px.tune.presets.join(', ');
      if (px.tune.max_cells) document.getElementById('pe_tune_cells').value = px.tune.max_cells;
      if (px.tune.filter_speckle) document.getElementById('pe_tune_speckle').value = px.tune.filter_speckle.join(', ');
      if (px.tune.hierarchical) document.getElementById('pe_tune_hier').value = px.tune.hierarchical.join(', ');
      document.getElementById('pe_tune_nr').checked = !!px.tune.with_node_reduce;
    }
    if (px.node_reduce) {
      document.getElementById('pe_nr').checked = true;
      document.getElementById('pe_nr_verify').checked = px.node_reduce.verify !== false;
      if (px.node_reduce.max_nodes) document.getElementById('pe_nr_nodes').value = px.node_reduce.max_nodes;
      // 0 is a real tolerance, so these are read for presence, not truth.
      var nt = px.node_reduce.tolerance;
      if (nt !== undefined && nt !== null) document.getElementById('pe_nr_tolerance').value = nt;
      var nc = px.node_reduce.tolerance_cap;
      if (nc !== undefined && nc !== null) document.getElementById('pe_nr_tolerance_cap').value = nc;
    }
    var sw = pr.sweep || {};
    if (sw.presets) {
      ['bw', 'poster', 'photo'].forEach(function (p) {
        document.getElementById('sweep_' + p).checked = sw.presets.indexOf(p) !== -1;
      });
    }
    if (sw.max_candidates) document.getElementById('sweep_max').value = sw.max_candidates;
    if (sw.filter_speckle) document.getElementById('sweep_speckle').value = sw.filter_speckle.join(', ');
    if (sw.hierarchical) {
      ['cutout', 'stacked'].forEach(function (h) {
        document.getElementById('hier_' + h).checked = sw.hierarchical.indexOf(h) !== -1;
      });
    }
  }

  function missingForRun() {
    // A sequence replaces the single action entirely, so it is checked FIRST and
    // its own reason is the one reported.
    if (seqOn()) {
      if (!stepRows().length) return 'A sequence needs at least one step \u2014 add one, or untick it.';
      var all = readSteps();
      if (!all.ok) return all.error.charAt(0).toUpperCase() + all.error.slice(1) + '.';
      return null;
    }
    if (currentKind() === 'flux') {
      return fieldValue('flux_prompt')
        ? null
        : 'A FLUX job generates from a prompt — describe the image first.';
    }
    if (currentKind() === 'plot') {
      var doc = plotDocParsed();
      if (!doc.ok) {
        return doc.empty
          ? 'A plot job draws a document — paste the operation\'s spec first.'
          : 'That document is not valid JSON: ' + doc.error;
      }
      if (plotOp() === 'query') {
        var runs = plotRunsParsed();
        if (!runs.ok) {
          return runs.empty
            ? 'A plot query draws across runs — paste the .run.json records as an array.'
            : 'Those run records are not valid JSON: ' + runs.error;
        }
      }
      return null;
    }
    if (currentKind() === 'blender') {
      var bdoc = blenderDocParsed();
      if (!bdoc.ok) {
        return bdoc.empty
          ? 'A blender job renders a document — paste the geometry document first.'
          : 'That document is not valid JSON: ' + bdoc.error;
      }
      return null;
    }
    if (currentKind() === 'bp') {
      var doc = bpDocParsed();
      if (!doc.ok) {
        return doc.empty
          ? 'A BP job draws or renders a document — paste the operation\'s spec first.'
          : 'That document is not valid JSON: ' + doc.error;
      }
      if (bpTakesRuns()) {
        var runs = bpRunsParsed();
        if (!runs.ok) {
          return runs.empty
            ? 'A BP query draws across runs — paste the .run.json records as an array.'
            : 'Those run records are not valid JSON: ' + runs.error;
        }
      }
      // blender reads GEOMETRY, so a document with no elements list is one the
      // service would refuse as an invalid spec. Refused here instead, where the
      // operator can still fix it -- the same rule the old blender panel had.
      if (bpOp() === 'blender' && !Array.isArray((doc.value || {}).elements)) {
        return 'A blender render needs a document with an elements list.';
      }
      return null;
    }
    return pathField.value ? null : 'Upload an artwork file first.';
  }

  // ===================== the reference SET =====================
  //
  // One ARRAY of names rather than a `refName` string plus a side map, because
  // ORDER is part of the request: the first name is the singular `image` key and
  // the rest ride as `references`, so "the pose from the first, the palette from
  // the second" is a claim the form has to be able to keep. A structure that
  // tracked the extra names separately from the first one would let the two
  // disagree about which is which.
  //
  // The single-reference path is preserved exactly: with one name the block
  // writes `image` alone and nothing else, so the request is the byte-for-byte
  // one it always was.
  var refFile = document.getElementById('fluxRefFile');
  var refTile = document.getElementById('fluxRefTile');
  var refThumb = document.getElementById('fluxRefThumb');
  var refImg = document.getElementById('fluxRefImg');
  var refMeta = document.getElementById('fluxRefMeta');
  var refRemove = document.getElementById('fluxRefRemove');
  var refHint = document.getElementById('fluxRefHint');
  var refAddRow = document.getElementById('fluxRefAddRow');
  var refAdd = document.getElementById('fluxRefAdd');
  var refSlots = document.getElementById('fluxRefSlots');
  var refNames = [];
  // Slot counter for the generated tiles' ids and labels. Monotonic on purpose:
  // reusing a number after a removal would make two live slots share an id, and
  // the label is what tells the operator which image is the first.
  var refSlotSeq = 0;
  var REF_HINT = refHint.textContent;
  var REF_DANGER = 'var(--danger)';

  // Whether the SELECTED model conditions on a list. Read off the option, like
  // negpromptModel() and img2imgModel(), so the gate follows the model for the
  // same reason those two do and cannot drift from the mirror.
  function multirefModel() {
    var sel = document.getElementById('flux_model');
    var opt = sel && sel.options[sel.selectedIndex];
    return !!(opt && opt.getAttribute('data-multiref'));
  }

  // `refName` was the first reference everywhere below; it is now that list's
  // head, kept as a function rather than a variable so there is ONE definition
  // of "the reference" and no assignment site that can drift from it.
  function refName() { return refNames.length ? refNames[0] : ''; }

  // --- the generated slots ------------------------------------------------
  //
  // A tile per extra reference, each with its own file input, thumbnail and
  // remove button. The first slot is the ORIGINAL static markup and is never
  // re-rendered: re-rendering it would drop the file the operator already chose,
  // and a form that forgets an upload on an unrelated change is worse than one
  // that is slightly less uniform.
  function extraSlotEl() {
    var wrap = document.createElement('div');
    wrap.className = 'upload-thumb';
    wrap.style.display = 'flex';
    var img = document.createElement('img');
    img.alt = 'Reference image preview';
    var meta = document.createElement('div');
    meta.className = 'upload-thumb-meta mono';
    var x = document.createElement('button');
    x.type = 'button';
    x.className = 'upload-thumb-x';
    x.textContent = '×';
    x.title = 'Remove';
    wrap.appendChild(img);
    wrap.appendChild(meta);
    wrap.appendChild(x);
    return { wrap: wrap, img: img, meta: meta, x: x };
  }

  function renderRefSlots() {
    // Rebuild only the generated slots; the head is the static tile/thumb pair.
    Array.prototype.slice.call(refSlots.querySelectorAll('[data-generated]'))
      .forEach(function (el) { el.remove(); });
    refNames.slice(1).forEach(function (name, i) {
      var slot = extraSlotEl();
      slot.wrap.setAttribute('data-generated', '1');
      slot.wrap.setAttribute('data-slot', String(i + 2));
      slot.img.src = '/jobs/upload_preview/' + encodeURIComponent(name);
      slot.meta.textContent = 'Reference ' + (i + 2);
      slot.x.addEventListener('click', function () {
        // Index into the NAMES array, not the rendered index: the head is not
        // rendered by this loop, so `i + 1` is the name's position.
        refNames.splice(i + 1, 1);
        renderRefSlots();
        writePanels();
      });
      refSlots.appendChild(slot.wrap);
    });
    // The head thumb/thumb-tile swap, exactly as the single-reference path did.
    var head = refName();
    if (head) {
      refImg.src = '/jobs/upload_preview/' + encodeURIComponent(head);
      refThumb.style.display = 'flex';
      refTile.style.display = 'none';
    } else {
      refThumb.style.display = 'none';
      refTile.style.display = '';
    }
    refAddRow.hidden = !multirefModel() || refNames.length === 0;
  }

  refAdd.addEventListener('click', function () {
    // A hidden file input per slot, built on demand: the operator picks a
    // different file per slot, and one shared input cannot express that.
    var picker = document.createElement('input');
    picker.type = 'file';
    picker.accept = 'image/png,image/jpeg';
    picker.style.display = 'none';
    picker.addEventListener('change', function () {
      var file = picker.files[0];
      if (!file) return;
      if (file.size > 50 * 1024 * 1024) {
        refHint.textContent = 'Too big — ' + humanSize(file.size) + ' exceeds the 50MB limit.';
        refHint.style.color = REF_DANGER;
        picker.remove();
        return;
      }
      refHint.style.color = '';
      refHint.textContent = 'Uploading ' + file.name + '…';
      var fd = new FormData();
      fd.append('file', file);
      var csrf = document.querySelector('meta[name="csrf-token"]').content;
      fetch('<%= upload_jobs_path %>', { method: 'POST', headers: { 'X-CSRF-Token': csrf }, body: fd })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.j.path) {
            refHint.textContent = res.j.alert || 'Upload failed — try again.';
            refHint.style.color = REF_DANGER;
            return;
          }
          refNames.push(res.j.path.split('/').pop());
          renderRefSlots();
          refHint.textContent = refNames.length + ' references — all of them condition this run.';
          writePanels();
        })
        .catch(function () {
          refHint.textContent = 'Upload failed — network error.';
          refHint.style.color = REF_DANGER;
        })
        .then(function () { picker.remove(); });
    });
    document.body.appendChild(picker);
    picker.click();
  });

  // Switching to a model that does not take a list must NOT leave a second
  // reference in the spec: the service would refuse it, and the operator would
  // be right to wonder why. The names are cleared and the reason is stated,
  // because silently emptying three slots the operator filled is its own kind
  // of data loss.
  function enforceRefGate() {
    if (multirefModel() || refNames.length < 2) { renderRefSlots(); return; }
    var dropped = refNames.length - 1;
    refNames = refNames.slice(0, 1);
    refHint.style.color = REF_DANGER;
    refHint.textContent = dropped + ' reference' + (dropped === 1 ? '' : 's') +
      ' dropped — this model takes a single reference image. ' +
      (refNames.length ? 'The first one is kept.' : 'The run is a plain generation now.');
    renderRefSlots();
  }

  refTile.addEventListener('click', function () { refFile.click(); });

  refFile.addEventListener('change', function () {
    var file = refFile.files[0];
    if (!file) return;
    if (file.size > 50 * 1024 * 1024) {
      refHint.textContent = 'Too big — ' + humanSize(file.size) + ' exceeds the 50MB limit.';
      refHint.style.color = REF_DANGER;
      refFile.value = '';
      return;
    }
    refHint.style.color = '';
    refHint.textContent = 'Uploading ' + file.name + '…';
    var fd = new FormData();
    fd.append('file', file);
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('<%= upload_jobs_path %>', { method: 'POST', headers: { 'X-CSRF-Token': csrf }, body: fd })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || !res.j.path) {
          refHint.textContent = res.j.alert || 'Upload failed — try again.';
          refHint.style.color = REF_DANGER;
          return;
        }
        // The BASENAME, not the path: the controller resolves a reference by
        // looking its name up inside storage/uploads, and never follows a
        // directory out of the spec.
        //
        // Assigned to slot 0, not appended: this is the FIRST tile, the one that
        // rides as the singular `image` key, and a head that moved would silently
        // reorder the conditioning set. Extra references are added by the "add
        // another" control above, which appends.
        refNames[0] = res.j.path.split('/').pop();
        refMeta.textContent = file.name + ' · ' + humanSize(res.j.size);
        renderRefSlots();
        // The first tile's own preview, from the upload's response: the render
        // pass would fetch the same bytes back through upload_preview, and the
        // response already has the URL.
        refImg.src = res.j.preview_url;
        refHint.textContent = refNames.length > 1
          ? refNames.length + ' references — all of them condition this run.'
          : 'Reference set — this run is an edit rather than a generation.';
        writePanels();
      })
      .catch(function () {
        refHint.textContent = 'Upload failed — network error.';
        refHint.style.color = REF_DANGER;
      });
  });

  refRemove.addEventListener('click', function () {
    // Removes the FIRST reference and closes the gap, so what remains is a
    // contiguous set again: leaving a hole would mean the second name riding as
    // `image`, which is a different render than the operator asked for.
    refNames.shift();
    refFile.value = '';
    refHint.textContent = REF_HINT;
    refHint.style.color = '';
    renderRefSlots();
    writePanels();
  });

  // Drag a scrapbook thumbnail onto the reference tile (or its thumb) to use it
  // as the edit input. The drag is started by the one delegated handler in
  // aether.js, which puts the item JSON under application/x-scrapbook+json; the
  // server copies the scrapbook bytes into uploads (raster only) and returns
  // the same JSON the file-upload above consumes. A bare text/plain drop from
  // anywhere else is ignored: only the typed payload counts.
  function refDrop(e) {
    var raw = e.dataTransfer ? e.dataTransfer.getData('application/x-scrapbook+json') : '';
    if (!raw) return;
    var item = null;
    try { item = JSON.parse(raw); } catch (err) { item = null; }
    if (!item || !item.id) return;

    refHint.textContent = 'Setting reference from ' + (item.name || 'the scrapbook') + '…';
    refHint.style.color = '';
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/scrapbook/' + encodeURIComponent(item.id) + '/reference', {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' },
      credentials: 'same-origin'
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || !res.j.path) {
          refHint.textContent = res.j.error || 'Could not use that item as a reference.';
          refHint.style.color = REF_DANGER;
          return;
        }
        refName = res.j.path.split('/').pop();
        refImg.src = res.j.preview_url;
        refMeta.textContent = res.j.name + ' · ' + humanSize(res.j.size);
        refThumb.style.display = 'flex';
        refTile.style.display = 'none';
        refHint.textContent = 'Reference set — this run is an edit rather than a generation.';
        writePanels();
      })
      .catch(function () {
        refHint.textContent = 'Could not use that item as a reference — network error.';
        refHint.style.color = REF_DANGER;
      });
  }
  [refTile, refThumb].forEach(function (target) {
    target.addEventListener('dragover', function (e) {
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
      // The tile owns this drag: stop it reaching the page-level handler below,
      // which would otherwise ALSO set the same item as the job's artwork. A
      // drop on this tile means "use as the edit reference", not both.
      e.stopPropagation();
    });
    target.addEventListener('drop', function (e) {
      e.preventDefault();
      e.stopPropagation();
      refDrop(e);
    });
  });

  // ===================== drop a scrapbook item anywhere =====================
  // A scrapbook thumbnail dragged from the drawer and dropped ANYWHERE on this
  // page becomes the job's artwork -- the same result as picking a file, so the
  // gesture does not depend on hitting a 200px tile.
  //
  // On this page a dragged SOURCE has exactly one destination, which is why a
  // page-level handler is safe: the only other drop meaning is the flux
  // reference, and that tile stops the event before it reaches here.
  //
  // Bound to document.body, not document: Turbo replaces the body on navigation,
  // so these bindings are fresh per page and never hold a detached node.
  var SOURCE_MIME = 'application/x-scrapbook+json';

  function carriesSource(e) {
    return !!(e.dataTransfer && e.dataTransfer.types &&
              Array.prototype.indexOf.call(e.dataTransfer.types, SOURCE_MIME) !== -1);
  }

  document.body.addEventListener('dragover', function (e) {
    if (!carriesSource(e)) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'copy';
  });

  document.body.addEventListener('drop', function (e) {
    if (!carriesSource(e)) return;
    e.preventDefault();
    var raw = e.dataTransfer.getData(SOURCE_MIME);
    var item = null;
    try { item = JSON.parse(raw); } catch (err) { item = null; }
    if (!item || !item.id) return;

    hint.textContent = 'Loading ' + (item.name || 'the scrapbook item') + ' as this job\'s source…';
    hint.style.color = '';
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    fetch('/scrapbook/' + encodeURIComponent(item.id) + '/artwork', {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' },
      credentials: 'same-origin'
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || !res.j.path) {
          hint.textContent = res.j.error || 'Could not use that item as the source.';
          hint.style.color = 'var(--danger)';
          return;
        }
        applySource(res.j, res.j.name || item.name || 'source');
        // An SVG source traces as a vector, so the kind the pipeline reads has
        // to follow the file, not whatever was selected before the drop.
        var kindField = document.getElementById('job_source_kind');
        if (kindField && res.j.source_kind) kindField.value = res.j.source_kind;
        hint.textContent = 'Source set from the scrapbook — review the contract, then Run Job.';
        writePanels();
      })
      .catch(function () {
        hint.textContent = 'Could not use that item as the source — network error.';
        hint.style.color = 'var(--danger)';
      });
  });

  // ===================== wiring =====================
  // Two fields follow the model, and both are OFF by default because the
  // default klein has neither. A negative prompt appears only for a model whose
  // registry says it has one (the SD-family: sdxl-1.0, sdxl-turbo, sd-1.5), and
  // a strength only for a model whose pipeline takes one (the same three).
  // Neither value is composed for a model that cannot use it, so switching away
  // from an SD-family model cannot leak a stale one into the spec.
  function negpromptModel() {
    var sel = document.getElementById('flux_model');
    var opt = sel && sel.options[sel.selectedIndex];
    return !!(opt && opt.getAttribute('data-negprompt'));
  }
  function img2imgModel() {
    var sel = document.getElementById('flux_model');
    var opt = sel && sel.options[sel.selectedIndex];
    return !!(opt && opt.getAttribute('data-img2img'));
  }
  function updateModelGates() {
    var neg = document.getElementById('fluxNegPromptField');
    if (neg) neg.hidden = !negpromptModel();
    var str = document.getElementById('fluxStrengthField');
    if (str) str.hidden = !img2imgModel();
    // The reference SET follows the model too, for the same reason: a second
    // slot on a checkpoint that takes one is a request the service refuses.
    // Declared after the two above because `enforceRefGate` reads
    // `multirefModel`, and it is a function on the same registry read.
    enforceRefGate();
    // ...and the two registry lists, which follow the model for the same reason:
    // an adapter that cannot load against the chosen model is not offered at all.
    syncRegistry();
  }

  ['flux_prompt', 'flux_width', 'flux_height', 'flux_seed',
   'flux_strength'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', writePanels);
  });
  ['flux_mode', 'flux_model', 'flux_steps', 'flux_guidance', 'flux_images',
   'flux_negative_prompt', 'flux_strength'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', writePanels);
  });
  // The four controls that are NOT flux settings fields of the model's: the two
  // registry lists, the scale box, and the proof-side opt-in -- plus the subset
  // box beside it, because it composes the object form of the same key.
  ['flux_modifiers', 'flux_modifier_scales', 'flux_vae', 'proof_variants',
   'proof_variant_transforms'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', writePanels);
    el.addEventListener('change', writePanels);
  });
  var fluxModelSel = document.getElementById('flux_model');
  if (fluxModelSel) fluxModelSel.addEventListener('change', updateModelGates);
  // Every control in the settings popup changes the spec, so the preview in it
  // and the contract on the page are never a step behind what is on screen.
  ['pe_opaque_bg', 'pe_prep_colors', 'pe_filters', 'pe_filters_presets',
   'pe_filters_sheet', 'pe_filters_alpha', 'pe_filters_spec', 'pe_tune',
   'pe_tune_presets', 'pe_tune_cells', 'pe_tune_sheet', 'pe_tune_speckle',
   'pe_tune_hier', 'pe_tune_nr', 'pe_nr', 'pe_nr_nodes', 'pe_nr_tolerance',
   'pe_nr_tolerance_cap', 'pe_nr_verify',
   'sweep_bw', 'sweep_poster', 'sweep_photo', 'sweep_max', 'sweep_speckle',
   'hier_cutout', 'hier_stacked'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', writePanels);
    el.addEventListener('change', writePanels);
  });

  runnerSel.addEventListener('change', function () {
    showKind();
    writePanels();
  });

  // ===================== the plot panel's own gates =====================
  // The run-records box exists only for a query, because only a query draws
  // across runs: the other two operations carry one document each.
  var plotRunsField = document.getElementById('plotRunsField');

  function updatePlotGates() {
    if (plotRunsField) plotRunsField.hidden = plotOp() !== 'query';
  }

  var plotOpSel = document.getElementById('plot_op');
  if (plotOpSel) plotOpSel.addEventListener('change', function () {
    updatePlotGates();
    writePanels();
  });
  ['plot_doc', 'plot_runs'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', writePanels);
  });

  // ===================== the blender panel's own wiring =====================
  // No gates of its own: the document is the whole request, so there is nothing
  // to show or hide as it changes -- only the spec to recompose.
  ['blender_doc'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', writePanels);
  });

  // ===================== the bp panel's own gates =====================
  // The run-records box exists for a query alone, because only a query draws
  // across runs -- the same gate the plot panel had, over six operations rather
  // than three.
  var bpRunsField = document.getElementById('bpRunsField');

  function bpIsBlender() { return bpOp() === 'blender'; }

  function updateBpGates() {
    if (bpRunsField) bpRunsField.hidden = !bpTakesRuns();
    // The render controls edit a block only `blender` has. Hidden, they edit
    // nothing — and a control that edits nothing while looking like it does is
    // the whole reason this group is gated on the operation.
    var render = document.getElementById('bpRenderFields');
    if (render) render.hidden = !bpIsBlender();
  }

  var bpOpSel = document.getElementById('bp_op');
  if (bpOpSel) bpOpSel.addEventListener('change', function () {
    updateBpGates();
    writePanels();
  });
  ['bp_doc', 'bp_runs'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', writePanels);
  });
  // `change`, not `input`: re-serializing the textarea on every keystroke of a
  // number field fights the operator mid-number, and the contract only has to
  // be fresh by the time anything reads it.
  // (The name is BP_RENDER_FIELDS — the map, not a list. A stale reference here
  // is a ReferenceError in this IIFE, and everything AFTER it — the hydrate
  // calls at the bottom — never runs: the form looks right and nothing is wired.
  // The browser probe is what caught it; no syntax check on this box would.)
  Object.keys(BP_RENDER_FIELDS).forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', applyBpRenderControls);
  });

  // ===================== the sequence's own wiring =====================
  // Delegated on the LIST, not bound per row: rows are created and destroyed by
  // these very controls, so a per-row listener would be re-bound on every add and
  // leak on every remove.
  if (seqOnBox) seqOnBox.addEventListener('change', function () {
    seqBody.hidden = !seqOn();
    // A first tick with nothing in it gets one row, so the control never shows an
    // empty list as if it were ready to run.
    if (seqOn() && !stepRows().length) addStep();
    writePanels();
  });

  var addStepBtn = document.getElementById('addStepBtn');
  if (addStepBtn) addStepBtn.addEventListener('click', function () {
    addStep();
    writePanels();
  });

  if (stepsList) {
    stepsList.addEventListener('click', function (e) {
      var row = e.target.closest ? e.target.closest('[data-step]') : null;
      if (!row) return;
      if (e.target.matches('[data-step-up]')) moveStep(row, -1);
      else if (e.target.matches('[data-step-down]')) moveStep(row, 1);
      else if (e.target.matches('[data-step-del]')) row.remove();
      else return;
      restampSteps();
      writePanels();
    });
    stepsList.addEventListener('input', writePanels);
    stepsList.addEventListener('change', writePanels);
  }

  showKind();
  hydratePanels();
  hydratePlot();
  hydrateBlender();
  hydrateBp();
  updateBpGates();
  updateModelGates();
  updatePlotGates();
  if (currentKind() === 'flux') writePanels();
  renderFluxSummary();
  renderPlotSummary();
  renderBlenderSummary();
  renderBpSummary();
  hydrateSeq();
  renderSeqSummary();
})();
</script>
