<%# Favourite (add-to-scrapbook) button. Locals: job_id, name, label, css_class.
    The star is an inline SVG like the other row-action icons — text glyphs fall
    back inconsistently across the pixel/Inter font stack, which is exactly why
    the download/findings buttons use SVGs. %>
<button type="button" class="<%= local_assigns[:css_class].presence || "btn btn-icon fav-btn" %>"
        data-scrap-favourite data-scrap-job="<%= job_id %>" data-scrap-name="<%= name %>"
        title="Favourite <%= local_assigns[:label].presence || name %>"
        aria-label="Favourite <%= local_assigns[:label].presence || name %>">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
</button>
